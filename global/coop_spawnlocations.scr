//this function updates the spawnlocations of
//players inside the moving subway train
subway_subwayTrain2_travel:
	level.subway_subwayTrain2_travel = 1
	
	subway_subwayTrain2_travel_loop:
	//the train has halted, stop updating this
	level.subway_subwayTrain2_travel ifequal 0 end
	
	//spawnangle
	level.coopPlayer1SpawnAngles string "0 180 0"
	level.coopPlayer2SpawnAngles string "0 180 0"
	level.coopPlayer3SpawnAngles string "0 180 0"
	level.coopPlayer4SpawnAngles string "0 180 0"
	
	//spawnspots - (Remember -66 z when viewpos was used)
	local.tramOrigin getorigin $fuckingcar
	level.coopPlayer1SpawnLocation vector local.tramOrigin
	level.coopPlayer1SpawnLocation vector_add "-200 0 -44"
	level.coopPlayer2SpawnLocation vector local.tramOrigin
	level.coopPlayer2SpawnLocation vector_add "-100 0 -44"
	level.coopPlayer3SpawnLocation vector local.tramOrigin
	level.coopPlayer3SpawnLocation vector_add "100 0 -44"
	level.coopPlayer4SpawnLocation vector local.tramOrigin
	level.coopPlayer4SpawnLocation vector_add "200 0 -44"
	wait game.FRAMETIME
	
	goto subway_subwayTrain2_travel_loop
end

subway_subwayTrain2_fight:
	//stop updating the spawnlocations optimized for moving train
	level.subway_subwayTrain2_travel = 0

	//spawnangle
	level.coopPlayer1SpawnAngles string "0 153 0"
	level.coopPlayer2SpawnAngles string "0 192 0"
	level.coopPlayer3SpawnAngles string "0 341 0"
	level.coopPlayer4SpawnAngles string "0 7 0"
	
	//spawnspots - (Remember -66 z when viewpos was used)
	level.coopPlayer1SpawnLocation string "495 -1551 20"
	level.coopPlayer2SpawnLocation string "519 -1424 20"
	level.coopPlayer3SpawnLocation string "-87 -1424 20"
	level.coopPlayer4SpawnLocation string "-87 -1551 20"
end

