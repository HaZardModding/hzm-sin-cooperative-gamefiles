playerEquip:
	local.player string parm.player
	//give inventory listed in coop_inventory.scr for this level
	local.equipThread string "global/coop_inventory.scr::"
	local.equipThread append level.coopPlayerInventoryThread
	thread local.equipThread

	//just make very sure this works regardless of any mess in inventory file
	//give this always, this will be used to detect if player went into spectator
	local.player give level.coopSpectatorCheckModel 1
	local.player dropweapon level.coopEnablePlayerDrop
end

playerMoveToSpawn:
	// Check if player exists
	local.player string parm.player
	parm.objectExist string local.player
	thread objectExist
	parm.objectExistTrue ifequal 0 end
	
	level.coopDisableSpawnWarper ifequal 1 goto playerMoveToSpawn_predefined
	
	//move to last known pos
	playerMoveToSpawn_restore:
	thread getCoordForPlayer
	local.spawnLocation vector parm.getCoordForPlayer
	local.vecLngt vector_length local.spawnLocation
	local.vecLngt ifgreater 20 goto playerMoveToSpawn_origin
	
	//use predefined spawnpoints - can be updated
	playerMoveToSpawn_predefined:	
	local.player ifstrequal "$player1" local.spawnLocation string level.coopPlayer1SpawnLocation
	local.player ifstrequal "$player2" local.spawnLocation string level.coopPlayer2SpawnLocation
	local.player ifstrequal "$player3" local.spawnLocation string level.coopPlayer3SpawnLocation
	local.player ifstrequal "$player4" local.spawnLocation string level.coopPlayer4SpawnLocation	
	
	local.player ifstrequal "$player1" local.spawnAngles string level.coopPlayer1SpawnAngles
	local.player ifstrequal "$player2" local.spawnAngles string level.coopPlayer2SpawnAngles
	local.player ifstrequal "$player3" local.spawnAngles string level.coopPlayer3SpawnAngles
	local.player ifstrequal "$player4" local.spawnAngles string level.coopPlayer4SpawnAngles
	
	playerMoveToSpawn_origin:
	local.player origin local.spawnLocation
	local.player clearsavedangles
	local.player deltaangles local.spawnAngles
	
	//make sure players don't get stuck in each other
	parm.playerMakeSolidAsap string local.player
	thread playerMakeSolidAsap
	
	//this prevents sliding caused by the pushtrigger spawned at info_player_start
	local.player freeze
	wait game.FRAMETIME
	local.player unfreeze
end

// Generated by ChatGTP
playerMoveAllToSpawn:
    local.index = 0

	playerMoveAllToSpawn_loop:
    local.index += 1
    local.index ifgreaterequal 5 end

    parm.player string "$player"
    parm.player appendint local.index
    thread playerMoveToSpawn

    goto playerMoveAllToSpawn_loop
end

playerTargetnames:
//INTERNAL coop_main.scr USE ONLY!
	//make sure the mod is started
	thread main
	
	//rename players
	*1 targetname "player1"
	*2 targetname "player2"
	*3 targetname "player3"
	*4 targetname "player4"
	
	//handle players
	level.coopPlayer1Managing iflessequal 0 thread managePlayer1_start
	level.coopPlayer2Managing iflessequal 0 thread managePlayer2_start
	level.coopPlayer3Managing iflessequal 0 thread managePlayer3_start
	level.coopPlayer4Managing iflessequal 0 thread managePlayer4_start
	
	//spawn trigger to detect new players
	level.coopSpawnedTrigger ifequal 1 end
	level.coopSpawnedTrigger = 1
	
	//MISC NOTES
	//cmd, stuffcmd, menu_main
	//Player bbox: "-16 -16 0" "16 16 72" chrouched: "-16 -16 0" "16 16 36"
	
	//SPAWNFLAGS NOTES
	//trigger_pushany - 4 NOT_PLAYERS, 8 NOT_MONSTERS, 16 NOT_PROJECTILES,  32 STARTOFF (game2015)
	//trigger_push - 4 NOT_PLAYERS, 4 NOT_PLAYERS, 8 NOT_MONSTERS, 16 NOT_PROJECTILES, 32 STARTOFF (game2015)
	//trigger_once - 1 NOTOUCH, 8 MONSTERS, 16 PROJECTILES, 
	//trigger_multiple - 4 NOT_PLAYERS, 8 MONSTERS, 16 PROJECTILES, 
	
	//spawn player detect trigger
	//some spawnlocations are above the ground, we use this to minimize the point of contact
	local.triggerPos33 vector level.infoPlayerStartOrigin1
	local.triggerPos33 vector_add "0 0 71"
	
	spawn trigger_multiple origin level.infoPlayerStartOrigin1 targetname "coopInfoPlayerStartTrigger1" thread "coopInfoPlayerStartActivated"
	$coopInfoPlayerStartTrigger1 setsize "0 0 0" "1 1 1" //was "1 1 20"
	$coopInfoPlayerStartTrigger1 origin local.triggerPos33
	
	//this trigger pushes player away from the trigger - we don't want to constantly re-targetname
	//push players away, that works better than moving them away to spawn
	spawn trigger_push origin level.infoPlayerStartOrigin1 speed "500" spawnflags "24" targetname "coopInfoPlayerStartPush1" angle level.infoPlayerStartPushDirection1
	$coopInfoPlayerStartPush1 setsize "-10 -10 -0" "10 10 10" //was "10 10 76"
	$coopInfoPlayerStartPush1 origin local.triggerPos33
	
	//for alternative spawn spot if it exists
	level.infoPlayerStartOrigin2 ifstrequal "" end
	spawn trigger_multiple origin level.infoPlayerStartOrigin2 targetname "coopInfoPlayerStartTrigger2" thread "coopInfoPlayerStartActivated"
	$coopInfoPlayerStartTrigger2 setsize "0 0 0" "1 1 1" //was "1 1 20"
	spawn trigger_push origin level.infoPlayerStartOrigin2 speed "500" spawnflags "24" targetname "coopInfoPlayerStartPush2" angle level.infoPlayerStartPushDirection2
	$coopInfoPlayerStartPush2 setsize "-10 -10 0" "10 10 10" //was "10 10 76"
end

//make player use object or trigger
playerActivate:
	parm.object doUse parm.player
end

//make player activate trigger
playerTrigger:
	triggerfroment parm.player parm.trigger 
end

//untested
//untested
//untested
playerWeaponForce:
	parm.player use parm.playerWeaponForce
	parm.player weaponuse
end

//moves players to their spawn spots
//parm.playerMoveOrigin - Specify the location to measure from, i.e: "( 0 120 99 )"
//parm.playerMoveExclude - Exclude a single player, i.e: $player1
//parm.playerMoveMaxDistance - default is: 100 - move when this distance away from the location (to far away)
//parm.playerMoveWithin -  0/1 default 0 - move when this distance within from the location (to close)
//parm.playerMoveIgnoreZAxis - 0/1 default is 0 - ignore Z-Axis and only check 2d distance
playerMove:
	local.index = 0
	parm.playerMoveMaxDistance ifstrequal "" parm.playerMoveMaxDistance = 100
	parm.playerMoveMaxDistance iflessequal 0 parm.playerMoveMaxDistance = 100
	
	playerMove_loop:
	local.index += 1
	local.index ifgreaterequal 5 goto playerMove_end
	
	local.player string "$player"
	local.player appendint local.index
	
	local.playerAlive isentalive local.player
	local.playerAlive ifequal 0 goto playerMove_loop
	
	//exclude check - exclude a player, regardless of distance
	parm.playerMoveExclude ifstrequal local.player goto playerMove_loop
	
	//distance check
	playerMove_distanceCheck:
	//verify origin
	parm.playerMoveOriginEntity ifstrequal "" parm.playerMoveOriginEntity vector level.coopPlayer1SpawnLocation
	
	local.playerOrigin getorigin local.player
	local.checkOrigin vector parm.playerMoveOriginEntity
	local.calcVecLength vector local.playerOrigin
	local.calcVecLength vector_subtract local.checkOrigin
	parm.playerMoveIgnoreZAxis ifequal 1 local.calcVecLength vector_setz 0
	local.vecLength vector_length local.calcVecLength
	
	parm.playerMoveWithin ifequal 1 goto playerMove_within
	
	local.vecLength ifgreaterequal parm.playerMoveMaxDistance goto playerMove_doMove
	goto playerMove_loop
	
	playerMove_within:
	local.vecLength ifgreaterequal parm.playerMoveMaxDistance goto playerMove_loop
	
	playerMove_doMove:
	//don't move if allready there
	local.vecLength iflessequal 2 goto playerMove_loop	
	parm.player string local.player
	thread playerMoveToSpawn
	goto playerMove_loop
	
	playerMove_end:
end

//lower weapons of players
playerLowerAll:
	$player1 forcelowerweapon
	$player2 forcelowerweapon
	$player3 forcelowerweapon
	$player4 forcelowerweapon
end

//raise weapons of players
playerRaiseAll:
	$player1 forceraiseweapon
	$player2 forceraiseweapon
	$player3 forceraiseweapon
	$player4 forceraiseweapon
end

//change player to the fists
playerFistsAll:
	$player1 use fists
	$player1 forcelowerweapon
	$player1 forceraiseweapon
	$player2 use fists
	$player2 forcelowerweapon
	$player2 forceraiseweapon
	$player3 use fists
	$player3 forcelowerweapon
	$player3 forceraiseweapon
	$player4 use fists
	$player4 forcelowerweapon
	$player4 forceraiseweapon
end

//teleport given player
playerTeleport:
	parm.player teleport parm.vectorX parm.vectorY parm.vectorZ 3.7 5.5 0.0
end

//also works with actors
//ISSUES: Will not detect dead entities at "0 0 0"
//returns: parm.playerExistTrue
playerExist:
	parm.playerExistTrue = 0
	local.playerOrigin getorigin parm.playerExist
	local.vecLength vector_length local.playerOrigin
	local.vecLength ifgreaterequal 1 goto playerExist_true
	local.playerAlive isentalive parm.playerExist
	local.playerAlive ifgreaterequal 1 goto playerExist_true
	parm.playerExistTrue = 0
	end
	
	playerExist_true:
	parm.playerExistTrue = 1
end

//meant to be used with entities
//if entity is exactly on "0 0 0" it won't work
//Result: parm.objectExistTrue
objectExist:
    parm.objectExistTrue = 0

    local.objectOrigin getorigin parm.objectExist
    local.vecLength vector_length local.objectOrigin
    local.vecLength ifgreaterequal 1 goto objectExist_exist

    local.objectOrigin getorigin parm.objectExist
    local.vecLength vector_length local.objectOrigin
    local.vecLength ifequal 0 end

	objectExist_exist:
    parm.objectExistTrue = 1
end

isPlayerObject:
	parm.isPlayerObjectTrue = 0
    local.index = 0
	
	isPlayerObject_loop:
    local.index += 1
    local.index ifgreaterequal 5 end
    local.player string "$player"
    local.player append local.index
	parm.isPlayerObject ifstrequal local.player goto isPlayerObject_true
    goto isPlayerObject_loop
	
	isPlayerObject_true:
	parm.isPlayerObjectTrue = 1
end

isPlayerValid:
	parm.isPlayerValidTrue = 0
	local.player string parm.isPlayerValid
	
	parm.isPlayerObject string local.player
	thread isPlayerObject
	parm.isPlayerObjectTrue iflessequal 0 end
	
	parm.playerExist string local.player
	thread playerExist
	parm.playerExistTrue iflessequal 0 end
	
	local.playerAlive isentalive local.player
	local.playerAlive ifequal 0 end
	
	parm.isPlayerValidTrue = 1
end

//iterate trough players to find closest
//object=entity OR origin=vector
//Input: parm.playerClosestObject OR parm.playerClosestOrigin
//Output: parm.playerClosest, parm.playersClosestDistance
playerClosest:
	local.index = 0
	parm.playersClosestDistance = 99999
	parm.playerClosest string ""
	
	parm.playerClosestObject ifstrnotequal "parm.playerClosestObject" goto playerClosest_object
	
	//work with vector directly
	local.otherorigin vector parm.playerClosestOrigin	
	goto playerClosest_loop
	
	//object
	playerClosest_object:
	parm.objectExist string parm.playerClosestObject
	thread objectExist
	parm.objectExistTrue iflessequal 0 goto playerClosest_existNot
	local.otherorigin getorigin parm.playerClosestObject
	
	//loop form here
	playerClosest_loop:
	local.index += 1
	local.index ifgreaterequal 5 goto playerClosest_end
	
	local.player string "$player"
	local.player appendint local.index
	
	local.playerAlive isentalive local.player
	local.playerAlive ifequal 0 goto playerClosest_loop
	
	local.playerOrigin getorigin local.player
	local.calcVecLength vector local.playerOrigin
	local.calcVecLength vector_subtract local.otherorigin
	local.calcVecLength vector_setz 0
	local.vecLength vector_length local.calcVecLength
	
	local.vecLength ifgreaterequal parm.playersClosestDistance goto playerClosest_loop
	
	parm.playersClosestDistance = local.vecLength
	parm.playerClosest string local.player
	goto playerClosest_loop
	
	playerClosest_end:
	level.coopDebug iflessequal 0 end
	parm.print1 string "playerClosest: "
	parm.print2 string parm.playerClosest
	parm.print3 string " - "
	parm.print4 string parm.playersClosestDistance
	thread println
	end
	
	playerClosest_existNot:
	local.printOut string parm.playerClosestObject
	local.printOut append "does not exist, playerClosest ending prematurley\n"
	print local.printOut
end

//checks if any player is within given distance of entity
//Input: parm.playerWithinDistanceOfEntity, parm.playerWithinDistanceOfEntity_distance
//Result: parm.playerWithinDistanceOfEntityTrue
playerWithinDistanceOfEntity:
	parm.playerWithinDistanceOfEntityTrue = 0
	parm.playerClosestObject string parm.playerWithinDistanceOfEntity
	thread playerClosest
	parm.playerClosest ifstrequal "" end
	parm.playersClosestDistance iflessequal parm.playerWithinDistanceOfEntity_distance parm.playerWithinDistanceOfEntityTrue = 1
end

//allow or disallow dropping weapons when players die
playersDropWeapon:
    local.index = 0
	
	playersDropWeapon_loop:
    local.index += 1
    local.index ifgreaterequal 5 end
    local.player string "$player"
    local.player append local.index
	parm.playerExist string local.player
	thread playerExist
	parm.playerExistTrue ifequal 1 local.player dropweapon level.coopEnablePlayerDrop
    goto playerMoveAllToSpawn_loop
end

//iterate trough players to check if all use fists
//Return vars: parm.playersUseFistsOnly
playersWithFistsOnly:
	local.index = 0
	parm.playersUseFistsOnly = 1
	
	playersWithFistsOnly_loop:
	local.index += 1
	local.index ifgreaterequal 5 goto playersWithFistsOnly_true
	
	local.player string "$player"
	local.player appendint local.index	
	local.playerAlive isentalive local.player
	local.playerAlive ifequal 0 goto playersWithFistsOnly_loop
	
	parm.check getweapon local.player
	parm.check ifstrnotequal "Fists" goto playersWithFistsOnly_false
	goto playersWithFistsOnly_loop
	
	playersWithFistsOnly_false:
	parm.playersUseFistsOnly = 0
	goto playersWithFistsOnly_end
	
	playersWithFistsOnly_true:
	parm.playersUseFistsOnly = 1
	
	playersWithFistsOnly_end:	
end

println:
	local.printOut string ""
	parm.print1 ifstrnotequal "" local.printOut append parm.print1
	parm.print2 ifstrnotequal "" local.printOut append parm.print2
	parm.print3 ifstrnotequal "" local.printOut append parm.print3
	parm.print4 ifstrnotequal "" local.printOut append parm.print4
	parm.print5 ifstrnotequal "" local.printOut append parm.print5
	parm.print6 ifstrnotequal "" local.printOut append parm.print6
	parm.print7 ifstrnotequal "" local.printOut append parm.print7
	parm.print8 ifstrnotequal "" local.printOut append parm.print8
	local.printOut append "#\n"
	print local.printOut
end

playerMakeSolidAsapPlayerOther:
//INTERNAL coop_main.scr USE ONLY!
	local.function string "playerMakeSolidAsapPlayerOther_"
	local.function append parm.playerMakeSolidAsapPlayerOther
	goto local.function
	
	//make sure we always check if the thread is running, to never run into any timing issues
	playerMakeSolidAsapPlayerOther_$player1:
	level.coopPlayer1MakeSolidAsapRunning iflessequal 0 goto playerMakeSolidAsapPlayerOther_doRun
	end
	playerMakeSolidAsapPlayerOther_$player2:
	level.coopPlayer2MakeSolidAsapRunning iflessequal 0 goto playerMakeSolidAsapPlayerOther_doRun
	end
	playerMakeSolidAsapPlayerOther_$player3:
	level.coopPlayer3MakeSolidAsapRunning iflessequal 0 goto playerMakeSolidAsapPlayerOther_doRun
	end
	playerMakeSolidAsapPlayerOther_$player4:
	level.coopPlayer4MakeSolidAsapRunning iflessequal 0 goto playerMakeSolidAsapPlayerOther_doRun
	end
	
	playerMakeSolidAsapPlayerOther_doRun:
	parm.playerMakeSolidAsap string parm.playerMakeSolidAsapPlayerOther
	thread playerMakeSolidAsap
end

playerMakeSolidAsap:
    local.playerToHandle string parm.playerMakeSolidAsap
	local.index = 0
	local.inside = 0
	
	//make sure this is a player
	parm.isPlayerObject string local.playerToHandle
	thread isPlayerObject
	parm.isPlayerObjectTrue iflessequal 0 goto playerMakeSolidAsap_doesnotexist
	
	local.playerAlive isentalive local.playerToHandle
	local.playerAlive ifequal 0 goto playerMakeSolidAsap_isdead

	local.playerFunc string "playerMakeSolidAsap_"
	local.playerFunc append local.playerToHandle
	goto local.playerFunc
	//end if player is not valid
	end
	
	//these must NOT goto playerMakeSolidAsap_end - no no no!
	playerMakeSolidAsap_$player1:
	level.coopPlayer1MakeSolidAsapRunning ifgreaterequal 1 goto playerMakeSolidAsap_allreadyrunning
	level.coopPlayer1MakeSolidAsapRunning = 1
	goto playerMakeSolidAsap_doRun

	playerMakeSolidAsap_$player2:
	level.coopPlayer2MakeSolidAsapRunning ifgreaterequal 1 goto playerMakeSolidAsap_allreadyrunning
	level.coopPlayer2MakeSolidAsapRunning = 1
	goto playerMakeSolidAsap_doRun

	playerMakeSolidAsap_$player3:
	level.coopPlayer3MakeSolidAsapRunning ifgreaterequal 1 goto playerMakeSolidAsap_allreadyrunning
	level.coopPlayer3MakeSolidAsapRunning = 1
	goto playerMakeSolidAsap_doRun

	playerMakeSolidAsap_$player4:
	level.coopPlayer4MakeSolidAsapRunning ifgreaterequal 1 goto playerMakeSolidAsap_allreadyrunning
	level.coopPlayer4MakeSolidAsapRunning = 1
	goto playerMakeSolidAsap_doRun
	
	//lets goooooo
	playerMakeSolidAsap_doRun:
	local.playerToHandle notsolid
	
	//loop from here
	playerMakeSolidAsap_loop:
	local.index += 1
	local.index ifgreaterequal 5 goto playerMakeSolidAsap_check
	local.player string "$player"
	local.player appendint local.index
	
	//same player, skip
	local.playerToHandle ifstrequal local.player goto playerMakeSolidAsap_skip
	level.coopCinematic ifequal 1 goto playerMakeSolidAsap_cinematic	
	//dead, skip
	local.playerAlive isentalive local.player
	// local.printout string "playerMakeSolidAsap: player dead:"
	// local.printout append local.player
	// local.printout append "\n"
	// local.playerAlive ifequal 0 print local.printout
	local.playerAlive ifequal 0 goto playerMakeSolidAsap_loop
	
	parm.playersTouching1 string local.playerToHandle
	parm.playersTouching2 string local.player
	thread playersTouching
	local.inside = parm.playersTouching
    local.inside ifgreaterequal 1 goto playerMakeSolidAsap_inside
	goto playerMakeSolidAsap_loop
	
	playerMakeSolidAsap_check:
	// parm.print1 string "playerMakeSolidAsap: check: "
	// parm.print2 string local.playerToHandle
	// parm.print3 string " cin/inside: "
	// parm.print4 string level.coopCinematic
	// parm.print5 string "/"
	// parm.print6 string local.inside
	// thread println
	local.inside iflessequal 0 goto playerMakeSolidAsap_makeSolid
	
	//player inside player -make the other nonsolid as well
	playerMakeSolidAsap_inside:
	parm.playerMakeSolidAsapPlayerOther string local.player
	thread playerMakeSolidAsapPlayerOther
	
	// local.printout string "MakeSolid inside for player: "
	// local.printout append local.player
	// local.printout append " is inside "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	// print local.printout
	goto playerMakeSolidAsap_waitframe
	
	//wait a frame, then check if player still exists
	playerMakeSolidAsap_waitframe:
	local.index = 0
	local.inside = 0
	wait game.FRAMETIME
	parm.playerExist string local.playerToHandle
	thread playerExist
	local.playerExist = parm.playerExistTrue
	local.playerExist iflessequal 0 goto playerMakeSolidAsap_end
	goto playerMakeSolidAsap_loop
	
	//same player, skip
	playerMakeSolidAsap_skip:
	// local.printout string "MakeSolid skipped player: "
	// local.printout append local.playerToHandle
	// local.printout append " versus "
	// local.printout append local.player
	// local.printout append "\n"
	// print local.printout
	goto playerMakeSolidAsap_loop
	
	//yay - make it solid baby
	playerMakeSolidAsap_makeSolid:
	// local.printout string "MakeSolid success for player: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	// print local.printout
	local.playerToHandle solid
	
	//make sure to clean up afterwards!
	playerMakeSolidAsap_end:
	// local.printout string "playerMakeSolidAsap_end for: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	// print local.printout
	local.playerToHandle ifstrequal "$player1" level.coopPlayer1MakeSolidAsapRunning = 0
	local.playerToHandle ifstrequal "$player2" level.coopPlayer2MakeSolidAsapRunning = 0
	local.playerToHandle ifstrequal "$player3" level.coopPlayer3MakeSolidAsapRunning = 0
	local.playerToHandle ifstrequal "$player4" level.coopPlayer4MakeSolidAsapRunning = 0
	end
	playerMakeSolidAsap_cinematic:
	// local.printout string "MakeSolid aborted cinematic: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	goto playerMakeSolidAsap_end
	
	playerMakeSolidAsap_doesnotexist:
	// local.printout string "MakeSolid aborted does not exist: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	goto playerMakeSolidAsap_end
	
	playerMakeSolidAsap_isdead:
	// local.printout string "MakeSolid aborted is dead: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	goto playerMakeSolidAsap_end

	playerMakeSolidAsap_allreadyrunning:
	// local.printout string "MakeSolid allready running for: "
	// local.printout append local.playerToHandle
	// local.printout append "\n"
	end
end

// Generated by ChatGTP and updated by Chrissstrahl
// Checks whether two player bounding boxes overlap.
// parm.playersTouching1 = first player
// parm.playersTouching2 = second player
//
// Result: parm.playersTouching
// 0 = not touching
// 1 = touching
//
// Assumes standing players: 32x32x72.
playersTouching:
    parm.playersTouching = 0

	parm.objectExist string parm.playersTouching1
	thread objectExist
	parm.objectExistTrue iflessequal 0 end

	parm.objectExist string parm.playersTouching2
	thread objectExist
	parm.objectExistTrue iflessequal 0 end
	
    local.origin1 getorigin parm.playersTouching1
    local.origin2 getorigin parm.playersTouching2

    local.diff vector local.origin1
    local.diff vector_subtract local.origin2

	// local.vecLngt1 vector local.origin1
	// local.vecLngt1 vector_subtract local.origin2
	// local.vecLngt vector_length local.vecLngt1
	// parm.print1 string "playersTouching Vector Length is: "
	// parm.print2 string local.vecLngt
	// thread println

    local.x vector_x local.diff
    local.y vector_y local.diff
    local.z vector_z local.diff

	playersTouching_check:
    local.x ifgreater 32 end
    local.x ifless -32 end

    local.y ifgreater 32 end
    local.y ifless -32 end

    local.z ifgreater 72 end
    local.z ifless -72 end

    parm.playersTouching = 1
end

// Generated by ChatGTP and updated by Chrissstrahl
// Calculates 3D distance between two entities
// Input:
//   parm.entityDistance1
//   parm.entityDistance2
// Output:
//   parm.entityDistance
//=============================================
entityDistance:
    parm.entityDistance = 99999

    parm.objectExist string parm.entityDistance1
    thread objectExist
    parm.objectExistTrue iflessequal 0 end

    parm.objectExist string parm.entityDistance2
    thread objectExist
    parm.objectExistTrue iflessequal 0 end

    local.origin1 getorigin parm.entityDistance1
    local.origin2 getorigin parm.entityDistance2

    local.diff vector local.origin1
    local.diff vector_subtract local.origin2

    parm.entityDistance vector_length local.diff
end

//for testing, handels all entities
//skipping world=0 and players=1+
entitiesAll:
	local.index = level.maxClientsCvar
	local.objects = 0 
	
	entitiesRemove_loop:
	local.objects += 1
	local.index += 1
	local.index ifgreaterequal level.maxentities end
	
	local.printOut string "Entnum: *"
	local.printOut append local.index
	local.printOut append "\n"
	print local.printOut
	
	local.entityNum string "*"
	local.entityNum append local.index
	
	local.entityNum open
	local.entityNum unlock

	//wait a frame every x loops to prevent infinite loop error (probably 150 to 1024 iterations - untested)
	local.objects ifgreaterequal 500 goto entitiesRemove_loop_reset
	goto entitiesRemove_loop
	
	entitiesRemove_loop_reset:
	wait game.FRAMETIME
	local.objects = 0
	goto entitiesRemove_loop
end

checkInfoPlayerStart:
//INTERNAL coop_main.scr USE ONLY!
	local.vectorTest1 vector level.infoPlayerStartOrigin1
	local.vectorLngt vector_length local.vectorTest1
	local.vectorLngt ifgreaterequal 1 end
	parm.warningLoop string "COOP ERROR: level.infoPlayerStartOrigin1 is '0 0 0' should be set to info_playerstart origin"
	thread warningLoop
end

