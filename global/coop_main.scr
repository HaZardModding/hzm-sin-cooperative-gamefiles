	local.vectorTest1 vector_subtract level.infoPlayerStartOrigin2
	local.vectorLngt vector_length local.vectorTest1
	local.vectorLngt iflessequal 0 thread warningLoop
	
	parm.warningLoop string "COOP ERROR: level.coopPlayer3SpawnLocation has the same coordinates as level.infoPlayerStartOrigin2"
	local.vectorTest1 vector level.coopPlayer3SpawnLocation
	local.vectorTest1 vector_subtract level.infoPlayerStartOrigin2
	local.vectorLngt vector_length local.vectorTest1
	local.vectorLngt iflessequal 0 thread warningLoop
	
	parm.warningLoop string "COOP ERROR: level.coopPlayer4SpawnLocation has the same coordinates as level.infoPlayerStartOrigin2"
	local.vectorTest1 vector level.coopPlayer4SpawnLocation
	local.vectorTest1 vector_subtract level.infoPlayerStartOrigin2
