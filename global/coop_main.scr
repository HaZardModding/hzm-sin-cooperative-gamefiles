//Contains main coop scripts
//Chrissstrahl - 2026.10.22

main:
	//do not run twiche
	level.coopRunning ifequal 1 end
	level.coopRunning = 1
	
	//we might want to spawn our own spawnlocations in the future here or in mapname.ent_patch
	//The first player will always spawn at info_player_start, regardless, he needs to be moved
	//spawn info_player_coop"origin "400 -909 240" targetname "coopSpawn1"
	
	aliasscript global/coop_mom.scr coopMom
	aliasscript global/coop_replace.scr coopReplace
	aliasscript global/coop_spawnlocations.scr coopPlayerSpawn
	thread global/coop_variables.scr::main
	waitForThread parm.previousthread
	
	//spawn spawnlocations
	local.playerSpawnThread string "coopPlayerSpawn::"
	local.playerSpawnThread append level.map_name
	thread local.playerSpawnThread
	
	//handle players
	thread coopWaitForPlayer
	
	//check server and script settings
		// sv_fraglimit (15) - id Tech 2 game variable
		// sv_timelimit (20) - id Tech 2 game variable
		// sv_vote_single_vote (0) - Toggle if a vote can be initiated with only one player on the server.
		// sv_vote_chat_yesno ( 1) - Set to 1 to allow 'yes' and 'no' voting commands as a chat message while a vote is in progress.
		// sv_spawn_protection (0) - Toggle spawn protection in multiplayer.
		// sv_spawn_protection_time (2) - Time (in seconds) for spawn protection in multiplayer.  Requires sv_spawn_protection CVAR to be set.
	
		// sv_motd () - Message of the Day (MOTD) for multiplayer.  Separate newlines with the pipe '|' character.
		// sv_motd_time (5.0) - Time (in seconds) to display the Message of the Day (MOTD) for multiplayer.
	
		// sv_vote_disallow_flags:
		// * No gamemode changes - 1
		// * No Deathmatch gamemode changes - 2
		// * No CTF gamemode changes - 4
		// * No Coop gamemode - 8
		// * No Fraglimit changes - 16
		// * No Timelimit changes - 32
		// * No Coop skill changes - 64
		// * No Map changes - 128
		// * No Random maps - 256
		// * No Map Resets - 512
		// * Map voting locked to map rotation CVAR - 1024
		// * No voting for end match/next map - 2048
		// * No voting for maxclients changes - 4096
		// * No voting for grappling hook changes - 8192
		// * No voting for fast weapon switching changes - 16384
	thread checkInfoPlayerStart
	thread checkSpawnLocations
	thread checkCoopGame
	
	//Allow single blade voting for dev testing
	local.hostName getcvar "name"
	local.chriss string "ChristianStrahl"
	local.hostName ifequal level.devName stuffcmd "seta sv_vote_single_vote 1"
	
	print "=======================\nCoop started and ready\n=======================\n"
end

coopWaitForPlayer:
	waitForPlayer
	thread playerTargetnames
	waitForThread parm.previousthread
end

resetCoordForPlayer:
//INTERNAL coop_main.scr USE ONLY!
//Resets where the player should respawn - will then spawn at predefined spot
	parm.player ifstrequal "$player1" level.coopPlayer1LastCoord string "0 0 0"
	parm.player ifstrequal "$player2" level.coopPlayer2LastCoord string "0 0 0"
	parm.player ifstrequal "$player3" level.coopPlayer3LastCoord string "0 0 0"
	parm.player ifstrequal "$player4" level.coopPlayer4LastCoord string "0 0 0"
end

setCoordForPlayer:
//INTERNAL coop_main.scr USE ONLY!
//Keeps track of where the player should respawn
	parm.player ifstrequal "$player1" level.coopPlayer1LastCoord string parm.setCoordForPlayer
	parm.player ifstrequal "$player2" level.coopPlayer2LastCoord string parm.setCoordForPlayer
	parm.player ifstrequal "$player3" level.coopPlayer3LastCoord string parm.setCoordForPlayer
	parm.player ifstrequal "$player4" level.coopPlayer4LastCoord string parm.setCoordForPlayer
end

getCoordForPlayer:
//INTERNAL coop_main.scr USE ONLY!
//Keeps track of where the player should respawn
	parm.player ifstrequal "$player1" parm.getCoordForPlayer string level.coopPlayer1LastCoord
	parm.player ifstrequal "$player2" parm.getCoordForPlayer string level.coopPlayer2LastCoord
	parm.player ifstrequal "$player3" parm.getCoordForPlayer string level.coopPlayer3LastCoord
	parm.player ifstrequal "$player4" parm.getCoordForPlayer string level.coopPlayer4LastCoord
end

aliveStatusForPlayer:
//INTERNAL coop_main.scr USE ONLY!
	parm.player ifstrequal "$player1" level.coopPlayer1Alive = parm.aliveStatusForPlayer
	parm.player ifstrequal "$player2" level.coopPlayer2Alive = parm.aliveStatusForPlayer
	parm.player ifstrequal "$player3" level.coopPlayer3Alive = parm.aliveStatusForPlayer
	parm.player ifstrequal "$player4" level.coopPlayer4Alive = parm.aliveStatusForPlayer
end

manageStatusForPlayer:
//INTERNAL coop_main.scr USE ONLY!
	parm.manageStatusForPlayer_value = 0
	parm.player ifstrequal "$player1" parm.manageStatusForPlayer_value = level.coopPlayer1Managing
	parm.player ifstrequal "$player2" parm.manageStatusForPlayer_value = level.coopPlayer2Managing
	parm.player ifstrequal "$player3" parm.manageStatusForPlayer_value = level.coopPlayer3Managing
	parm.player ifstrequal "$player4" parm.manageStatusForPlayer_value = level.coopPlayer4Managing
end

manageStatusForPlayerSet:
//INTERNAL coop_main.scr USE ONLY!
	parm.player ifstrequal "$player1" level.coopPlayer1Managing = parm.manageStatusForPlayer
	parm.player ifstrequal "$player2" level.coopPlayer2Managing = parm.manageStatusForPlayer
	parm.player ifstrequal "$player3" level.coopPlayer3Managing = parm.manageStatusForPlayer
	parm.player ifstrequal "$player4" level.coopPlayer4Managing = parm.manageStatusForPlayer
end

managePlayer4_start:
//INTERNAL coop_main.scr USE ONLY!
	parm.player string "$player4"
	parm.playerExist string parm.player
	thread playerExist
	parm.playerExistTrue iflessequal 0 end
	parm.playerEvent string parm.player
	thread managePlayer4
	thread playerEntered_event
end

managePlayer3_start:	
//INTERNAL coop_main.scr USE ONLY!
	parm.player string "$player3"
	parm.playerExist string parm.player
	thread playerExist
	parm.playerExistTrue iflessequal 0 end
	parm.playerEvent string parm.player
	thread managePlayer3
	thread playerEntered_event
end

managePlayer2_start:
//INTERNAL coop_main.scr USE ONLY!
	parm.player string "$player2"
	parm.playerExist string parm.player
	thread playerExist
	parm.playerExistTrue iflessequal 0 end
	parm.playerEvent string parm.player
	thread managePlayer2
	thread playerEntered_event
end

managePlayer1_start:
//INTERNAL coop_main.scr USE ONLY!
	parm.player string "$player1"
	parm.playerExist string parm.player
	thread playerExist
	parm.playerExistTrue iflessequal 0 end
	parm.playerEvent string parm.player
	thread managePlayer1
	thread playerEntered_event
end

managePlayer4:
//INTERNAL coop_main.scr USE ONLY!
	local.player string parm.player
	level.coopPlayer4Managing = 1
	level.coopDebug ifgreaterequal 1 print "managePlayer4 Started\n"

	//loop it
	managePlayer4_loop:
	parm.player string local.player
	parm.lastAliveState = level.coopPlayer4Alive
	thread managePlayer_checkAliveChange
	waitForThread parm.previousthread
	
	wait game.FRAMETIME	
	level.coopPlayer4Managing ifgreaterequal 1 goto managePlayer4_loop
	level.coopDebug ifgreaterequal 1 print "managePlayer4 Terminated\n"
end

managePlayer3:
//INTERNAL coop_main.scr USE ONLY!
	local.player string parm.player
	level.coopPlayer3Managing = 1
	level.coopDebug ifgreaterequal 1 print "managePlayer3 Started\n"
	
	//loop it
	managePlayer3_loop:
	parm.player string local.player
	parm.lastAliveState = level.coopPlayer3Alive
	thread managePlayer_checkAliveChange
	waitForThread parm.previousthread
	
	wait game.FRAMETIME	
	level.coopPlayer3Managing ifgreaterequal 1 goto managePlayer3_loop
	level.coopDebug ifgreaterequal 1 print "managePlayer3 Terminated\n"
end

managePlayer2:
//INTERNAL coop_main.scr USE ONLY!
	local.player string parm.player
	level.coopPlayer2Managing = 1
	level.coopDebug ifgreaterequal 1 print "managePlayer2 Started\n"
	
	//loop it
	managePlayer2_loop:
	parm.player string local.player
	parm.lastAliveState = level.coopPlayer2Alive
	thread managePlayer_checkAliveChange
	waitForThread parm.previousthread
	
	wait game.FRAMETIME	
	level.coopPlayer2Managing ifgreaterequal 1 goto managePlayer2_loop
	level.coopDebug ifgreaterequal 1 print "managePlayer2 Terminated\n"
end

managePlayer1:
//INTERNAL coop_main.scr USE ONLY!
	local.player string parm.player
	level.coopPlayer1Managing = 1
	level.coopDebug ifgreaterequal 1 print "managePlayer1 Started\n"

	//loop it
	managePlayer1_loop:
	parm.player string local.player
	parm.lastAliveState = level.coopPlayer1Alive
	thread managePlayer_checkAliveChange
	waitForThread parm.previousthread
	wait game.FRAMETIME
	
	level.coopPlayer1Managing ifgreaterequal 1 goto managePlayer1_loop
	level.coopDebug ifgreaterequal 1 print "managePlayer1 Terminated\n"
end

managePlayer_checkAliveChange:
//INTERNAL coop_main.scr USE ONLY!
	parm.playerAlive isentalive parm.player
	parm.playerAlive ifequal 1 goto managePlayer_checkAliveChange_exist
	parm.playerExist string parm.player
	thread playerExist
	parm.playerExistTrue ifequal 1 goto managePlayer_checkAliveChange_exist
	goto playerDisconnected
	end
	
	managePlayer_checkAliveChange_exist:
	thread manageStatusForPlayer
	thread playerIsSpectator
	parm.playerIsSpectatorTrue ifgreaterequal 1 goto managePlayer_checkAliveChange_spectator
	parm.manageStatusForPlayer_value ifequal 4 goto managePlayer_checkAliveChange_alive
	
	parm.playerAlive ifequal parm.lastAliveState end
	parm.playerAlive ifequal 1 goto managePlayer_checkAliveChange_alive
	parm.playerAlive ifequal 0 goto managePlayer_checkAliveChange_dead
	end
	managePlayer_checkAliveChange_spectator:
	parm.manageStatusForPlayer_value ifequal 4 end
	thread playerSpectator
	end
	managePlayer_checkAliveChange_alive:
	thread playerSpawned
	end
	managePlayer_checkAliveChange_dead:
	thread playerDied
end

playerSpectator:
//INTERNAL coop_main.scr USE ONLY!
	parm.print1 string "Player became spectator: "
	parm.print2 append parm.player
	thread println
	
	parm.playerEvent string parm.player

	thread manageStatusForPlayer
	parm.manageStatusForPlayer_value ifequal 4 end
	
	thread resetCoordForPlayer

	parm.manageStatusForPlayer = 4
	thread manageStatusForPlayerSet
	
	thread playerCinematic
	
	thread playerSpectator_event
end

playerSpawned:
//INTERNAL coop_main.scr USE ONLY!
	parm.print1 string "Player was spawned: "
	parm.print2 append parm.player
	thread println
	
	parm.playerEvent string parm.player
	
	parm.manageStatusForPlayer = 2
	thread manageStatusForPlayerSet
	
	parm.aliveStatusForPlayer = 1
	thread aliveStatusForPlayer
	
	thread playerMoveToSpawn
	thread playerEquip
	
	thread playerCinematic
	
	thread playerSpawned_event
	
	//TEST - REMOVE
	//TEST - REMOVE
	//TEST - REMOVE
	//TEST - REMOVE
	thread testStuff
end

playerDied:
//INTERNAL coop_main.scr USE ONLY!
	parm.print1 string "Player was killed: "
	parm.print2 append parm.player
	thread println
	
	parm.playerEvent string parm.player	
	
	local.playerOrigin getorigin parm.player
	parm.setCoordForPlayer string local.playerOrigin
	thread setCoordForPlayer
		
	//parm.player clearsavedangles
	parm.aliveStatusForPlayer = 0
	thread aliveStatusForPlayer
	
	parm.manageStatusForPlayer = 3
	thread manageStatusForPlayerSet
	
	thread playerCinematic	
	
	thread playerDied_event
end

playerDisconnected_event:
//INTERNAL coop_main.scr USE ONLY!
	level.coopExecEventDisconnected ifless 1 end
	local.threadIDrunning = parm.previousthread
	local.spawnLocThread string "maps/"
	local.spawnLocThread append level.map_name
	local.spawnLocThread append ".scr::coop_justLeft"
	thread local.spawnLocThread
	//function does not exist if thread id is identical prevent further execution for this level
	local.threadID = parm.previousthread
	local.threadID iflessequal local.threadIDrunning level.coopExecEventDisconnected = 0
end

playerSpectator_event:
//INTERNAL coop_main.scr USE ONLY!
	level.coopExecEventSpectator ifless 1 end
	local.threadIDrunning = parm.previousthread
	local.spawnLocThread string "maps/"
	local.spawnLocThread append level.map_name
	local.spawnLocThread append ".scr::coop_justBecameSpectator"
	thread local.spawnLocThread
	//function does not exist if thread id is identical prevent further execution for this level
	local.threadID = parm.previousthread
	local.threadID iflessequal local.threadIDrunning level.coopExecEventSpectator = 0
end

playerSpawned_event:
//INTERNAL coop_main.scr USE ONLY!
	level.coopExecEventSpawned ifless 1 end
	local.threadIDrunning = parm.previousthread
	local.spawnLocThread string "maps/"
	local.spawnLocThread append level.map_name
	local.spawnLocThread append ".scr::coop_justSpawned"
	thread local.spawnLocThread
	//function does not exist if thread id is identical prevent further execution for this level
	local.threadID = parm.previousthread
	local.threadID ifequal local.threadIDrunning level.coopExecEventSpawned = 0
end

playerDied_event:
//INTERNAL coop_main.scr USE ONLY!
	level.coopExecEventDied ifless 1 end
	local.threadIDrunning = parm.previousthread
	local.spawnLocThread string "maps/"
	local.spawnLocThread append level.map_name
	local.spawnLocThread append ".scr::coop_justDied"
	thread local.spawnLocThread
	//function does not exist if thread id is identical prevent further execution for this level
	local.threadID = parm.previousthread
	local.threadID iflessequal local.threadIDrunning level.coopExecEventDied = 0
end

playerEntered_event:
//INTERNAL coop_main.scr USE ONLY!
	level.coopExecEventEntered ifless 1 end
	local.threadIDrunning = parm.previousthread
	local.spawnLocThread string "maps/"
	local.spawnLocThread append level.map_name
	local.spawnLocThread append ".scr::coop_justEntered"
	thread local.spawnLocThread
	//function does not exist if thread id is identical prevent further execution for this level
	local.threadID = parm.previousthread
	local.threadID iflessequal local.threadIDrunning level.coopExecEventEntered = 0
end

playerIsSpectator:
	parm.playerIsSpectatorTrue = 0
	//spectators can't be dead, and you can't go spec when dead
    local.alive isentalive parm.player
    local.alive iflessequal 0 end
	//player will always spawn with a gun so at least for one frame (if other(TAKE) functions are timed right) this will return false
	local.weapon getweapon parm.player
	local.weapon ifstrnotequal "" end
	//failsafe, check if player still has the item we gave them
	parm.playerHasItem string level.coopSpectatorCheckModel
	thread playerHasItem
	parm.playerHasItemTrue ifgreaterequal 1 end
	parm.playerIsSpectatorTrue = 1
end

playerHasItem:
	parm.playerHasItemTrue = 0
    parm.player ifstrequal "$player1" local.itemcount getitemcount *1 parm.playerHasItem
    parm.player ifstrequal "$player2" local.itemcount getitemcount *2 parm.playerHasItem
    parm.player ifstrequal "$player3" local.itemcount getitemcount *3 parm.playerHasItem
    parm.player ifstrequal "$player4" local.itemcount getitemcount *4 parm.playerHasItem
	local.itemcount iflessequal 0 end
	parm.playerHasItemTrue = 1
end

// Generated by ChatGTP
//input: parm.playerAnyoneHasItem
//output: parm.playerAnyoneHasItemTrue
playerAnyoneHasItem:
    parm.playerAnyoneHasItemTrue = 0
    local.index = 0

	playerAnyoneHasItem_loop:
    local.index += 1
    local.index ifgreaterequal 5 end

    parm.player string "$player"
    parm.player appendint local.index

	parm.playerHasItem string parm.playerAnyoneHasItem
    thread playerHasItem
    parm.playerHasItemTrue iflessequal 0 goto playerAnyoneHasItem_loop
	
    parm.playerAnyoneHasItemTrue = 1
end

playerDisconnected:
//INTERNAL coop_main.scr USE ONLY!
	local.playerFunc string parm.player
	local.playerFunc append "Disconnected"
	thread local.playerFunc
	
	//reset dynamic spawn location
	thread resetCoordForPlayer
	
	parm.playerEvent string parm.player
	thread playerDisconnected_event
end

$player1Disconnected:
//INTERNAL coop_main.scr USE ONLY!
	print "$player1 Disconnected\n"
    level.coopPlayer1Alive = 0
	level.coopPlayer1Managing = 0
	level.coopPlayer1MakeSolidAsapRunning = 0
end

$player2Disconnected:
//INTERNAL coop_main.scr USE ONLY!
