checkCoopGame:
//INTERNAL coop_main.scr USE ONLY!
	//complain if the coop cvar is set incorrectly
	level.coopInMultiplayer ifequal	666 end
	parm.warningLoop string "COOP ERROR: Gametype is not coop, use >> set coop 1 << and load the level again"
	thread warningLoop
end

warningLoop:
	local.warning string parm.warningLoop
	setcvar	"g_developer 128"
	
	warningLoop_loop:
	level.coopDebug ifgreaterequal 1 thread errorNotify
	parm.print1 string local.warning
	thread println	
	wait 3
	goto warningLoop_loop
end

errorNotify:
//INTERNAL coop_main.scr USE ONLY!
	level.coopScreenprintWarningActive ifequal 1 end
	level.coopScreenprintWarningActive = 1
	screenprint 1 "jcx yv -40 fc 1 1 1 1 string \"COOP ERROR - Please check console!\""
	wait 1
	level.coopScreenprintWarningActive = 0
end

playerCinematic:
//INTERNAL coop_main.scr USE ONLY!
	local.player string parm.player
	
	//cue camera if set, this makes the player view from the current cinematic cam
	level.coopCamera ifstrnotequal "" cuecamera level.coopCamera	
	
	//only during cinematic make notsolid
	level.coopCinematic ifless 1 end
	local.player notsolid
	local.player hide
end

inMultiplayer:
	parm.inMultiplayer = 0
	level.coopInMultiplayer ifgreaterequal 1 parm.inMultiplayer = 1
end

inCoop:
	parm.inCoop = 0
	level.coopInMultiplayer ifequal 666 parm.inCoop = 1
end

waitForRemove:
	local.removeMe string parm.waitRemove
	waitForRemove_loop:
	parm.playerExist string local.removeMe
	thread playerExist
	parm.playerExistTrue ifequal 0 end
	wait game.FRAMETIME
	goto waitForRemove_loop
end

//triggered when any player spawns
testStuff:
	//level.dugsfghjegfujdsgfACTIVE ifequal 1 end
	//level.dugsfghjegfujdsgfACTIVE = 1
	
	thread coopMom::main
	end	
	
	testStuff__spwLp:
	parm.objectExist string "coop_specChecker1"
	thread objectExist
	print parm.objectExistTrue
	print "\n"
	wait game.FRAMETIME
	goto testStuff__spwLp
	
	testStuff_inventoryCheckLoop:
	local.item$count = 1
	local.quartercount getitemcount *1 level.coopSpectatorCheckModel
	local.quartercount ifequal 0 local.item$count = 0
	parm.print1 string "Itemcount: "
	parm.print2 string local.item$count
	thread println
	wait 2
	goto testStuff_inventoryCheckLoop
end
