  crucialdialog "i_computer" "m_secondary_objective_failed" "mission_comp/mix3ima.wav" 1 5
  waitForSound "mission_comp/mix3ima.wav" 1
end

// new MissionCon; more data-driven, letting
// the client handle rendering in different ways.

level.misconid = 0

NewMisConSetup:
  %missioncon conlayout "newmiscon"
  %missioncon conapplayoutquoted level.map_name
end

// parms
// status: 0 not accomplished 1 = success 2 = fail 3 = not available
// title: localized title string
NewMisConPrimary:
  parm.status ifequal 3 goto NewMisConPrimary_Skip

  %missioncon conapplayout "primary"
  %missioncon conapplayout parm.status
  %missioncon conapplayout parm.title

  NewMisConPrimary_Skip:
end

// parms
// status: 0 not accomplished 1 = success 2 = fail 3 = not available
// title: localized title string
NewMisConSecondary:
  parm.status ifequal 3 goto NewMisConSecondary_Skip

  %missioncon conapplayout "secondary"
  %missioncon conapplayout parm.status
  %missioncon conapplayout parm.title

  NewMisConSecondary_Skip:
end

CopyNewMisConToIntermission:
  local.IMString getconsolelayout "missioncon"
  intermissionlayout local.IMString
end

// ------------------------------------------
// Blade finds a secret
// ------------------------------------------
secret: 
  local.AchSecrets getcvar g_ach_secrets
  local.AchSecrets ifequal 5 goto secretdoneach
  local.AchSecrets += 1
  forcesetcvar g_ach_secrets local.AchSecrets
  local.AchSecrets ifnotequal 5 goto secretdoneach
  unlockachievement "ACH_SIN_BONUS"

  secretdoneach:

  crucialdialogloc "i_computer" m_secrets_found 2 level.found_secrets level.total_secrets "mission_comp/mix1ima.wav" 1 5
  waitForSound "mission_comp/secret.wav" 1
end

