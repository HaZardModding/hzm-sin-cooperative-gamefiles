// ------------------------------------------
// Start a player with a new episode
// ------------------------------------------
NewEpisode:
local.has_pulse = 0
*1 ifhaspulserifleparts local.has_pulse = 1
*1 health 100
*1 take all
*1 take Bullet10mm 1000
*1 take Bullet50mm 1000
*1 take BulletPulse 1000
*1 take BulletSniper 1000
*1 take Rockets 1000
*1 take Spears 1000
*1 take ShotgunClip 1000
*1 take SpiderMines 1000
*1 take FlakJacket 200
*1 take FlakPants 200
*1 take RiotHelmet 200
*1 take BluePrints 1000
*1 take ComLink 1000
*1 take GlowStick 1000
*1 take MoneyBag 1000
*1 take PassCode 1000
*1 take Chemsuit 1000
*1 take silencer 1000
*1 take Hand 1000
*1 give fists
local.has_pulse ifequal 1 *1 give PulseRifle
*1 give Magnum
end

// ------------------------------------------
// Mission Status Computer 
// ------------------------------------------
StatusUpdated:
  crucialdialog "i_computer" "m_mission_status_updated_tab" "mission_comp/update.wav" 1 5
  waitForSound "mission_comp/update.wav" 1
end

AutoSave:

game.last_autosave_level ifstrnotequal level.map_name goto actually_autosave

local.time_diff = game.time
local.time_diff -= game.last_autosave_time

local.time_diff ifgreater 0 goto actually_autosave

goto skip_autosave

actually_autosave:
  stuffcmd "autosave"

  game.last_autosave_level string level.map_name
  game.last_autosave_time = game.time
  game.last_autosave_time += 60

skip_autosave:

end

PObjectiveComplete:
  thread AutoSave
  music success
  crucialdialog "i_computer" "m_primary_objective_completed" "mission_comp/mix1ima.wav" 1 5
  waitForSound "mission_comp/mix1ima.wav" 1
end

PObjectiveCompleteNoMusic:
  thread AutoSave
  crucialdialog "i_computer" "m_primary_objective_completed" "mission_comp/mix1ima.wav" 1 5
  waitForSound "mission_comp/mix1ima.wav" 1
end

SObjectiveComplete:
  thread AutoSave
  music success
  crucialdialog "i_computer" "m_secondary_objective_completed" "mission_comp/mix1ima.wav" 1 5
  waitForSound "mission_comp/mix1ima.wav" 1
end

SObjectiveCompleteNoMusic:
  thread AutoSave
  crucialdialog "i_computer" "m_secondary_objective_completed" "mission_comp/mix1ima.wav" 1 5
  waitForSound "mission_comp/mix1ima.wav" 1
end

PObjectiveFailed:
  thread AutoSave
  music failure
  crucialdialog "i_computer" "m_primary_objective_failed" "mission_comp/mix3ima.wav" 1 5
  waitForSound "mission_comp/mix3ima.wav" 1
end

PObjectiveFailedNoMusic:
  thread AutoSave
  crucialdialog "i_computer" "m_primary_objective_failed" "mission_comp/mix3ima.wav" 1 5
  waitForSound "mission_comp/mix3ima.wav" 1
end

SObjectiveFailed:
