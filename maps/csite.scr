//-------------------------------------------------------
// Wieder Character Additions
//-------------------------------------------------------
//-------------------------------------------------------

game.Abandon_HostageKilled ifequal 1 $hostage_roof remove
game.Abandon_HostageKilled ifequal 0 $hostage_roof thread AI_Hostage_Roof

$mancini_jumping thread AI_Mancini_Jumping
$mancini_tube thread AI_Mancini_Tube
$mancini_ladder thread AI_Mancini_Ladder
$mancini_final thread AI_Mancini_Final

$hostage_vator thread AI_Hostage_Vator

$thug_dumpster thread AI_Thug_Dumpster
$thug_ledge1 thread AI_Thug_Ledge1
$thug_ledge2 thread AI_Thug_Ledge2
$thug1_roof1 thread AI_Thug1_Roof1
$thug2_roof1 thread AI_Thug2_Roof1

$csite_thug1 thread AI_CYard_Thug1
$csite_thug2 thread AI_CYard_Thug2
$csite_thug3 thread AI_CYard_Thug3
$csite_worker1 thread AI_PushWorker

$basement_thug6 item health 50
$basement_thug7 item health 50
level.SkillLevel ifless 2 $basement_thug1 remove
level.SkillLevel ifless 2 $basement_thug2 remove
level.SkillLevel ifgreaterequal 2 $basement_thug1 thread AI_Basement_Thug1
level.SkillLevel ifgreaterequal 2 $basement_thug2 thread AI_Basement_Thug2
$basement_thug_ambush thread AI_Basement_ThugAmbush
parm.ThugNum = 3
$basement_thug3 thread AI_Basement_Thugs
parm.ThugNum = 4
$basement_thug4 thread AI_Basement_Thugs
parm.ThugNum = 5
$basement_thug5 thread AI_Basement_Thugs
parm.ThugNum = 6
$basement_thug6 thread AI_Basement_Thugs
parm.ThugNum = 7
$basement_thug7 thread AI_Basement_Thugs

$pool_thug1 item GlowStick 2

$bum1 thread AI_Bum1
$bum2 thread AI_Bum2

$vator_thug1 thread AI_Vator_Thug1
$vator_thug2 thread AI_Vator_Thug2
$vator_thug3 thread AI_Vator_Thug3

$t9 thread AI_OutsideThugs
$end_thug3 thread AI_EndThugs

$foreman thread AI_Foreman

//------------------------------------------------------------
//------------------------------------------------------------
// joyeuse additions ;D
//------------------------------------------------------------
//------------------------------------------------------------
thread atv_motion_monitor

//dark water
server lightstyle 167 "RmmmmmmmmmmmmmmGmmmmmmmmmmmmmmBllllllllllllllAqqqqqqqqqqqqqq"

// Flickering fluorescent light beside the office entry doors.
// The entry-door ram sequence turns this unique style off when the doors break.
server lightstyle 168 "mmamammmmammamamaaamammma"

// Numbered debris objects use box#_body and box#_explode.
// Each box#_body needs an origin brush at the center of the intact object.
// Increase this count when another numbered object is added to the map.
level.rammable_shatter_count = 9
thread rammable_shatter_setup_all

// Guns cannot damage the hydrants. Nearby map triggers start the ATV probes.
$ram_hydrant1 nodamage
$ram_hydrant2 nodamage

thread rocketcar_launcher_setup

// Keep these gate values in sync with the tuned pre-refactor behavior.
parm.ram_trigger string "$gate1_ram_trigger"
parm.ram_piece1 string "$gate1_piece1"
parm.ram_piece2 string "$gate1_piece2"
parm.ram_piece1_height = 56
parm.ram_piece2_height = 56
parm.ram_piece1_stage1_move string "(64 -64 16)"
parm.ram_piece2_stage1_move string "(64 16 32)"
parm.ram_piece1_rotate string "(-405 -45 0)"
parm.ram_piece2_rotate string "(-1800 18 0)"
parm.ram_piece1_stage2_move string "(640 0 8)"
parm.ram_piece2_stage2_move string "(384 0 8)"
// Gate 1 uses far-edge origin brushes, so its contact radius must cover the gate depth.
parm.ram_probe_range = 128
// The ATV must reach this speed to break this pair.
parm.ram_required_speed = 250
// Set this above 0 to guarantee a minimum total forward travel distance.
parm.ram_min_forward_distance = 0
// Set this above 0 to limit total forward travel. A value of 0 disables the limit.
parm.ram_max_forward_distance = 0
parm.ram_break_target string "$gate1_ram_break"
parm.ram_scare_group string "parking_garage"
parm.ram_sound string "impact/wood/woodmix5.wav"
parm.ram_sound_volume = 4
thread rammable_pair_thread

parm.ram_trigger string "$gate2_ram_trigger"
parm.ram_piece1 string "$gate2_piece1"
parm.ram_piece2 string "$gate2_piece2"
parm.ram_piece1_height = 56
parm.ram_piece2_height = 56
parm.ram_piece1_stage1_move string "(64 -64 16)"
parm.ram_piece2_stage1_move string "(64 16 32)"
parm.ram_piece1_rotate string "(-408 -45 0)"
parm.ram_piece2_rotate string "(-1800 18 0)"
parm.ram_piece1_stage2_move string "(640 0 8)"
parm.ram_piece2_stage2_move string "(384 0 8)"
parm.ram_probe_range = 64
parm.ram_required_speed = 250
parm.ram_min_forward_distance = 0
parm.ram_max_forward_distance = 0
parm.ram_break_target string "$gate2_ram_break"
parm.ram_scare_group string "parking_garage"
parm.ram_sound string "impact/wood/woodmix5.wav"
parm.ram_sound_volume = 4
thread rammable_pair_thread

// The exit doors use a separate profile so they can spread apart.
parm.ram_trigger string "$ram_doorexit_trigger"
parm.ram_piece1 string "$ram_doorexit_left"
parm.ram_piece2 string "$ram_doorexit_right"
parm.ram_piece1_height = 180
parm.ram_piece2_height = 180
parm.ram_piece1_stage1_move string "(144 64 16)"
parm.ram_piece2_stage1_move string "(144 -64 16)"
parm.ram_piece1_rotate string "(0 15 90)"
parm.ram_piece2_rotate string "(0 -30 90)"
parm.ram_piece1_stage2_move string "(1440 96 8)"
parm.ram_piece2_stage2_move string "(1440 -96 8)"
parm.ram_probe_range = 64
parm.ram_required_speed = 550
parm.ram_min_forward_distance = 500
parm.ram_max_forward_distance = 0
parm.ram_break_target string "$ram_doorexit_break"
parm.ram_scare_group string ""
parm.ram_sound string "impact/crash1.wav"
parm.ram_sound_volume = 4
thread rammable_pair_thread

// The entry doors use the exit-door profile, but land on the level floor.
parm.ram_trigger string "$ram_doorenter_trigger"
parm.ram_piece1 string "$ram_doorenter_left"
parm.ram_piece2 string "$ram_doorenter_right"
parm.ram_piece1_height = 60
parm.ram_piece2_height = 60
parm.ram_piece1_stage1_move string "(144 24 16)"
parm.ram_piece2_stage1_move string "(144 -38 16)"
parm.ram_piece1_rotate string "(-90 15 0)"
parm.ram_piece2_rotate string "(-90 -10 0)"
parm.ram_piece1_stage2_move string "(1440 32 8)"
parm.ram_piece2_stage2_move string "(1440 -57 8)"
parm.ram_probe_range = 64
parm.ram_required_speed = 550
parm.ram_min_forward_distance = 0
parm.ram_max_forward_distance = 360
parm.ram_break_target string "$ram_doorenter_break"
parm.ram_scare_group string "office"
parm.ram_sound string "impact/crash1.wav"
parm.ram_sound_volume = 4
thread rammable_pair_thread

thread kp_door_buzzer_thread

// Paril poopy
thread init_flashlight

end

//============================================================
//============================================================

csite_init_thread:

$newcity_retreatdoors lock
$office_door_escape lock

level.PObjective1 = 0 // Continue Chasing Mancini
level.PObjective2 = 0 // Eliminate Hostile Forces
level.SObjective2 = 0 // Rescue Any Remaining Hostages
level.SObjective1 = 0 // Find Incriminating Evidence

level.PipeDown = 0
level.DoorBroken = 0
level.HostageCount = 0
level.Hostage1Taunted = 0
level.Hostage2Taunted = 0
game.Abandon_HostageKilled ifequal 1 level.HostageCount += 1
game.csite_HaveBlueprints = 0
$open1 open

$no_use_dozer nouse
$no_use_dozer_2 nouse
$no_use_dozer_3 nouse

//breakable boards and propane tank
$t2 health 1

$door_break_portal close
waitForPlayer

wait 1
thread joyeuse_inits
thread dialog::jc_unused_subway
local.WaitingForThread = parm.previousthread
waitForThread local.WaitingForThread
wait 1
thread MissionComputer
thread global/universal_script.scr::StatusUpdated
local.WaitingForThread = parm.previousthread
waitForThread local.WaitingForThread

end

//============================================================
//============================================================

drawer_thread:

local.drawer_index = 1

drawer_loop:

parm.drawer string "$drawer"
parm.drawer appendint local.drawer_index

thread drawer_setup_thread

local.drawer_index += 1
local.drawer_index iflessequal 4 goto drawer_loop
end

drawer_setup_thread:
local.drawer string parm.drawer
local.drawer time 1

drawer_start:
local.drawer onpreciseuse drawer_open
pause

drawer_open:
local.drawer nouse
local.drawer playsound environment/cabinet/drawer/cab11.wav 1.0
local.drawer moveEast 20
waitFor local.drawer

local.drawer onpreciseuse drawer_close
pause

drawer_close:
local.drawer nouse
local.drawer moveWest 20
waitFor local.drawer
local.drawer playsound environment/cabinet/drawer/cab12.wav 1.0
goto drawer_start
end





desk_drawer_open:
local.self time 1
local.self moveForward 20
waitFor local.self
local.self dooropened
end

desk_drawer_close:
local.self time 1
local.self moveBackward 20
waitFor local.self
local.self doorclosed
end



