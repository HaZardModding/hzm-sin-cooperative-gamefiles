//===========================================================================
// joyeuse additions shamelessly stolen from gorge.scr
// --------------------------------------------------------------------------

joyeuse_inits:
$elexis_figure anim pose
$elexis_figure setframe 0
$elexis_figure stopanim
end

atv_motion_monitor:

level.atv_speed = 0
level.atv_direction vector "(1 0 0)"
// Raise each contact point to the authored height on the ATV.
level.atv_probe_up = 28
level.active_atv string "$atv_base"
level.atv_primary_speed = 0
level.atv_primary_speed_previous1 = 0
level.atv_primary_speed_previous2 = 0
level.atv_primary_direction vector "(1 0 0)"
level.atv_primary_direction_previous1 vector "(1 0 0)"
level.atv_primary_direction_previous2 vector "(1 0 0)"
level.atv_backup_speed = 0
level.atv_backup_speed_previous1 = 0
level.atv_backup_speed_previous2 = 0
level.atv_backup_direction vector "(1 0 0)"
level.atv_backup_direction_previous1 vector "(1 0 0)"
level.atv_backup_direction_previous2 vector "(1 0 0)"
level.atv_next_breaking_sound = 0

// Poll slowly while the player is on foot. One thread samples both ATVs only
// while the player is using a vehicle.
atv_motion_monitor_wait:

wait 0.1
level.player_in_vehicle ifequal 0 goto atv_motion_monitor_wait

local.primary_previous_origin getorigin $atv_base
local.backup_previous_origin getorigin $atv_base_backup
level.atv_primary_speed = 0
level.atv_primary_speed_previous1 = 0
level.atv_primary_speed_previous2 = 0
level.atv_backup_speed = 0
level.atv_backup_speed_previous1 = 0
level.atv_backup_speed_previous2 = 0

wait game.FRAMETIME


atv_motion_monitor_active_loop:

level.player_in_vehicle ifequal 0 goto atv_motion_monitor_stopped

// Sample the regular ATV.
local.primary_current_origin getorigin $atv_base
local.primary_delta vector local.primary_current_origin
local.primary_delta vector_subtract local.primary_previous_origin
local.primary_delta vector_setz 0
level.atv_primary_speed_previous2 = level.atv_primary_speed_previous1
level.atv_primary_direction_previous2 vector level.atv_primary_direction_previous1
level.atv_primary_speed_previous1 = level.atv_primary_speed
level.atv_primary_direction_previous1 vector level.atv_primary_direction
level.atv_primary_speed vector_length local.primary_delta
level.atv_primary_speed /= game.FRAMETIME
level.atv_primary_speed iflessequal 0 goto atv_motion_monitor_primary_store
level.atv_primary_direction vector local.primary_delta
level.atv_primary_direction vector_normalize


atv_motion_monitor_primary_store:

local.primary_previous_origin vector local.primary_current_origin

// Sample the backup ATV in the same thread.
local.backup_current_origin getorigin $atv_base_backup
local.backup_delta vector local.backup_current_origin
local.backup_delta vector_subtract local.backup_previous_origin
local.backup_delta vector_setz 0
level.atv_backup_speed_previous2 = level.atv_backup_speed_previous1
level.atv_backup_direction_previous2 vector level.atv_backup_direction_previous1
level.atv_backup_speed_previous1 = level.atv_backup_speed
level.atv_backup_direction_previous1 vector level.atv_backup_direction
level.atv_backup_speed vector_length local.backup_delta
level.atv_backup_speed /= game.FRAMETIME
level.atv_backup_speed iflessequal 0 goto atv_motion_monitor_backup_store
level.atv_backup_direction vector local.backup_delta
level.atv_backup_direction vector_normalize


atv_motion_monitor_backup_store:

local.backup_previous_origin vector local.backup_current_origin

// Keep speed and direction from the same frame. Use a three-frame peak so
// contact cannot erase or turn the approach sample before a rammable checks it.
local.primary_approach_speed = level.atv_primary_speed
local.primary_approach_direction vector level.atv_primary_direction
level.atv_primary_speed_previous1 ifgreater local.primary_approach_speed goto atv_motion_monitor_use_primary_previous1
level.atv_primary_speed_previous2 ifgreater local.primary_approach_speed goto atv_motion_monitor_use_primary_previous2
goto atv_motion_monitor_primary_selected


atv_motion_monitor_use_primary_previous1:

local.primary_approach_speed = level.atv_primary_speed_previous1
local.primary_approach_direction vector level.atv_primary_direction_previous1
level.atv_primary_speed_previous2 ifgreater local.primary_approach_speed goto atv_motion_monitor_use_primary_previous2
goto atv_motion_monitor_primary_selected


atv_motion_monitor_use_primary_previous2:

local.primary_approach_speed = level.atv_primary_speed_previous2
local.primary_approach_direction vector level.atv_primary_direction_previous2


atv_motion_monitor_primary_selected:

local.backup_approach_speed = level.atv_backup_speed
local.backup_approach_direction vector level.atv_backup_direction
level.atv_backup_speed_previous1 ifgreater local.backup_approach_speed goto atv_motion_monitor_use_backup_previous1
level.atv_backup_speed_previous2 ifgreater local.backup_approach_speed goto atv_motion_monitor_use_backup_previous2
goto atv_motion_monitor_both_selected


atv_motion_monitor_use_backup_previous1:

local.backup_approach_speed = level.atv_backup_speed_previous1
local.backup_approach_direction vector level.atv_backup_direction_previous1
level.atv_backup_speed_previous2 ifgreater local.backup_approach_speed goto atv_motion_monitor_use_backup_previous2
goto atv_motion_monitor_both_selected


atv_motion_monitor_use_backup_previous2:

local.backup_approach_speed = level.atv_backup_speed_previous2
local.backup_approach_direction vector level.atv_backup_direction_previous2


atv_motion_monitor_both_selected:

local.backup_approach_speed ifgreater local.primary_approach_speed goto atv_motion_monitor_select_backup

level.active_atv string "$atv_base"
level.atv_speed = local.primary_approach_speed
level.atv_direction vector local.primary_approach_direction
goto atv_motion_monitor_active_wait


atv_motion_monitor_select_backup:

level.active_atv string "$atv_base_backup"
level.atv_speed = local.backup_approach_speed
level.atv_direction vector local.backup_approach_direction
goto atv_motion_monitor_active_wait


atv_motion_monitor_active_wait:

// Emit a silent AI sound event from the occupied ATV every 0.25 seconds.
// The player origin follows the occupied vehicle and remains correct when
// either ATV is stationary. No sound-file argument means no audible sound.
game.time ifless level.atv_next_breaking_sound goto atv_motion_monitor_active_wait_done
*1 breakingsound
level.atv_next_breaking_sound = game.time
level.atv_next_breaking_sound += 0.25


atv_motion_monitor_active_wait_done:

wait game.FRAMETIME
goto atv_motion_monitor_active_loop


atv_motion_monitor_stopped:

level.atv_speed = 0
level.atv_primary_speed = 0
level.atv_primary_speed_previous1 = 0
level.atv_primary_speed_previous2 = 0
level.atv_backup_speed = 0
level.atv_backup_speed_previous1 = 0
level.atv_backup_speed_previous2 = 0
goto atv_motion_monitor_wait


rammable_shatter_setup_all:

local.index = 1


rammable_shatter_setup_loop:

parm.ram_shatter_index = local.index
thread rammable_shatter_thread

local.index += 1
local.index iflessequal level.rammable_shatter_count goto rammable_shatter_setup_loop

end


rammable_shatter_thread:

// Copy the shared parameter before this thread pauses.
local.index = parm.ram_shatter_index

local.body string "$box"
local.body appendint local.index
local.body append "_body"

local.break_target string "$box"
local.break_target appendint local.index
local.break_target append "_explode"

// The script cannot read an arbitrary sound property from a script object.
// Select the three authored material sounds here and play them from the body.
local.break_sound string "impact/crates/crate.wav"
local.index iflessequal 5 goto rammable_shatter_sound_cardboard
local.index ifequal 6 goto rammable_shatter_sound_crate
goto rammable_shatter_sound_selected


rammable_shatter_sound_cardboard:

local.break_sound string "impact/crates/crate5.wav"
goto rammable_shatter_sound_selected


rammable_shatter_sound_crate:

local.break_sound string "impact/crates/crate6.wav"


rammable_shatter_sound_selected:

// The body's target property contains the required ATV speed.
local.required_speed gettarget local.body
local.required_speed ifstrequal "" local.required_speed = 250

// Use this object's origin brush as its contact point. A vehicle probe must
// come within this three-dimensional distance of that point.
local.probe_target getorigin local.body
local.probe_range = 48

// These offsets match the authored points on both ATVs. The regular ATV's
// side points differ by only one unit, which is below the contact tolerance.
local.probe_front_1_forward = 59
local.probe_front_1_side = -15
local.probe_front_2_forward = 59
local.probe_front_2_side = 13
local.probe_back_1_forward = -65
local.probe_back_1_side = -15
local.probe_back_2_forward = -65
local.probe_back_2_side = 13
local.probe_wake_range = 384

// The intact body blocks the player and shots, but shots cannot break it.
local.body nodamage
local.body setdamage 0


rammable_shatter_wait:

// Do no object-distance work while the player is on foot. While mounted, use
// a slow coarse check until this object is close enough for frame probes.
wait 0.1
level.player_in_vehicle ifequal 0 goto rammable_shatter_wait


rammable_shatter_probe_check:

level.player_in_vehicle ifequal 0 goto rammable_shatter_wait
local.active_atv string level.active_atv
local.current_atv_origin getorigin local.active_atv

// Return to the slow coarse check after the ATV leaves this object.
local.wake_offset vector local.current_atv_origin
local.wake_offset vector_subtract local.probe_target
local.wake_distance vector_length local.wake_offset
local.wake_distance ifgreater local.probe_wake_range goto rammable_shatter_wait

local.current_atv_speed = level.atv_speed
local.current_atv_direction vector level.atv_direction
goto rammable_shatter_probe_active


rammable_shatter_probe_wait:

wait game.FRAMETIME
level.player_in_vehicle ifequal 0 goto rammable_shatter_wait
goto rammable_shatter_probe_check


rammable_shatter_probe_active:

// Rebuild the authored probe layout around the moving ATV. Use its travel
// direction as the forward axis, so the same points work while reversing.
local.current_probe_side vector_cross local.current_atv_direction "(0 0 1)"
local.current_probe_side vector_normalize

local.current_probe_vertical vector "(0 0 1)"
local.current_probe_vertical vector_scale level.atv_probe_up

// Use the closest of the two front and two rear probes. This makes contact
// independent of the player's collision box.
local.closest_probe_distance = 999999

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_front_1_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_front_1_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_front_2_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_front_2_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_back_1_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_back_1_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_back_2_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_back_2_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.closest_probe_distance ifgreater local.probe_range goto rammable_shatter_probe_wait
local.current_atv_speed ifless local.required_speed goto rammable_shatter_too_slow

// The object can break only once.
local.body notsolid

// Shatter the full body, then remove its original brush geometry.
// "(0 0 0)": Debris direction. Zero gives no directional bias.
// 1: Launch power. This is not a distance.
// 2: Minimum fragment size.
// 3: Maximum fragment size.
// 4: Amount to shatter. 1 means 100%, and 0.5 means 50%.
// 5: Fragment thickness.
local.body playsound local.break_sound 1
local.body shatter "(0 0 0)" 100 24 48 0.5 16
local.body remove

// Map entities with this targetname can add smoke, sound, or other effects.
trigger local.break_target

end


rammable_shatter_too_slow:

// Ignore another probe contact until the ATV retreats and approaches again.
local.failed_origin vector local.current_atv_origin
local.failed_direction vector local.current_atv_direction

thread rammable_too_slow_dialog


rammable_shatter_retry_wait:

wait game.FRAMETIME

// Rearm if the player leaves the ATV.
level.player_in_vehicle ifequal 0 goto rammable_shatter_wait

// First require a 64-unit retreat from the rejected impact.
local.active_atv string level.active_atv
local.retry_origin getorigin local.active_atv
local.retry_offset vector local.retry_origin
local.retry_offset vector_subtract local.failed_origin
local.retry_offset vector_setz 0
local.retry_range vector_length local.retry_offset
local.retry_range ifgreater local.probe_wake_range goto rammable_shatter_wait
local.retry_distance vector_dot local.retry_offset local.failed_direction
local.retry_distance ifgreater -64 goto rammable_shatter_retry_wait

// Wait for the ATV to approach again in the original impact direction.
rammable_shatter_retry_approach_wait:

wait game.FRAMETIME
level.player_in_vehicle ifequal 0 goto rammable_shatter_wait

local.active_atv string level.active_atv
local.retry_origin getorigin local.active_atv
local.retry_offset vector local.retry_origin
local.retry_offset vector_subtract local.failed_origin
local.retry_offset vector_setz 0
local.retry_range vector_length local.retry_offset
local.retry_range ifgreater local.probe_wake_range goto rammable_shatter_wait

local.retry_speed = level.atv_speed
local.retry_speed ifless 50 goto rammable_shatter_retry_approach_wait

local.retry_direction_dot vector_dot level.atv_direction local.failed_direction
local.retry_direction_dot ifless 0.5 goto rammable_shatter_retry_approach_wait

goto rammable_shatter_probe_check


rammable_hydrant1_wake:

level.ram_hydrant1_broken ifequal 1 end
level.ram_hydrant1_active ifequal 1 end
level.player_in_vehicle ifequal 0 end
level.ram_hydrant1_active = 1

local.hydrant_index = 1
local.body string "$ram_hydrant1"
local.ram_trigger string "$ram_hydrant1_trigger"
local.break_target string "$hydrantspray1"
goto rammable_hydrant_monitor_start


rammable_hydrant2_wake:

level.ram_hydrant2_broken ifequal 1 end
level.ram_hydrant2_active ifequal 1 end
level.player_in_vehicle ifequal 0 end
level.ram_hydrant2_active = 1

local.hydrant_index = 2
local.body string "$ram_hydrant2"
local.ram_trigger string "$ram_hydrant2_trigger"
local.break_target string "$hydrantspray2"


rammable_hydrant_monitor_start:

local.required_speed = 250
local.probe_range = 48
local.probe_wake_range = 384
local.probe_target getorigin local.body
local.active_atv string level.active_atv


rammable_hydrant_probe_check:

local.current_atv_origin getorigin local.active_atv

local.wake_offset vector local.current_atv_origin
local.wake_offset vector_subtract local.probe_target
local.wake_distance vector_length local.wake_offset
local.wake_distance ifgreater local.probe_wake_range goto rammable_hydrant_monitor_stop

local.current_atv_speed = level.atv_speed
local.current_atv_direction vector level.atv_direction
goto rammable_hydrant_probe_active


rammable_hydrant_probe_wait:

wait game.FRAMETIME
level.player_in_vehicle ifequal 0 goto rammable_hydrant_monitor_stop
goto rammable_hydrant_probe_check


rammable_hydrant_probe_active:

// Rebuild the same four contact probes used by the numbered rammable objects.
local.current_probe_side vector_cross local.current_atv_direction "(0 0 1)"
local.current_probe_side vector_normalize
local.current_probe_vertical vector "(0 0 1)"
local.current_probe_vertical vector_scale level.atv_probe_up
local.closest_probe_distance = 999999

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale 59
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale -15
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale 59
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale 13
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale -65
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale -15
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale -65
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale 13
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_target
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.closest_probe_distance ifgreater local.probe_range goto rammable_hydrant_probe_wait
local.current_atv_speed ifless local.required_speed goto rammable_hydrant_probe_wait

// Stop this wake trigger before the model runs its normal death handler.
local.ram_trigger remove
local.hydrant_index ifequal 1 level.ram_hydrant1_broken = 1
local.hydrant_index ifequal 2 level.ram_hydrant2_broken = 1
local.hydrant_index ifequal 1 level.ram_hydrant1_active = 0
local.hydrant_index ifequal 2 level.ram_hydrant2_active = 0

// Start every authored impact effect directly. The hydrant has no map target,
// so its death cannot toggle these effects off again.
trigger local.break_target

// Use the model's normal death handler for the break effect.
local.body takedamage
local.body kill
end


rammable_hydrant_monitor_stop:

local.hydrant_index ifequal 1 level.ram_hydrant1_active = 0
local.hydrant_index ifequal 2 level.ram_hydrant2_active = 0
end


rammable_pair_thread:

// Copy the shared parameters before this thread pauses.
local.ram_trigger string parm.ram_trigger
local.ram_break_target string parm.ram_break_target
local.ram_scare_group string parm.ram_scare_group
local.piece1 string parm.ram_piece1
local.piece2 string parm.ram_piece2
local.piece1_height = parm.ram_piece1_height
local.piece2_height = parm.ram_piece2_height
local.piece1_stage1_move vector parm.ram_piece1_stage1_move
local.piece2_stage1_move vector parm.ram_piece2_stage1_move
local.piece1_rotate vector parm.ram_piece1_rotate
local.piece2_rotate vector parm.ram_piece2_rotate
local.piece1_stage2_move vector parm.ram_piece1_stage2_move
local.piece2_stage2_move vector parm.ram_piece2_stage2_move
local.probe_range = parm.ram_probe_range
local.probe_wake_range = 384
local.ram_required_speed = parm.ram_required_speed
local.ram_min_forward_distance = parm.ram_min_forward_distance
local.ram_max_forward_distance = parm.ram_max_forward_distance

// Use a large internal maximum when the optional profile maximum is disabled.
local.ram_effective_max_forward_distance = local.ram_max_forward_distance
local.ram_effective_max_forward_distance iflessequal 0 local.ram_effective_max_forward_distance = 999999
local.ram_effective_min_forward_distance = local.ram_min_forward_distance
local.ram_effective_min_forward_distance ifgreater local.ram_effective_max_forward_distance local.ram_effective_min_forward_distance = local.ram_effective_max_forward_distance
local.ram_sound string parm.ram_sound
local.ram_sound_volume = parm.ram_sound_volume
local.piece1_origin getorigin local.piece1
local.piece2_origin getorigin local.piece2

// Use the same four ATV contact points as the rammable debris objects.
// Gate and door pieces are wider and less regular, so use the profile radius.
local.probe_front_1_forward = 59
local.probe_front_1_side = -15
local.probe_front_2_forward = 59
local.probe_front_2_side = 13
local.probe_back_1_forward = -65
local.probe_back_1_side = -15
local.probe_back_2_forward = -65
local.probe_back_2_side = 13

// Treat the line between the two piece origins as the contact surface. This
// lets either side of a wide gate or double door accept the nearest ATV point.
local.probe_axis vector local.piece2_origin
local.probe_axis vector_subtract local.piece1_origin
local.probe_axis vector_setz 0
local.probe_axis_length vector_length local.probe_axis
local.probe_axis vector_normalize

// Movement vectors use (forward, side, up) for stage 1.
local.piece1_stage1_forward vector_x local.piece1_stage1_move
local.piece1_stage1_side vector_y local.piece1_stage1_move
local.piece1_stage1_up vector_z local.piece1_stage1_move
local.piece2_stage1_forward vector_x local.piece2_stage1_move
local.piece2_stage1_side vector_y local.piece2_stage1_move
local.piece2_stage1_up vector_z local.piece2_stage1_move

// Stage 2 movement uses (forward rate, side rate, landing adjustment).
local.piece1_stage2_forward vector_x local.piece1_stage2_move
local.piece1_stage2_side vector_y local.piece1_stage2_move
local.piece1_landing_adjust vector_z local.piece1_stage2_move
local.piece2_stage2_forward vector_x local.piece2_stage2_move
local.piece2_stage2_side vector_y local.piece2_stage2_move
local.piece2_landing_adjust vector_z local.piece2_stage2_move

// Use one ninth of the total rotation in stage 1 and the rest in stage 2.
// This retains the gate's existing 1:8 rotation split.
local.piece1_rotate_x vector_x local.piece1_rotate
local.piece1_rotate_y vector_y local.piece1_rotate
local.piece1_rotate_z vector_z local.piece1_rotate
local.piece2_rotate_x vector_x local.piece2_rotate
local.piece2_rotate_y vector_y local.piece2_rotate
local.piece2_rotate_z vector_z local.piece2_rotate

local.piece1_stage1_rotate_x = local.piece1_rotate_x
local.piece1_stage1_rotate_y = local.piece1_rotate_y
local.piece1_stage1_rotate_z = local.piece1_rotate_z
local.piece2_stage1_rotate_x = local.piece2_rotate_x
local.piece2_stage1_rotate_y = local.piece2_rotate_y
local.piece2_stage1_rotate_z = local.piece2_rotate_z
local.piece1_stage1_rotate_x /= 9
local.piece1_stage1_rotate_y /= 9
local.piece1_stage1_rotate_z /= 9
local.piece2_stage1_rotate_x /= 9
local.piece2_stage1_rotate_y /= 9
local.piece2_stage1_rotate_z /= 9

local.piece1_stage2_rotate_x = local.piece1_rotate_x
local.piece1_stage2_rotate_y = local.piece1_rotate_y
local.piece1_stage2_rotate_z = local.piece1_rotate_z
local.piece2_stage2_rotate_x = local.piece2_rotate_x
local.piece2_stage2_rotate_y = local.piece2_rotate_y
local.piece2_stage2_rotate_z = local.piece2_rotate_z
local.piece1_stage2_rotate_x -= local.piece1_stage1_rotate_x
local.piece1_stage2_rotate_y -= local.piece1_stage1_rotate_y
local.piece1_stage2_rotate_z -= local.piece1_stage1_rotate_z
local.piece2_stage2_rotate_x -= local.piece2_stage1_rotate_x
local.piece2_stage2_rotate_y -= local.piece2_stage1_rotate_y
local.piece2_stage2_rotate_z -= local.piece2_stage1_rotate_z

// Keep the physical halves moving away from each other, independent of impact direction.
local.side vector local.piece1_origin
local.side vector_subtract local.piece2_origin
local.side vector_setz 0
local.side vector_normalize


rammable_pair_loop:

// Shots still collide with the gate, but cannot activate it.
local.piece1 nodamage
local.piece2 nodamage

// Moving gate pieces must not cause block damage.
local.piece1 setdamage 0
local.piece2 setdamage 0

local.piece1 ontrigger rammable_pair_check
local.piece2 ontrigger rammable_pair_check
pause


rammable_pair_check:

// A trigger target starts this bounded contact check. The pair breaks only
// when one ATV contact point reaches the line between the two piece origins.
// Disable both piece handlers while this instance checks the nearby ATV.
local.piece1 notrigger
local.piece2 notrigger
level.player_in_vehicle ifequal 0 goto rammable_pair_loop
goto rammable_pair_probe_check


rammable_pair_probe_wait:

wait game.FRAMETIME
level.player_in_vehicle ifequal 0 goto rammable_pair_loop


rammable_pair_probe_check:

local.active_atv string level.active_atv
local.current_atv_origin getorigin local.active_atv
local.current_atv_direction vector level.atv_direction
local.current_probe_side vector_cross local.current_atv_direction "(0 0 1)"
local.current_probe_side vector_normalize
local.current_probe_vertical vector "(0 0 1)"
local.current_probe_vertical vector_scale level.atv_probe_up

local.closest_probe_distance = 999999

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_front_1_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_front_1_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.piece1_origin
local.probe_offset vector_setz 0
local.probe_along vector_dot local.probe_offset local.probe_axis
local.probe_along ifless 0 local.probe_along = 0
local.probe_along ifgreater local.probe_axis_length local.probe_along = local.probe_axis_length
local.probe_closest vector local.probe_axis
local.probe_closest vector_scale local.probe_along
local.probe_closest vector_add local.piece1_origin
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_closest
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_front_2_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_front_2_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.piece1_origin
local.probe_offset vector_setz 0
local.probe_along vector_dot local.probe_offset local.probe_axis
local.probe_along ifless 0 local.probe_along = 0
local.probe_along ifgreater local.probe_axis_length local.probe_along = local.probe_axis_length
local.probe_closest vector local.probe_axis
local.probe_closest vector_scale local.probe_along
local.probe_closest vector_add local.piece1_origin
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_closest
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_back_1_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_back_1_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.piece1_origin
local.probe_offset vector_setz 0
local.probe_along vector_dot local.probe_offset local.probe_axis
local.probe_along ifless 0 local.probe_along = 0
local.probe_along ifgreater local.probe_axis_length local.probe_along = local.probe_axis_length
local.probe_closest vector local.probe_axis
local.probe_closest vector_scale local.probe_along
local.probe_closest vector_add local.piece1_origin
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_closest
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

local.probe_position vector local.current_atv_origin
local.probe_component vector local.current_atv_direction
local.probe_component vector_scale local.probe_back_2_forward
local.probe_position vector_add local.probe_component
local.probe_component vector local.current_probe_side
local.probe_component vector_scale local.probe_back_2_side
local.probe_position vector_add local.probe_component
local.probe_position vector_add local.current_probe_vertical
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.piece1_origin
local.probe_offset vector_setz 0
local.probe_along vector_dot local.probe_offset local.probe_axis
local.probe_along ifless 0 local.probe_along = 0
local.probe_along ifgreater local.probe_axis_length local.probe_along = local.probe_axis_length
local.probe_closest vector local.probe_axis
local.probe_closest vector_scale local.probe_along
local.probe_closest vector_add local.piece1_origin
local.probe_offset vector local.probe_position
local.probe_offset vector_subtract local.probe_closest
local.probe_distance vector_length local.probe_offset
local.probe_distance ifless local.closest_probe_distance local.closest_probe_distance = local.probe_distance

// Stop the per-frame check after the ATV leaves this object's wake zone.
local.closest_probe_distance ifgreater local.probe_wake_range goto rammable_pair_loop
local.closest_probe_distance ifgreater local.probe_range goto rammable_pair_probe_wait
level.atv_speed ifless local.ram_required_speed goto rammable_pair_too_slow

local.ram_trigger remove
local.piece1 notrigger
local.piece2 notrigger

// Copy the monitored values before the monitor updates them again.
local.impact_speed = level.atv_speed
local.forward vector level.atv_direction

// Remove collision before the ATV reaches the gate.
local.piece1 notsolid
local.piece2 notsolid

// Activate the optional map target when this pair breaks.
local.ram_break_target ifstrnotequal "" trigger local.ram_break_target

// The office entry doors have the only pair that uses this break target.
// Turn off their nearby flickering light after the doors break.
local.ram_break_target ifstrequal "$ram_doorenter_break" thread ram_doorenter_light_off

// Some rammables must frighten their nearby authored civilian group even if
// BSP area connectivity prevents the normal AI sound event from reaching it.
local.ram_scare_group ifstrequal "parking_garage" thread scare_parking_garage_neutrals
local.ram_scare_group ifstrequal "office" thread scare_office_neutrals

// Play the profile's impact sound.
local.piece1 playsound local.ram_sound local.ram_sound_volume

// Map the profile's required-speed-to-750 range to a 0-1 scale.
local.launch_scale = local.impact_speed
local.launch_scale -= local.ram_required_speed
local.launch_speed_range = 750
local.launch_speed_range -= local.ram_required_speed
local.launch_speed_range ifless 1 local.launch_speed_range = 1
local.launch_scale /= local.launch_speed_range
local.launch_scale ifless 0 local.launch_scale = 0
local.launch_scale ifgreater 1 local.launch_scale = 1
local.launch_timescale = local.launch_scale
local.launch_timescale /= 8.0

// Temporarily cap the ATV speed after it breaks the gate.
local.slow_speed = local.impact_speed
local.slow_speed -= 500
local.slow_speed ifless 50 local.slow_speed = 50
local.slow_speed ifgreater 750 local.slow_speed = 750
local.active_atv vehiclespeed local.slow_speed

// Use a unit vector for the vertical movement offsets.
local.vertical vector "(0 0 1)"


// Calculate piece 1's full rise offsets. Stage 1 cannot exceed the optional maximum.
local.piece1_stage1_forward_distance = local.piece1_stage1_forward
local.piece1_stage1_forward_distance *= local.launch_scale
local.piece1_stage1_forward_distance ifgreater local.ram_effective_max_forward_distance local.piece1_stage1_forward_distance = local.ram_effective_max_forward_distance
local.piece1_offset_forward vector local.forward
local.piece1_offset_forward vector_scale local.piece1_stage1_forward_distance
local.piece1_offset_side vector local.side
local.piece1_offset_side vector_scale local.piece1_stage1_side
local.piece1_offset_side vector_scale local.launch_scale
local.piece1_offset_vertical vector local.vertical
local.piece1_offset_vertical vector_scale local.piece1_stage1_up
local.piece1_offset_vertical vector_scale local.launch_scale

// Calculate piece 2's full rise offsets. Stage 1 cannot exceed the optional maximum.
local.piece2_stage1_forward_distance = local.piece2_stage1_forward
local.piece2_stage1_forward_distance *= local.launch_scale
local.piece2_stage1_forward_distance ifgreater local.ram_effective_max_forward_distance local.piece2_stage1_forward_distance = local.ram_effective_max_forward_distance
local.piece2_offset_forward vector local.forward
local.piece2_offset_forward vector_scale local.piece2_stage1_forward_distance
local.piece2_offset_side vector local.side
local.piece2_offset_side vector_scale local.piece2_stage1_side
local.piece2_offset_side vector_scale local.launch_scale
local.piece2_offset_vertical vector local.vertical
local.piece2_offset_vertical vector_scale local.piece2_stage1_up
local.piece2_offset_vertical vector_scale local.launch_scale

// Stage 1 moves forward, sideways, and up.
local.piece1_destination vector local.piece1_origin
local.piece1_destination vector_add local.piece1_offset_forward
local.piece1_destination vector_add local.piece1_offset_side
local.piece1_destination vector_add local.piece1_offset_vertical

local.piece2_destination vector local.piece2_origin
local.piece2_destination vector_add local.piece2_offset_forward
local.piece2_destination vector_add local.piece2_offset_side
local.piece2_destination vector_add local.piece2_offset_vertical

// Scaling distance and time together keeps the stage 1 movement rate constant.
local.piece1 time local.launch_timescale
local.piece2 time local.launch_timescale
local.piece1 moveto local.piece1_destination
local.piece2 moveto local.piece2_destination

// Spin pieces
local.piece1 rotateXup local.piece1_stage1_rotate_x
local.piece1 rotateYup local.piece1_stage1_rotate_y
local.piece1 rotateZup local.piece1_stage1_rotate_z
local.piece2 rotateXup local.piece2_stage1_rotate_x
local.piece2 rotateYup local.piece2_stage1_rotate_y
local.piece2 rotateZup local.piece2_stage1_rotate_z

waitFor local.piece1
// Let piece 2 finish stage 1 before either piece receives new movement orders.
wait game.FRAMETIME

// Stage 2 adds the rise time to its 0.3-second base time.
local.stage2_time = local.launch_timescale
local.stage2_time += 0.3

// Scale stage 2 forward travel by the impact speed.
local.piece1_stage2_forward_distance = local.piece1_stage2_forward
local.piece1_stage2_forward_distance *= local.stage2_time
local.piece1_stage2_forward_distance *= local.launch_scale
local.piece1_forward_distance = local.piece1_stage1_forward_distance
local.piece1_forward_distance += local.piece1_stage2_forward_distance

// Add the minimum shortfall, then cap stage 2 to the distance left below the maximum.
local.piece1_forward_shortfall = local.ram_effective_min_forward_distance
local.piece1_forward_shortfall -= local.piece1_forward_distance
local.piece1_forward_shortfall ifless 0 local.piece1_forward_shortfall = 0
local.piece1_stage2_forward_distance += local.piece1_forward_shortfall
local.piece1_forward_remaining = local.ram_effective_max_forward_distance
local.piece1_forward_remaining -= local.piece1_stage1_forward_distance
local.piece1_forward_remaining ifless 0 local.piece1_forward_remaining = 0
local.piece1_stage2_forward_distance ifgreater local.piece1_forward_remaining local.piece1_stage2_forward_distance = local.piece1_forward_remaining
local.piece1_step_forward vector local.forward
local.piece1_step_forward vector_scale local.piece1_stage2_forward_distance
local.piece1_step_side vector local.side
local.piece1_step_side vector_scale local.piece1_stage2_side
local.piece1_step_side vector_scale local.stage2_time
local.piece1_step_side vector_scale local.launch_scale

// Fall through the stage 1 rise and the adjusted piece height.
local.piece1_step_down vector local.vertical
local.piece1_height_adjusted = local.piece1_height
local.piece1_height_adjusted -= local.piece1_landing_adjust
local.piece1_step_down vector_scale local.piece1_height_adjusted
local.piece1_step_down vector_add local.piece1_offset_vertical
local.piece1_step_down vector_scale -1
local.piece1_destination vector_add local.piece1_step_forward
local.piece1_destination vector_add local.piece1_step_side
local.piece1_destination vector_add local.piece1_step_down

local.piece2_stage2_forward_distance = local.piece2_stage2_forward
local.piece2_stage2_forward_distance *= local.stage2_time
local.piece2_stage2_forward_distance *= local.launch_scale
local.piece2_forward_distance = local.piece2_stage1_forward_distance
local.piece2_forward_distance += local.piece2_stage2_forward_distance
local.piece2_forward_shortfall = local.ram_effective_min_forward_distance
local.piece2_forward_shortfall -= local.piece2_forward_distance
local.piece2_forward_shortfall ifless 0 local.piece2_forward_shortfall = 0
local.piece2_stage2_forward_distance += local.piece2_forward_shortfall
local.piece2_forward_remaining = local.ram_effective_max_forward_distance
local.piece2_forward_remaining -= local.piece2_stage1_forward_distance
local.piece2_forward_remaining ifless 0 local.piece2_forward_remaining = 0
local.piece2_stage2_forward_distance ifgreater local.piece2_forward_remaining local.piece2_stage2_forward_distance = local.piece2_forward_remaining
local.piece2_step_forward vector local.forward
local.piece2_step_forward vector_scale local.piece2_stage2_forward_distance
local.piece2_step_side vector local.side
local.piece2_step_side vector_scale local.piece2_stage2_side
local.piece2_step_side vector_scale local.stage2_time
local.piece2_step_side vector_scale local.launch_scale
local.piece2_step_down vector local.vertical
local.piece2_height_adjusted = local.piece2_height
local.piece2_height_adjusted -= local.piece2_landing_adjust
local.piece2_step_down vector_scale local.piece2_height_adjusted
local.piece2_step_down vector_add local.piece2_offset_vertical
local.piece2_step_down vector_scale -1
local.piece2_destination vector_add local.piece2_step_forward
local.piece2_destination vector_add local.piece2_step_side
local.piece2_destination vector_add local.piece2_step_down

local.piece1 time local.stage2_time
local.piece2 time local.stage2_time
local.piece1 moveto local.piece1_destination
local.piece2 moveto local.piece2_destination

// Spin pieces
local.piece1 rotateXup local.piece1_stage2_rotate_x
local.piece1 rotateYup local.piece1_stage2_rotate_y
local.piece1 rotateZup local.piece1_stage2_rotate_z
local.piece2 rotateXup local.piece2_stage2_rotate_x
local.piece2 rotateYup local.piece2_stage2_rotate_y
local.piece2 rotateZup local.piece2_stage2_rotate_z

waitFor local.piece1
wait game.FRAMETIME
local.active_atv vehiclespeed 750
local.piece1 notsolid
local.piece2 notsolid

end


rammable_pair_too_slow:

// Stop the repeatable map trigger from starting the rejection again every 0.1 seconds.
local.piece1 notrigger
local.piece2 notrigger

local.failed_origin getorigin local.active_atv
local.failed_direction vector level.atv_direction

thread rammable_too_slow_dialog


rammable_pair_retry_wait:

wait game.FRAMETIME

// Rearm if the player leaves the ATV.
level.player_in_vehicle ifequal 0 goto rammable_pair_loop

// First require a 64-unit retreat from the rejected impact.
local.retry_offset getorigin local.active_atv
local.retry_offset vector_subtract local.failed_origin
local.retry_offset vector_setz 0
local.retry_range vector_length local.retry_offset
local.retry_range ifgreater local.probe_wake_range goto rammable_pair_loop
local.retry_distance vector_dot local.retry_offset local.failed_direction
local.retry_distance ifgreater -64 goto rammable_pair_retry_wait

// Keep the pair disabled until the next approach. This prevents a fast retreat
// inside the trigger volume from breaking the object in the wrong direction.
rammable_pair_retry_approach_wait:

wait game.FRAMETIME
level.player_in_vehicle ifequal 0 goto rammable_pair_loop

local.retry_offset getorigin local.active_atv
local.retry_offset vector_subtract local.failed_origin
local.retry_offset vector_setz 0
local.retry_range vector_length local.retry_offset
local.retry_range ifgreater local.probe_wake_range goto rammable_pair_loop
level.atv_speed ifless 50 goto rammable_pair_retry_approach_wait

local.retry_direction_dot vector_dot level.atv_direction local.failed_direction
local.retry_direction_dot ifless 0.5 goto rammable_pair_retry_approach_wait

goto rammable_pair_loop


rammable_too_slow_dialog:

// Prevent adjacent rammable items from starting this line together.
level.ram_too_slow_dialog_active ifequal 1 goto rammable_too_slow_dialog_done
level.ram_too_slow_dialog_active = 1

dialog "i_jc" "m_faster" "dialog/gorge/jc/Gofast.wav"
waitForSound "dialog/gorge/jc/Gofast.wav" 0.2

level.ram_too_slow_dialog_active = 0


rammable_too_slow_dialog_done:

end


rammable_door_use_dialog:

// This hint is only for a player who tries to use an intact door on foot.
level.player_in_vehicle ifequal 1 goto rammable_door_use_dialog_done
level.ram_door_use_dialog_active ifequal 1 goto rammable_door_use_dialog_done
level.ram_door_use_dialog_active = 1

level.ram_door_use_dialog_first ifequal 0 goto rammable_door_use_dialog_jc
level.ram_door_use_dialog_first = 0
dialog "i_blade" "m_jc_how_do_1" "dialog/abandoned/blade/gtt4.wav"
waitForSound "dialog/abandoned/blade/gtt4.wav" 0.1


rammable_door_use_dialog_jc:

dialog "i_jc" "m_what_do_you_2" "dialog/gorge/jc/Gogogo.wav"
waitForSound "dialog/gorge/jc/Gogogo.wav" 0.2

level.ram_door_use_dialog_active = 0


rammable_door_use_dialog_done:

end


rocketcar_launcher_setup:

// The stock launcher brushes only supply an origin for each straight rocket.
$rocketcar1_launcher hide
$rocketcar1_launcher notsolid
$rocketcar2_launcher hide
$rocketcar2_launcher notsolid
$rocketcar3_launcher hide
$rocketcar3_launcher notsolid
$rocketcar4_launcher hide
$rocketcar4_launcher notsolid

// The visible cars do not handle collision. Solid script objects around the
// cars block the ATV, bullets, and the scripted rockets until impact.
$rocketcar1_target notsolid
$rocketcar2_target notsolid
$rocketcar3_target notsolid
$rocketcar4_target notsolid

$rocketcar1_blocker nodamage
$rocketcar2_blocker nodamage
$rocketcar3_blocker nodamage
$rocketcar4_blocker nodamage

end


rocketcar1_sequence:

local.turret string "$rocketcar1"
local.car string "$rocketcar1_target"
local.blocker string "$rocketcar1_blocker"
local.launcher string "$rocketcar1_launcher"
local.shake string "$rocketcar1_shake"
local.impact_wait = 2.29
local.extra_shatter = 1
goto rocketcar_sequence_fire


rocketcar2_sequence:

local.turret string "$rocketcar2"
local.car string "$rocketcar2_target"
local.blocker string "$rocketcar2_blocker"
local.launcher string "$rocketcar2_launcher"
local.shake string "$rocketcar2_shake"
local.impact_wait = 2.06
local.extra_shatter = 0
goto rocketcar_sequence_fire


rocketcar3_sequence:

local.turret string "$rocketcar3"
local.car string "$rocketcar3_target"
local.blocker string "$rocketcar3_blocker"
local.launcher string "$rocketcar3_launcher"
local.shake string "$rocketcar3_shake"
local.impact_wait = 1.28
local.extra_shatter = 1
goto rocketcar_sequence_fire


rocketcar4_sequence:

local.turret string "$rocketcar4"
local.car string "$rocketcar4_target"
local.blocker string "$rocketcar4_blocker"
local.launcher string "$rocketcar4_launcher"
local.shake string "$rocketcar4_shake"
local.impact_wait = 1.15
local.extra_shatter = 0
goto rocketcar_sequence_fire


rocketcar_sequence_fire:

// Aim at the matching car. A long lag prevents the normal seek loop from
// firing an extra rocket before this thread requests its one shot.
local.turret lagtime 999
local.turret raise local.car
wait 2.0

local.launcher launch Rocket

// At the calibrated impact time, remove the collision blocker and use the
// object's normal death handler. It creates the model's standard debris.
wait local.impact_wait
local.blocker remove

// Keep the timing from the working two-shatter test, but let the original
// vehicle's native die_shatter event create all debris.
local.extra_shatter ifequal 1 wait 0.1
local.extra_shatter ifequal 1 wait 0.1

local.car takedamage
local.car health 1
local.car hurt 1000
trigger local.shake

// Lower the visible turret after the one scripted shot.
local.turret deactivate

end


ram_doorexit_hurt_thread:
$ram_doorexit_hurt setdamage 120
wait 0.5
$ram_doorexit_hurt remove

end


ram_doorenter_light_off:

server lightstyle 168 "a"

end


//---------------------------------------------------------------------------
// Three-second door button
//---------------------------------------------------------------------------

kp_door_inside_unlock:

// Let normal door use open the door from the secret-office side.
$kp_door unlock
end


kp_door_open:

// Match func_rotatingdoor: swing away from the player by 90 degrees.
local.kp_door_endangles vector local.startangles
local.opendot ifgreater 0 goto kp_door_open_clockwise

kp_door_open_counterclockwise:
local.kp_door_endangles vector_add "(0 90 0)"
goto kp_door_open_move

kp_door_open_clockwise:
local.kp_door_endangles vector_subtract "(0 90 0)"

kp_door_open_move:

// Lock now. The existing open movement continues while the door is locked.
local.self lock
local.self time 1
local.self rotateto local.kp_door_endangles
waitFor local.self
local.self dooropened
end


kp_door_close:

local.self time 1
local.self rotateto local.startangles
waitFor local.self
local.self doorclosed
end


kp_door_buzzer_thread:

// The door starts locked.
$kp_door lock

// Wait for the player to use the button.
$kp_door_buzzer onuse kp_door_buzzer_pressed
pause


kp_door_buzzer_pressed:

// Prevent a second press while this sequence runs.
$kp_door_buzzer nouse

// Unlock the door
$kp_door unlock

// Depress the button by 0.5 units.
$kp_door_buzzer time 0.1
$kp_door_buzzer moveForward 0.5
waitFor $kp_door_buzzer

// Unlock the door and start the buzzer.
$kp_door_buzzer_sfx playsound "environment/amb_machine/power1.wav" 1.0 4 2 0.9

// Keep the door unlocked for three seconds.
wait 3

// Stop the buzzer
$kp_door_buzzer_sfx stopsound 4

// and lock the door again.
$kp_door lock

// Return the button to its original position.
$kp_door_buzzer time 0.1
$kp_door_buzzer moveBackward 0.5
waitFor $kp_door_buzzer

// Enable the button again.
goto kp_door_buzzer_thread

end

