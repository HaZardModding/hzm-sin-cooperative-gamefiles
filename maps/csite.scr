// New-city boundary reminder
//-----------------------------

newcity_noleave_dialog:
dialog "i_jc" "m_blade_youve_gotta_2" "dialog/subway/jc/catch.wav" 1 5
waitForSound "dialog/subway/jc/catch.wav" .2
end

