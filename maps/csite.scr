$joy_parking_garage_npc_spawner_11 remove
$joy_parking_garage_npc_11 targetname joy_spawned_parking_garage_npc
trigger $joy_parking_garage_npc_spawner_12
$joy_parking_garage_npc_spawner_12 remove
$joy_parking_garage_npc_12 targetname joy_spawned_parking_garage_npc
wait game.FRAMETIME

trigger $joy_parking_garage_npc_spawner_13
$joy_parking_garage_npc_spawner_13 remove
$joy_parking_garage_npc_13 targetname joy_spawned_parking_garage_npc
trigger $joy_parking_garage_npc_spawner_14
$joy_parking_garage_npc_spawner_14 remove
$joy_parking_garage_npc_14 targetname joy_spawned_parking_garage_npc

$end_thug1 show
$end_thug2 show
$end_thug3 show
$mancini_final show
// $mancini_final ignore activate
end

spawn_officenpcs:

level.spawn_officenpcs_done ifequal 1 end
level.spawn_officenpcs_done = 1
$spawn_officenpcs remove

level.spawn_newcitynpcs_done ifequal 0 goto spawn_officenpcs_after_newcity_cleanup
$joy_new_city_npc_01 remove
$joy_new_city_npc_02 remove
$joy_new_city_npc_03 remove
$joy_new_city_npc_04 remove
$joy_new_city_npc_05 remove
$joy_new_city_npc_06 remove
$joy_new_city_npc_07 remove
$joy_new_city_npc_08 remove
$joy_new_city_npc_11 remove
$joy_new_city_npc_12 remove
$joy_new_city_npc_16 remove
$joy_new_city_npc_17 remove
$joy_new_city_npc_18 remove
$joy_new_city_npc_19 remove
$joy_parking_garage_npc_15 remove
$joy_parking_garage_npc_16 remove

spawn_officenpcs_after_newcity_cleanup:

trigger $joy_office_npc_spawner_01
$joy_office_npc_spawner_01 remove
trigger $joy_office_npc_spawner_02
$joy_office_npc_02 script global/cinematic.scr
$joy_office_npc_02 anim idle1
$joy_office_npc_spawner_02 remove
trigger $joy_office_npc_spawner_03
$joy_office_npc_spawner_03 remove
trigger $joy_office_npc_spawner_04
$joy_office_npc_spawner_04 remove
wait game.FRAMETIME

trigger $joy_office_npc_spawner_05
$joy_office_npc_spawner_05 remove
trigger $joy_office_npc_spawner_06
$joy_office_npc_06 script global/cinematic.scr
$joy_office_npc_06 anim idle1
$joy_office_npc_spawner_06 remove

// Wait until the actors have run their model-defined initialization scripts.
wait game.FRAMETIME

$joy_office_npc_01 definestate opendoor global/baseai.scr::opendoor
$joy_office_npc_01 definestate sightenemy office_escape_scared
$joy_office_npc_01 definestate default_sightenemy office_escape_scared
$joy_office_npc_01 definestate weaponsound office_escape_scared
$joy_office_npc_01 definestate painsound office_escape_scared
$joy_office_npc_01 definestate deathsound office_escape_scared
$joy_office_npc_01 definestate breakingsound office_escape_scared
$joy_office_npc_01 definestate mutantsound office_escape_scared
$joy_office_npc_01 definestate pain office_escape_scared

$joy_office_npc_02 definestate opendoor global/baseai.scr::opendoor
$joy_office_npc_02 definestate sightenemy office_escape_scared
$joy_office_npc_02 definestate default_sightenemy office_escape_scared
$joy_office_npc_02 definestate weaponsound office_escape_scared
$joy_office_npc_02 definestate painsound office_escape_scared
$joy_office_npc_02 definestate deathsound office_escape_scared
$joy_office_npc_02 definestate breakingsound office_escape_scared
$joy_office_npc_02 definestate mutantsound office_escape_scared
$joy_office_npc_02 definestate pain office_escape_scared

$joy_office_npc_06 definestate opendoor global/baseai.scr::opendoor
$joy_office_npc_06 definestate sightenemy office_escape_scared
$joy_office_npc_06 definestate default_sightenemy office_escape_scared
$joy_office_npc_06 definestate weaponsound office_escape_scared
$joy_office_npc_06 definestate painsound office_escape_scared
$joy_office_npc_06 definestate deathsound office_escape_scared
$joy_office_npc_06 definestate breakingsound office_escape_scared
$joy_office_npc_06 definestate mutantsound office_escape_scared
$joy_office_npc_06 definestate pain office_escape_scared
level.office_neutrals_rammable_scared ifequal 1 $joy_office_npc_01 state breakingsound
level.office_neutrals_rammable_scared ifequal 1 $joy_office_npc_02 state breakingsound
level.office_neutrals_rammable_scared ifequal 1 $joy_office_npc_06 state breakingsound
end


// Flashlight stuff for WoS mode
init_flashlight:

  local.wosmode getcvar sv_wos
  local.wosmode ifequal 1 goto keep_flashlight

  level.no_flashlight = 1
  $flashylighty remove
  end

  keep_flashlight:

  level.no_flashlight = 0
  $flashylighty effects +poi

end

