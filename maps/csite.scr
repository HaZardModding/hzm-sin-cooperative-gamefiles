sinkhole_death:
$sinkhole_deathpit notrigger
*1 playsound "dialog/general/blade/fall2.wav" 1 2
wait 1
*1 playerkill
end

//---------------------------------------------------------------------------
// Alternate parking-garage exit
//---------------------------------------------------------------------------

parking_garage_exit_trigger:

level.parking_garage_exit_done ifequal 1 end
level.player_in_vehicle ifequal 0 end

level.parking_garage_exit_done = 1
$parking_garage_exit_trigger notrigger

trigger $mancini_final
trigger $end_thug1
trigger $end_thug2
trigger $end_thug3

$csite_end_triggers remove
$parking_garage_exit_trigger remove
end

//---------------------------------------------------------------------------
// New-city NPC retreat
//---------------------------------------------------------------------------

newcity_retreat_trigger:

level.newcity_retreat_started ifequal 1 end
level.newcity_retreat_started = 1
$newcity_retreat_trigger notrigger

level.newcity_retreat_delay = 0
level.newcity_retreat_lane = 0
level.newcity_retreat_player_origin getorigin *1
$newcity_retreatdoors unlock

// These actors start on upper floors with no path to the street-level exit.
// Remove them now so they do not run into walls below their retreat target.
$joy_new_city_npc_01 thread newcity_retreat_force_fade
$joy_new_city_npc_02 thread newcity_retreat_force_fade
$joy_new_city_npc_03 thread newcity_retreat_force_fade
$joy_new_city_npc_04 thread newcity_retreat_force_fade
$joy_new_city_npc_17 thread newcity_retreat_force_fade
$joy_new_city_npc_19 thread newcity_retreat_force_fade

$joy_new_city_npc_05 thread newcity_retreat_actor
$joy_new_city_npc_06 thread newcity_retreat_actor
$joy_new_city_npc_07 thread newcity_retreat_actor
$joy_new_city_npc_08 thread newcity_retreat_actor
$joy_new_city_npc_11 thread newcity_retreat_actor
$joy_new_city_npc_12 thread newcity_retreat_actor
$joy_new_city_npc_16 thread newcity_retreat_actor
$joy_new_city_npc_18 thread newcity_retreat_actor

thread newcity_retreat_timeout

$newcity_retreat_trigger remove
end


newcity_retreat_actor:

local.self clearstate
local.self ignoreall
local.self respondto pain killed opendoor

// The last new-city path node is at X 3669. Fade any new-city actor that
// crossed beyond that path coverage before the retreat began.
local.retreat_origin getorigin local.self

// Remove actors that are already too far from the player to show a useful
// retreat. This uses the player position captured when the trigger fired.
local.retreat_player_delta vector local.retreat_origin
local.retreat_player_delta vector_subtract level.newcity_retreat_player_origin
local.retreat_player_distance vector_length local.retreat_player_delta
local.retreat_player_distance ifgreater 1800 goto newcity_retreat_force_fade

local.retreat_x vector_x local.retreat_origin
local.retreat_y vector_y local.retreat_origin
local.retreat_x ifless -4096 goto newcity_retreat_force_fade
local.retreat_x ifgreater 3669 goto newcity_retreat_force_fade
local.retreat_y ifless -4096 goto newcity_retreat_force_fade
local.retreat_y ifgreaterequal 4096 goto newcity_retreat_force_fade

// Remove the prior chase and hold the actor still while its stagger delay runs.
local.self clearenemy
local.self idle "idle"

// Give each actor a separate start time so they do not form four large groups.
local.retreat_delay = level.newcity_retreat_delay
level.newcity_retreat_delay += 0.75
wait local.retreat_delay

// Use two fixed lanes. FindFlee reserves its destination, so two actors can
// block both exit nodes and leave the rest of the group without a valid node.
level.newcity_retreat_lane ifequal 0 goto newcity_retreat_actor_lane_1
level.newcity_retreat_lane = 0
goto newcity_retreat_actor_lane_2


newcity_retreat_actor_lane_1:

level.newcity_retreat_lane = 1
local.self behavior GotoPathNode "run" $newcity_retreat_1_1
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_1_mid
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_1_2
waitFor local.self
goto newcity_retreat_actor_wait_for_timeout


newcity_retreat_actor_lane_2:

local.self behavior GotoPathNode "run" $newcity_retreat_2_1
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_2_mid
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_2_2
waitFor local.self


newcity_retreat_actor_wait_for_timeout:

// The shared 20-second timeout replaces this actor thread and fades the actor.
local.self idle "idle"
pause


newcity_retreat_timeout:

// Any street-level actor that did not reach the exit fades after 20 seconds.
wait 20
$joy_new_city_npc_05 thread newcity_retreat_force_fade
$joy_new_city_npc_06 thread newcity_retreat_force_fade
$joy_new_city_npc_07 thread newcity_retreat_force_fade
$joy_new_city_npc_08 thread newcity_retreat_force_fade
$joy_new_city_npc_11 thread newcity_retreat_force_fade
$joy_new_city_npc_12 thread newcity_retreat_force_fade
$joy_new_city_npc_16 thread newcity_retreat_force_fade
$joy_new_city_npc_18 thread newcity_retreat_force_fade
end


newcity_retreat_force_fade:

local.self targetname joy_new_city_npc_fading
local.self notsolid
local.self fadeout
end

//---------------------------------------------------------------------------
// Parking-garage technician retreat
//---------------------------------------------------------------------------

scare_parking_garage_neutrals:

level.parking_garage_neutrals_rammable_scared ifequal 1 end
level.parking_garage_neutrals_rammable_scared = 1
$joy_parking_garage_npc_15 state breakingsound
$joy_parking_garage_npc_16 state breakingsound
end


scare_office_neutrals:

level.office_neutrals_rammable_scared ifequal 1 end
level.office_neutrals_rammable_scared = 1
$joy_office_npc_01 state breakingsound
$joy_office_npc_02 state breakingsound
$joy_office_npc_06 state breakingsound
end


parking_garage_npc15_cower_scared:

local.self clearstate
local.self ignoreall
// Keep death enabled, but do not let another state cancel the cower pose.
local.self respondto killed
local.self anim "hidedrop1"
waitFor local.self
local.self anim "hiding1"
pause


parking_garage_retreat_scared:

local.self clearstate
local.self ignoreall
local.self respondto opendoor

level.parking_garage_retreat_active += 1
$newcity_retreatdoors unlock

parking_garage_retreat_choose_lane:

// Separate simultaneous fear responses so the technicians do not collide.
local.retreat_delay randomint 2
wait local.retreat_delay

level.parking_garage_retreat_lane ifequal 0 goto parking_garage_retreat_lane_1
level.parking_garage_retreat_lane = 0
goto parking_garage_retreat_lane_2


parking_garage_retreat_lane_1:

level.parking_garage_retreat_lane = 1
local.self behavior GotoPathNode "run" $newcity_retreat_1_1
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_1_mid
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_1_2
waitFor local.self
goto parking_garage_retreat_finish


parking_garage_retreat_lane_2:

local.self behavior GotoPathNode "run" $newcity_retreat_2_1
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_2_mid
waitFor local.self
local.self behavior GotoPathNode "run" $newcity_retreat_2_2
waitFor local.self


parking_garage_retreat_finish:

local.self remove

level.parking_garage_retreat_active -= 1
level.parking_garage_retreat_active ifgreater 0 end
level.newcity_retreat_started ifequal 1 end
$newcity_retreatdoors lock
end

//---------------------------------------------------------------------------
// Office civilian escape
//---------------------------------------------------------------------------

office_escape_door_use:

// The door class does not expose its open or closed state to scripts.
// Suppress the locked-door response while the office escape can open it.
level.office_escape_active ifgreater 0 end
thread dialog_locked_door
end


office_escape_scared:

local.self clearstate
local.self ignoreall
local.self respondto opendoor

level.office_escape_active += 1
$office_door_escape unlock

// Stagger simultaneous fear responses so the civilians do not block one another.
local.escape_delay randomint 3
wait local.escape_delay

local.self behavior GotoPathNode "run" $office_fleepath1
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath2
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath3
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath4
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath5
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath6
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath7
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath8
waitFor local.self
local.self behavior GotoPathNode "run" $office_fleepath9
waitFor local.self
goto office_escape_finish_actor


office_escape_finish_actor:

// Match the stock hostage_roof escape sequence.
local.self remove

level.office_escape_active -= 1
level.office_escape_active ifgreater 0 end
$office_door_escape lock
end

//---------------------------------------------------------------------------
// Delayed NPC encounter spawning
//
// The source NPC layers remain visible in TrenchBroom but are excluded from
// export. These functions reproduce every gameplay key from those templates.
// Spawn in small batches to avoid one large network update.
//---------------------------------------------------------------------------

spawn_newcitynpcs:

level.spawn_newcitynpcs_done ifequal 1 end
level.spawn_newcitynpcs_done = 1
$spawn_newcitynpcs remove

trigger $joy_new_city_npc_spawner_01
$joy_new_city_npc_spawner_01 remove
trigger $joy_new_city_npc_spawner_02
$joy_new_city_npc_spawner_02 remove
trigger $joy_new_city_npc_spawner_03
$joy_new_city_npc_spawner_03 remove
trigger $joy_new_city_npc_spawner_04
$joy_new_city_npc_spawner_04 remove
wait game.FRAMETIME

trigger $joy_new_city_npc_spawner_05
$joy_new_city_npc_spawner_05 remove
$joy_new_city_npc_05 scale .95
trigger $joy_new_city_npc_spawner_06
$joy_new_city_npc_spawner_06 remove
$joy_new_city_npc_06 scale 1.02
trigger $joy_new_city_npc_spawner_07
$joy_new_city_npc_spawner_07 remove
$joy_new_city_npc_07 scale 1.0
$joy_new_city_npc_07 anim idle1
trigger $joy_new_city_npc_spawner_08
$joy_new_city_npc_spawner_08 remove
$joy_new_city_npc_08 scale .95
wait game.FRAMETIME

trigger $joy_new_city_npc_spawner_11
$joy_new_city_npc_spawner_11 remove
$joy_new_city_npc_11 scale .95
trigger $joy_new_city_npc_spawner_12
$joy_new_city_npc_spawner_12 remove
$joy_new_city_npc_12 scale 1.0
$joy_new_city_npc_12 anim idle1
wait game.FRAMETIME

trigger $joy_new_city_npc_spawner_16
$joy_new_city_npc_spawner_16 remove
wait game.FRAMETIME

trigger $joy_new_city_npc_spawner_17
$joy_new_city_npc_spawner_17 remove
$joy_new_city_npc_17 scale 1.2
$joy_new_city_npc_17 anim idle1
$joy_new_city_npc_17 visiondistance 0
trigger $joy_new_city_npc_spawner_18
$joy_new_city_npc_spawner_18 remove
trigger $joy_new_city_npc_spawner_19
$joy_new_city_npc_spawner_19 remove
$joy_new_city_npc_19 scale 1.2
$joy_new_city_npc_19 anim idle1
$joy_new_city_npc_19 visiondistance 0

// These technicians are visible from the new-city area, so spawn them with
// that group instead of waiting for the parking-garage trigger.
wait game.FRAMETIME
trigger $joy_parking_garage_npc_spawner_15
$joy_parking_garage_npc_spawner_15 remove
$joy_parking_garage_npc_15 definestate opendoor global/baseai.scr::opendoor
$joy_parking_garage_npc_15 definestate sightenemy parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 definestate default_sightenemy parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 definestate weaponsound parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 definestate painsound parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 definestate breakingsound parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 definestate mutantsound parking_garage_npc15_cower_scared
$joy_parking_garage_npc_15 state idle

wait game.FRAMETIME
trigger $joy_parking_garage_npc_spawner_16
$joy_parking_garage_npc_spawner_16 remove
$joy_parking_garage_npc_16 definestate opendoor global/baseai.scr::opendoor
$joy_parking_garage_npc_16 definestate sightenemy parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate default_sightenemy parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate weaponsound parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate painsound parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate deathsound parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate breakingsound parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate mutantsound parking_garage_retreat_scared
$joy_parking_garage_npc_16 definestate pain parking_garage_retreat_scared
$joy_parking_garage_npc_16 state idle
level.parking_garage_neutrals_rammable_scared ifequal 1 $joy_parking_garage_npc_15 state breakingsound
level.parking_garage_neutrals_rammable_scared ifequal 1 $joy_parking_garage_npc_16 state breakingsound
end

