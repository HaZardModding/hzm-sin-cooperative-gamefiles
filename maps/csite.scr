// Generic "locked" responses
//-----------------------------

dialog_locked_door:
*1 randomsound "snd_locked" 1 2
end

dialog_locked_nondoor:
local.randomsnd randomint 4

local.randomsnd ifequal 0 *1 playsound "dialog/misc2/blade/noway.wav" 1 5
local.randomsnd ifequal 1 *1 playsound "dialog/misc2/blade/wontmove.wav" 1 5
local.randomsnd ifequal 2 *1 playsound "dialog/misc2/blade/notchance.wav" 1 5
local.randomsnd ifequal 3 *1 playsound "dialog/misc2/blade/stuck.wav" 1 5

end

machine_disabled:
*1 playsound "environment/computer/beeps/reject1.wav" 1 2
waitForSound "environment/computer/beeps/reject1.wav"
wait 0.5
*1 playsound "dialog/misc2/blade/noway.wav" 1 5
end

