local.cabinet5 rotateYdown 90
waitFor local.cabinet5

local.cabinet5 onuse cabinet5_close
pause

cabinet5_close:
local.cabinet5 nouse
local.cabinet5 rotateYup 90
waitFor local.cabinet5
local.cabinet5 playsound environment/doors/metal/mtldrcl3.wav 1.0
