//---------------------------------------------------------------
// Subway Cinematic
//---------------------------------------------------------------

	//[coop] chrissstrahl - START COOP MOD - REQUIRED
	aliasscript global/coop_main.scr coopMain
	thread coopMain::main

waitforplayercinematic

	//cinematic
	//[coop] chrissstrahl - notify coop about cinematic
	thread coopReplace::coop_cinematic

skipthread skiplevel_thread
setdialogscript dialog/dialog_subwaycinema.scr

waitforplayer
thread cinematic_initialize_thread
local.waitforthread = parm.previousthread
waitForThread local.waitforthread
thread cinematic_thread
thread manumit_thread
end

//---
cinematic_initialize_thread:

music suspense none
freezeplayer

	//cueplayer
	//[coop] chrissstrahl - unregister camera and cueplayer
	thread coopReplace::coop_cueplayer
	
hud 0
$blade3 hide
fadeout .1 0 0 0
wait .1
$blade anim "standidle2"
$hco1 anim "standidle2"
$hco2 anim "standidle1"
$hco2 notsolid
$hazmat anim "workcrouched"
wait 1
$hazmat2 anim "workcrouched"
$hco1 nochatter
$hco2 nochatter
$hazmat1 nochatter
$hazmat2 nochatter
//$blade skin "pl_blade/blade_base_dam.tga"
end


//---
skiplevel_thread:

	//[coop] chrissstrahl - lets handle that in a own func
	level.coopInMultiplayer ifgreaterequal 1 goto coop_skiplevel_thread

releaseplayer
thread LevelComplete
map chem1
end


//---
cinematic_thread:
local.joke_type randomint 2
fadein 3 0 0 0
$cam1 lookat $hco2

	//cuecamera $cam1
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam1
	thread coopReplace::coop_cuecamera

wait 1
//goto bla

parm.hazmat string $hazmat
parm.blade string $blade
parm.hco2 string $hco2
parm.hco1 string $hco1
local.joke_type ifequal 0 thread dialog::blade_and_company
local.joke_type ifequal 1 thread dialog::blade_and_company2
local.wait = parm.previousthread
waitForThread local.wait

music success suspense
parm.blade string $blade
local.joke_type ifequal 0 thread dialog::jc_joke
local.joke_type ifequal 1 thread dialog::jc_joke2
local.wait = parm.previousthread
waitForThread local.wait

thread anim1_thread
parm.blade string $blade
thread dialog::blade_leaves
local.wait = parm.previousthread
waitForThread local.wait

thread anim666_thread
parm.blade string $blade
thread dialog::blade_leaves2
local.wait = parm.previousthread
waitForThread local.wait
end

//---
cinematic2_thread:

bla:
music failure none
$cam3 lookat $jc
$cam3 jumpcut

	//cuecamera $cam3
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam3
	thread coopReplace::coop_cuecamera

parm.WaitTime = 5
parm.TimeDate string "m_2_hours_later"
parm.Location string "m_hardcorps_headquarters"
parm.Description string ""
thread global/universal_script.scr::XFilesScreen
wait 3

thread jcanim0_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_and_jc
local.wait = parm.previousthread
wait 2
fadein 4 0 0 0
waitForThread local.wait

thread anim3_thread
thread jcanim1_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_and_jc2
local.wait = parm.previousthread
waitForThread local.wait

thread jcanimx_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::jc_drum_roll
local.wait = parm.previousthread
waitForThread local.wait

thread jcanim666_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::jc_u4
local.wait = parm.previousthread
waitForThread local.wait

thread jcanim2_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_and_jc666
local.wait = parm.previousthread
waitForThread local.wait

thread pigeon_thread
thread anim777_thread
thread jcanim2_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_and_jc3
local.wait = parm.previousthread
waitForThread local.wait

thread jcanim888_thread
thread anim999_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_shit
local.wait = parm.previousthread
waitForThread local.wait

parm.blade string $blade2
thread anim888_thread
thread dialog::blade_yeah
local.wait = parm.previousthread
waitForThread local.wait

thread jcanim3_thread
parm.blade string $blade2
parm.jc string $jc
thread dialog::blade_and_jc777
local.wait = parm.previousthread
waitForThread local.wait

//$cam4 lookat $blade2
$cam4 jumpcut

	//cuecamera $cam4
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam4
	thread coopReplace::coop_cuecamera

thread anim2_thread
thread chair_thread
parm.blade string $blade2
thread dialog::blade_no_way
local.wait = parm.previousthread
waitForThread local.wait


$cam5 lookat $jc
$cam5 jumpcut

	//cuecamera $cam5
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam5
	thread coopReplace::coop_cuecamera
	
thread anim4_thread
thread door_thread

music success suspense
thread jcanim4_thread
parm.jc string $jc
thread dialog::jc_say_hi
local.wait = parm.previousthread
waitForThread local.wait

$blade2 hide
$blade3 show

fadeout 3 0 0 0
$cam6 jumpcut

	//cuecamera $cam6
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam6
	thread coopReplace::coop_cuecamera

thread cam1_thread
wait 2

	//[coop] chrissstrahl - lets handle that in a own func
	level.coopInMultiplayer ifgreaterequal 1 goto coop_skiplevel_thread
	
thread LevelComplete
map chem1
end


//---
LevelComplete:

// Send over the information needed to load the proper intermission
loadintermission "layouts/im_layouts/subway2_cinema_to_chem1"
thread global/universal_script.scr::CopyNewMisConToIntermission
end

// Threads for character stuff with multiple waitFor stuff etc. that can't be done in the main
// thread cause of waitFor and waitForThread mixups.


//---
cam1_thread:

local.fov = 90

cam1_loop:
$cam6 fov local.fov
local.fov iflessequal 10 goto cam1_end
local.fov *= .8
wait .1
goto cam1_loop

cam1_end:
end

//---
jcanim0_thread:

$jc anim "subway_1_idle"
wait 1
$jc anim "subway_0_listen"
end


//---
jcanim1_thread:

$jc anim "subway_2_exclamation"
waitFor $jc
$jc anim "subway_1_idle"
end


//---
jcanimx_thread:

wait 1.8
$jc anim "subway_3_drumroll"
waitFor $jc 
$jc anim "subway_0_listen"
end


//---
jcanim666_thread:

wait 2
$jc anim "subway_6_idle"
wait 2
$jc anim "subway_0_listen"
end


//---
jcanim2_thread:

$jc anim "subway_0_listen"
wait .5
$jc anim "subway_4_explain"
waitFor $jc
$jc anim "subway_1_idle"
end


//---
jcanim3_thread:

$jc anim "subway_6_mancini"
waitFor $jc
$jc anim "subway_1_idle"
end


//---
jcanim888_thread:

$jc anim "subway_0_listen"
wait 4
$jc anim "subway_1_idle"
end

//---
jcanim4_thread:

wait .8
$jc anim "subway_5_fantasygirl"
waitFor $jc
$jc anim "subway_1_idle"
end


//---
anim1_thread:

$blade anim "motion1"
waitFor $blade
$blade anim "standidle1"
end


//---
anim666_thread:

$cam2 lookat $blade
$cam2 jumpcut

	//cuecamera $cam2
	//[coop] chrissstrahl - register and cue camera
	parm.camera string $cam2
	thread coopReplace::coop_cuecamera

wait 1.5
$blade walkto $blade_node666
waitFor $blade
fadeout 1.6 0 0 0
$blade walkto $blade_node1
waitFor $blade
$blade anim "standidle1"
$blade2 anim "sitting"
wait 5
thread cinematic2_thread
end


//---
anim888_thread:

$blade2 anim "sitnodhead"
wait .6
$blade2 anim "sitting"
end

//---
anim2_thread:

$blade2 anim "sitshakehead"
waitFor $blade2
$blade2 anim "standup"
waitFor $blade2
$blade2 anim "standidle1"
waitFor $blade2
end


//---
anim3_thread:

wait 6
$blade2 anim "sitshakehead"
waitFor $blade2
$blade2 anim "sitting"
end

//---
anim777_thread:

wait 5
$blade2 anim "sitnodhead"
waitFor $blade2
$blade2 anim "sitting"
end


//---
anim999_thread:

wait .5
$blade2 anim "sitshakehead"
waitFor $blade2
$blade2 anim "sitting"
end


//---
anim4_thread:

wait 1.8
$blade3 anim "stoplook"
waitFor $blade3
$blade3 anim "stoplook_freeze"
end


//---
ignore_thread:

local.self ignoreall
pause
goto ignore_thread
end


//---
chair_thread:

wait 2
$chair time .5
$chair moveWest 32
$chair notsolid
waitFor $chair
end


//---
door_thread:

wait 2
$officedoor_left time .5
$officedoor_right time .5
$officedoor_right playsound environment/doors/pneu/smlpnu.wav 2 1
$officedoor_left moveSouth 96
$officedoor_right moveNorth 96
waitFor $officedoor_left
waitFor $officedoor_right
end


//---
manumit_thread:

$manumit anim "dead"

manumit_loop:
wait 4
$manumit anim "deadtwitch"
wait .3
$manumit anim "dead"
wait 5.5
$manumit anim "deadtwitch"
wait .3
$manumit anim "dead"
goto manumit_loop
end


//---
pigeon_thread:

$pigeon1 animate
$pigeon2 animate
$pigeon1 speed 10
$pigeon2 speed 10
$pigeon1 nextanim "pigeon_fly"
$pigeon2 nextanim "pigeon_fly"
$pigeon1 followpath $pigeon1_start
wait .3
$pigeon2 followpath $pigeon2_start
waitFor $pigeon2
end



//[coop] chrissstrahl - handle coop stuff in a own thread
coop_skiplevel_thread:
	releaseplayer
	thread LevelComplete
	//map chem1
	map bank
end

//[coop] chrissstrahl - DETECT PLAYER SPAWN - REQUIRED
//this fires everytime a player is spawned
//without this the coop mod will not work correctly!
coopInfoPlayerStartActivated:
	thread coopMain::playerTargetnames
end

//[coop] chrissstrahl - spawn a trigger we can actually control, as long as the next level is not completed
coop_levelSetup:
end

//[coop] chrissstrahl - executed each time a player has spawned
//optional function
coop_justSpawned:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end
		
//[coop] chrissstrahl - executed each time a player has died
//optional function
coop_justDied:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player enters spectator mode
//optional function
coop_justBecameSpectator:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player has entered the game (usually oce per level)
//optional function
coop_justEntered:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end	
	
//[coop] chrissstrahl - executed each time a player has disconnected
//optional function
coop_justLeft:
	local.player string parm.playerEvent
	//EXAMPLE: You can't do something with the player because the player has disconnected
	//You can however still check stuff based on player targetname
	//local.player ifstrequal "$player2" print "Player 2 has lost the will to fight\n"
end
