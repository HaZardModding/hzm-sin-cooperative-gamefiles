precache:
    setdialogscript dialog/dialog_bank.scr
    aliasscript global/universal_script.scr universal
end

// init_thread:
/////////////////////////////////////////////////////////////////////////////
init_thread:

// Lock security doors
$door_security lock
// [XA] note: two doors in particular are set up to allow monsters
// to open them, but players to not. this is done by faking the
// "damn, a security door" message with a trigger_use volume and
// using respondto to make them monster-only while locked. there's
// also a playerclip volume that prevents entering the room when
// a monster opens the door, which gets moved out of the way at
// the right time. this is a bit complex, but works in practice.
$door_security_thug03 respondto 8
$door_security_thug06 respondto 8
$door_security_thug03_playerclip time 0.1
$door_security_thug06_playerclip time 0.1

// Setup the revolving doors
$revolvingdoor1 jumpto $revolvingdoor1_start
$revolvingdoor2 jumpto $revolvingdoor2_start

// Setup the ATM room stuff
$fountain_spill1 hide
$fountain_spill2 hide

// Setup the copter flying away
$hc_copter minlight 1
$hc_copter_roters minlight 1
//$hc_copter lightoffset 127
//$hc_copter_roters lightoffset 127

$hc_copter_rotors bind $hc_copter_parent
$hc_copter bind $hc_copter_parent
wait game.FRAMETIME

$hc_copter_rotors rotateY 540

// Setup the ambient fighting sounds
local.Count = 1

loop_random_noise_init:
parm.NoiseMaker = local.Count
parm.NumNoiseMakers = 6
thread random_noise_init_thread

local.Count += 1
local.Count ifless 7 goto loop_random_noise_init

// Setup the repelers
thread repel_init_thread

// Setup the teller security gate
$teller_securitygate time 0.1
$teller_securitygate moveUp 144
waitFor $teller_securitygate

// Setup the vault combination
level.VaultCombo1 randomint 8
level.VaultCombo1 += 1
level.VaultCombo2 randomint 8
level.VaultCombo2 += 1

// Setup cinematics
thread init_start_cinematic_thread
waitForThread parm.previousthread

// Play the starting cinematic
thread start_cinematic_thread
level.start_cinematic_thread = parm.previousthread
waitForThread level.start_cinematic_thread
wait 1

thread bank_start_misscomp_thread
wait 2

// Start intro dialog and update the mission computer
thread jc_clear_bank_out_dialog_thread
waitForThread parm.previousthread

Waitforplayer

//[coop] chrissstrahl - don't execute in multiplayer
thread coopMain::inMultiplayer
parm.inMultiplayer ifequal 1 end

level.intro_start2 ifequal 0 *1 give RiotHelmet 100
level.intro_start2 ifequal 0 *1 give FlakJacket 100
level.intro_start2 ifequal 0 *1 give FlakPants 100

level.intro_start2 ifnotequal 0 *1 give RiotHelmet 50
level.intro_start2 ifnotequal 0 *1 give FlakJacket 50
level.intro_start2 ifnotequal 0 *1 give FlakPants 50

end // init_thread


// random_noise_init_thread:
/////////////////////////////////////////////////////////////////////////////
random_noise_init_thread:
local.NoiseMaker string "$random_noise0"
local.NoiseMaker appendint parm.NoiseMaker

loop_random_noise:
level.BattleThugsKilled ifequal 7 goto random_noise_done

local.delay randomint 60
local.delay += 30
wait local.delay

local.NoiseIndex randomint 7
local.NoiseIndex += 1

local.NoiseIndex ifequal 1 goto RandomNoisePlay1
local.NoiseIndex ifequal 2 goto RandomNoisePlay2
local.NoiseIndex ifequal 3 goto RandomNoisePlay3
local.NoiseIndex ifequal 4 goto RandomNoisePlay4
local.NoiseIndex ifequal 5 goto RandomNoisePlay5
local.NoiseIndex ifequal 6 goto RandomNoisePlay6
local.NoiseIndex ifequal 7 goto RandomNoisePlay7

RandomNoisePlay1:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_one
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay2:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_two
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay3:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_three
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay4:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_four
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay5:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_five
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay6:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_six
waitForThread parm.previousthread
goto loop_random_noise

RandomNoisePlay7:
parm.actor1 string local.NoiseMaker
parm.actor2 string local.NoiseMaker
thread dialog::combat_seven
waitForThread parm.previousthread
goto loop_random_noise

random_noise_done:

end // random_noise_init_thread


// repel_init_thread:
/////////////////////////////////////////////////////////////////////////////
repel_init_thread:
local.Count = 1

loop_setup_repel:
local.Rope string "$repel_thug"
local.Rope appendint local.Count
local.Rope append "_rope"

local.Rope hide

local.Count += 1
local.Count ifless 12 goto loop_setup_repel

repel_init_done:

end // repel_init_thread


//===========================================================================
//===========================================================================
// CINEMATICS
//===========================================================================
//===========================================================================
// init_start_cinematic_thread:
/////////////////////////////////////////////////////////////////////////////
init_start_cinematic_thread:

$mancini_thug04 ignoreall
$mancini_thug04 hide
$mancini_thug04 notsolid

$mancini_thug05 ignoreall
$mancini_thug05 hide
$mancini_thug05 notsolid

$start_mancini thread start_mancini_thread
$start_thug01 thread start_thug01_thread
$start_thug02 thread start_thug02_thread

end // init_start_cinematic_thread


// start_cinematic_thread:
/////////////////////////////////////////////////////////////////////////////
start_cinematic_thread:

Waitforplayer
freezeplayer

//cinematic
//cueplayer
//[coop] chrissstrahl - notify coop about cinematic
//[coop] chrissstrahl - unregister camera and cueplayer
thread coopReplace::coop_cinematic
thread coopReplace::coop_cueplayer

hud 0

$start_camera jumpto $start_camera_start
$start_camera lookat $start_mancini

//cuecamera $start_camera
//[coop] chrissstrahl - register and cue camera
parm.camera string $start_camera
thread coopReplace::coop_cuecamera

parm.WaitTime = 7
parm.TimeDate string "m_329_pm_july"
parm.Location string "m_freeport_city_bank_1"
parm.Description string "m_robbery_in_progress"
thread universal::XFilesScreen
level.start_xfiles_thread = parm.previousthread

fadein 8 0 0 0

//level.coopInMultiplayer ifgreaterequal 1 thread coopPlayerSpawn::bank_alt
thread coopPlayerSpawn::bank_alt
wait game.FRAMETIME
thread coopMain::playerMoveAllToSpawn

wait 2

skipthread start_cinematic_skip_thread


//[coop] chrissstrahl - skip while testing
//local.hostName getcvar "name"
//local.hostName ifequal level.devName goto start_cinematic_skip_thread

wait 4

$start_camera follow $start_camera_start $start_mancini
wait game.FRAMETIME

thread mancini_what_get_paid_dialog_thread

trigger $start_mancini
trigger $start_thug01
trigger $start_thug02
wait 16

// clean up the cinematic junk and enable the game characters
fadeout 3 0 0 0
wait 3

$start_mancini remove
$start_thug01 remove
$start_thug02 remove
$start_money01 remove
$start_money02 remove
$start_money03 remove
$start_moneybag_target remove

$mancini_thug04 respondtoall
$mancini_thug04 show
$mancini_thug04 solid

$mancini_thug05 respondtoall
$mancini_thug05 show
$mancini_thug05 solid

fadein 1 0 0 0

thread helicopter_sound_thread

hud 1

//cueplayer
//[coop] chrissstrahl - unregister camera and cueplayer
thread coopReplace::coop_cueplayer

//noncinematic
//[coop] chrissstrahl - end cinematic and notify script
thread coopReplace::coop_noncinematic

releaseplayer

end // start_cinematic_thread


// start_cinematic_skip_thread:
/////////////////////////////////////////////////////////////////////////////
start_cinematic_skip_thread:

skipthread ""

terminate level.start_cinematic_thread
terminate level.start_xfiles_thread
terminate level.start_cinematic_dialog_thread

// clean up the cinematic junk and enable the game characters
fadeout 1 0 0 0
wait 1

$start_mancini remove
$start_thug01 remove
$start_thug02 remove
$start_money01 remove
$start_money02 remove
$start_money03 remove
$start_moneybag_target remove

$mancini_thug04 respondtoall
$mancini_thug04 show
$mancini_thug04 solid

$mancini_thug05 respondtoall
$mancini_thug05 show
$mancini_thug05 solid

fadein 1 0 0 0

thread helicopter_sound_thread

hud 1

//cueplayer
//[coop] chrissstrahl - unregister camera and cueplayer
thread coopReplace::coop_cueplayer

//noncinematic
//[coop] chrissstrahl - end cinematic and notify script
thread coopReplace::coop_noncinematic

releaseplayer

end // start_cinematic_skip_thread


// start_mancini_thread:
/////////////////////////////////////////////////////////////////////////////
start_mancini_thread:

local.self ignoreall
local.self definestate activate start_mancini_activate
pause

start_mancini_activate:
local.self anim idle
wait 2

local.self anim idle_giving_orders
waitFor local.self
wait 1

local.self anim idle
wait 5

local.self anim idle_giving_orders
waitFor local.self

local.self anim idle

end // start_mancini_thread


// start_thug01_thread:
/////////////////////////////////////////////////////////////////////////////
start_thug01_thread:

local.self attachmodel moneybag.def gun temp_money01

local.self ignoreall
local.self respondto opendoor
local.self definestate activate start_thug01_activate
pause

start_thug01_activate:
local.self ignore activate

local.self walkto $start_thug01_node1
waitFor local.self

$temp_money01 throw local.self 125 $start_moneybag_target 1
wait 6

local.self walkto $start_thug01_node2
waitFor local.self

end // start_thug01_thread


// start_thug02_thread:
/////////////////////////////////////////////////////////////////////////////
start_thug02_thread:

local.self attachmodel moneybag.def gun temp_money02

local.self ignoreall
local.self respondto opendoor
local.self definestate activate start_thug02_activate
pause

start_thug02_activate:
local.self ignore activate

local.self walkto $start_thug01_node3
waitFor local.self

$temp_money02 throw local.self 125 $start_moneybag_target 1
wait 4

local.self walkto $start_thug01_node2
waitFor local.self

end // start_thug02_thread


