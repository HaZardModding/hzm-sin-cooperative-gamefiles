// helicopter_sound_thread:
/////////////////////////////////////////////////////////////////////////////
helicopter_sound_thread:

game.intro_ground_entrance ifequal 2 goto helicopter_sound_skip

$hc_copter2 entitysound vehicle/helicopt/flyloop.wav 0.15 4.0

// Setup the copter flying away
$hc_copter2 minlight 1
$hc_copter2_roters minlight 1

$hc_copter2_rotors bind $hc_copter2_parent
$hc_copter2 bind $hc_copter2_parent
wait game.FRAMETIME

$hc_copter2_rotors rotateY 540

$hc_copter2_parent followpath $hc_copter2_path
waitFor $hc_copter2_parent

$hc_copter2 stopsound

$hc_copter2_rotors remove
$hc_copter2 remove
$hc_copter2_parent remove

$helicopter_sound remove

end

helicopter_sound_skip:

$hc_copter2 remove

end // helicopter_sound_thread


