local.DisplayAccount ifstrequal local.Egg32Account local.atm_consoleobject conmenufile "menus/bank/bankac34.002"
local.DisplayAccount ifstrequal local.Egg33Account local.atm_consoleobject conmenufile "menus/bank/bankac35.002"
local.DisplayAccount ifstrequal local.Egg34Account local.atm_consoleobject conmenufile "menus/bank/bankac36.002"
local.DisplayAccount ifstrequal local.Egg35Account local.atm_consoleobject conmenufile "menus/bank/bankac37.002"
local.DisplayAccount ifstrequal local.Egg36Account local.atm_consoleobject conmenufile "menus/bank/bankac38.002"
local.DisplayAccount ifstrequal local.Egg37Account local.atm_consoleobject conmenufile "menus/bank/bankac39.002"

local.DisplayAccount ifstrequal local.Egg38Account local.atm_consoleobject conmenufile "menus/bank/bankac40.002"
local.DisplayAccount ifstrequal local.Egg39Account local.atm_consoleobject conmenufile "menus/bank/bankac41.002"
local.DisplayAccount ifstrequal local.Egg40Account local.atm_consoleobject conmenufile "menus/bank/bankac42.002"
local.DisplayAccount ifstrequal local.Egg41Account local.atm_consoleobject conmenufile "menus/bank/bankac43.002"
local.DisplayAccount ifstrequal local.Egg42Account local.atm_consoleobject conmenufile "menus/bank/bankac44.002"
local.DisplayAccount ifstrequal local.Egg43Account local.atm_consoleobject conmenufile "menus/bank/bankac45.002"
local.DisplayAccount ifstrequal local.Egg44Account local.atm_consoleobject conmenufile "menus/bank/bankac46.002"
local.DisplayAccount ifstrequal local.Egg45Account local.atm_consoleobject conmenufile "menus/bank/bankac47.002"
local.DisplayAccount ifstrequal local.Egg46Account local.atm_consoleobject conmenufile "menus/bank/bankac48.002"
local.DisplayAccount ifstrequal local.Egg47Account local.atm_consoleobject conmenufile "menus/bank/bankac49.002"
local.DisplayAccount ifstrequal local.Egg48Account local.atm_consoleobject conmenufile "menus/bank/bankac50.002"
local.DisplayAccount ifstrequal local.Egg49Account local.atm_consoleobject conmenufile "menus/bank/bankac51.002"
local.DisplayAccount ifstrequal local.Egg50Account local.atm_consoleobject conmenufile "menus/bank/bankac52.002"
local.DisplayAccount ifstrequal local.Egg51Account local.atm_consoleobject conmenufile "menus/bank/bankac53.002"
local.DisplayAccount ifstrequal local.Egg52Account local.atm_consoleobject conmenufile "menus/bank/bankac54.002"
local.DisplayAccount ifstrequal local.Egg53Account local.atm_consoleobject conmenufile "menus/bank/bankac55.002"
local.DisplayAccount ifstrequal local.Egg54Account local.atm_consoleobject conmenufile "menus/bank/bankac56.002"
local.DisplayAccount ifstrequal local.Egg55Account local.atm_consoleobject conmenufile "menus/bank/bankac57.002"

local.PrintString string "jr 20 yt -120 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplayChecking
local.PrintString append "\" jr 20 yt -180 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplaySavings
local.PrintString append "\""
local.atm_consoleobject conlayout local.PrintString

local.atm_consoleobject focus menu
waitForConsole local.atm_console
local.atminput coninput local.atm_console
goto ATM_Account_ProcessInput

ATM_Account_ProcessInput:
local.atminput ifequal 1 goto ATM_Account_Withdrawl
local.atminput ifequal 2 goto ATM_Account_Deposit
local.atminput ifequal 3 goto ATM_Account_WireFunds
local.atminput ifequal 4 goto ATM_Main_Input

ATM_Account_Withdrawl:
local.atm_consoleobject conprint "m_withdrawls_temporarily"
goto ATM_Account_Input

ATM_Account_Deposit:
local.atm_consoleobject conprint "m_deposits_temporarily"
goto ATM_Account_Input

ATM_Account_WireFunds:
local.DisplayAccount ifstrequal level.ElexisAccount goto ATM_Account_WireFunds_FromElexis
local.DisplayAccount ifstrequal level.BladeAccount goto ATM_Account_WireFunds_FromBlade
local.atm_consoleobject conprint "m_access_denied"
goto ATM_Account_Input

ATM_Account_WireFunds_FromElexis:
game.bank_balance ifequal 1 goto ATM_Account_WireFunds_FromElexis_OnHold
local.atm_consoleobject conprint "m_enter_destination"
local.atm_consoleobject focus console
waitForConsole local.atm_console
local.atminput coninput local.atm_console
local.atminput ifstrequal level.BladeAccount goto ATM_Account_WireFunds_FromElexis_ValidAccount
local.atminput ifstrequal level.ElexisAccount goto ATM_Account_WireFunds_Denied
// Put stuff for extra accounts
local.atm_consoleobject conprint "m_invalid_account"
goto ATM_Account_Input

ATM_Account_WireFunds_FromElexis_ValidAccount:
game.bank_balance ifequal 0 goto ATM_Account_WireFunds_FromElexis_Sufficient
goto ATM_Account_WireFunds_FromElexis_OnHold

ATM_Account_WireFunds_FromElexis_OnHold:
local.atm_consoleobject conprint "m_funds_on"
local.DisplayChecking string level.ElexisChecking
local.DisplaySavings string level.ElexisSavings
local.PrintString string "jr 20 yt -120 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplayChecking
local.PrintString append "\" jr 20 yt -180 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplaySavings
local.PrintString append "\""
goto ATM_Account_Input

ATM_Account_WireFunds_FromElexis_Sufficient:
game.bank_balance = 1
local.DisplayChecking string "$0.00"
local.DisplaySavings string "$0.00"
level.ElexisChecking string "$0.00"
level.ElexisSavings string "$0.00"
level.BladeChecking string "$9,390,000.00"
level.BladeSavings string "$100,040.00"
local.atm_consoleobject conprint "m_949004100_wired_to"
goto ATM_Account_Input

ATM_Account_WireFunds_FromBlade:
game.bank_balance ifequal 0 goto ATM_Account_WireFunds_FromBlade_Insufficient
game.bank_balance ifequal 1 goto ATM_Account_WireFunds_FromBlade_OnHold

ATM_Account_WireFunds_FromBlade_OnHold:
local.atm_consoleobject conprint "m_funds_on"
local.DisplayChecking string level.BladeChecking
local.DisplaySavings string level.BladeSavings
local.PrintString string "jr 20 yt -120 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplayChecking
local.PrintString append "\" jr 20 yt -180 fc 0.5 0.5 0.5 1 string \""
local.PrintString append local.DisplaySavings
local.PrintString append "\""
goto ATM_Account_Input

ATM_Account_WireFunds_FromBlade_Insufficient:
local.atm_consoleobject conprint "m_insufficient_funds"
goto ATM_Account_Input

ATM_Account_WireFunds_Denied:
local.atm_consoleobject conprint "m_action_denied"
local.atm_consoleobject conprint local.atminput
local.atm_consoleobject conprint "\n"
goto ATM_Account_Input

end


//===========================================================================
//===========================================================================
// MISSION COMPUTER
//===========================================================================
//===========================================================================
// bank_start_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
bank_start_misscomp_thread:

thread BankMissionComputer
thread universal::StatusUpdated
waitForThread parm.previousthread

end // bank_start_misscomp_thread

// capture_mancini_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
capture_mancini_misscomp_thread:

thread blade_open_tellers
waitForThread parm.previousthread

level.PObjective5 = 0 // Chase Mancini

thread BankMissionComputer
thread universal::StatusUpdated
waitForThread parm.previousthread

end // capture_mancini_misscomp_thread


// security_key_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
security_key_misscomp_thread:

level.PObjective2 = 1 // Locate Security Office Key
level.PObjective3 = 0 // Gain Access To Security Room

music success normal

thread universal::PObjectiveComplete
waitForThread parm.previousthread

thread BankMissionComputer
thread universal::StatusUpdated
waitForThread parm.previousthread

end // security_key_misscomp_thread


// security_room_entered_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
security_room_entered_misscomp_thread:

level.PObjective3 = 1 // Gain Access To Security Room
level.PObjective4 = 0 // Gain Access To The Vault

// [XA] new to reloaded: don't trigger success music
// here so it doesn't interrupt the suspense music
thread universal::PObjectiveCompleteNoMusic
waitForThread parm.previousthread

thread BankMissionComputer
thread universal::StatusUpdated
waitForThread parm.previousthread

end // security_room_entered_misscomp_thread


// vault_opened_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
vault_opened_misscomp_thread:

level.PObjective4 = 1 // Gain Access To The Vault

// [XA] new to Reloaded: immediately trigger the new 'mystery' music
// track when the vault opens, instead of the success music
music mystery

thread BankMissionComputer
thread universal::PObjectiveCompleteNoMusic

thread BankMissionComputer
thread universal::StatusUpdated
waitForThread parm.previousthread

end // vault_opened_misscomp_thread


// security_doors_unlocked_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
security_doors_unlocked_misscomp_thread:

level.SObjective1 = 1 // Unlock All Security Doors

music success normal

// [XA] new to Reloaded: remove the suspense music triggers when the security
// door objective gets marked complete, since you're basically "done" here
$trigger_security_music remove

thread BankMissionComputer
thread universal::SObjectiveComplete
waitForThread parm.previousthread

end // security_doors_unlocked_misscomp_thread


// hostages_saved_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
hostages_saved_misscomp_thread:

level.SObjective2 = 1 // Secure Hostages

music success normal

thread BankMissionComputer
thread universal::SObjectiveComplete
waitForThread parm.previousthread

end // hostages_saved_misscomp_thread


// hostages_killed_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
hostages_killed_misscomp_thread:

level.SObjective2 = 2 // Secure Hostages

music failure normal

thread BankMissionComputer
thread universal::SObjectiveFailed
waitForThread parm.previousthread

end // hostages_killed_misscomp_thread


// BankMissionComputer:
/////////////////////////////////////////////////////////////////////////////
BankMissionComputer:

thread universal::NewMisConSetup

parm.status = level.PObjective1
parm.title string "\"m_disable_hostile_threat_1\""
thread universal::NewMisConPrimary

parm.status = level.PObjective2
parm.title string "\"m_locate_security_office_1\""
thread universal::NewMisConPrimary

parm.status = level.PObjective3
parm.title string "\"m_gain_access_to_1_1\""
thread universal::NewMisConPrimary

parm.status = level.PObjective4
parm.title string "\"m_gain_access_to_2_1\""
thread universal::NewMisConPrimary

parm.status = level.PObjective5
parm.title string "\"m_chase_mancini\""
thread universal::NewMisConPrimary

parm.status = level.SObjective1
parm.title string "\"m_unlock_all_security_1\""
thread universal::NewMisConSecondary

parm.status = level.SObjective2
parm.title string "\"m_secure_hostages\""
thread universal::NewMisConSecondary

end // BankMissionComputer


//---------------------------------------------------------------------------
// Finished Level Update
//---------------------------------------------------------------------------
LevelComplete:

// Clears any items in the player's inventory that need to be removed
thread universal::ClearInventory

	//[coop] chrissstrahl - coop compatibility
	level.coopInMultiplayer ifgreaterequal 1 thread coop_takeStuff
	level.coopInMultiplayer ifgreaterequal 1 goto LevelComplete_continue

*1 take evidence
*1 take dollar

	//[coop] chrissstrahl - coop compatibility
	LevelComplete_continue:

// P1 & 5 are the only objects that need to be set, anything else is a bug
level.PObjective1 = 1 // Disable Hostile Threat
//level.PObjective2 = 1 // Locate Security Office Key
//level.PObjective3 = 1 // Gain Access To Security Room
//level.PObjective4 = 1 // Gain Access To The Vault
level.PObjective5 = 1 // Chase Mancini

// Fail the incomplete secondary objectives
level.SObjective1 ifequal 0 level.SObjective1 = 2 // Unlock All Security Doors
level.SObjective2 ifequal 0 level.SObjective2 = 2 // Secure Hostages

thread BankMissionComputer

// Send over the information that Scott needs to load the proper intermission
game.bank_evidence_found ifnotequal 1 loadintermission "layouts/im_layouts/bank_to_abandon"
game.bank_evidence_found ifequal 1 loadintermission "layouts/im_layouts/bank_to_abandon2"
thread universal::CopyNewMisConToIntermission

end

// new elevator
Elevator_Init:
  local.elev string "$elev"
  local.elev_surf string "@elev"

  local.elev_inner_btn string local.elev
  local.elev_inner_btn append "_inner_btn"
  local.elev_inner_btn_surf string local.elev_surf
  local.elev_inner_btn_surf append "_inner_btn"

  local.elev_lower string local.elev
  local.elev_lower append "2"
  local.elev_lower_btn string local.elev_lower
  local.elev_lower_btn append "_btn"
  local.elev_lower_doora string local.elev_lower
  local.elev_lower_doora append "_door_a"
  local.elev_lower_doorb string local.elev_lower
  local.elev_lower_doorb append "_door_b"
  local.elev_lower_waypoint string local.elev_lower
  local.elev_lower_waypoint append "_waypoint"
  local.elev_lower_btn_surf string local.elev_surf
  local.elev_lower_btn_surf append "2_btn"

  local.elev_lower_doora_start getorigin local.elev_lower_doora
  local.elev_lower_doorb_start getorigin local.elev_lower_doorb
  local.elev_lower_doora_end vector local.elev_lower_doora_start
  local.elev_lower_doora_end vector_add "0 44 0"
  local.elev_lower_doorb_end vector local.elev_lower_doorb_start
  local.elev_lower_doorb_end vector_add "0 84 0"


  local.elev_upper string local.elev
  local.elev_upper append "1"
  local.elev_upper_btn string local.elev_upper
  local.elev_upper_btn append "_btn"
  local.elev_upper_doora string local.elev_upper
  local.elev_upper_doora append "_door_a"
  local.elev_upper_doorb string local.elev_upper
  local.elev_upper_doorb append "_door_b"
  local.elev_upper_waypoint string local.elev_upper
  local.elev_upper_waypoint append "_waypoint"
  local.elev_upper_btn_surf string local.elev_surf
  local.elev_upper_btn_surf append "1_btn"

  local.elev_upper_doora_start getorigin local.elev_upper_doora
  local.elev_upper_doorb_start getorigin local.elev_upper_doorb
  local.elev_upper_doora_end vector local.elev_upper_doora_start
  local.elev_upper_doora_end vector_add "0 44 0"
  local.elev_upper_doorb_end vector local.elev_upper_doorb_start
  local.elev_upper_doorb_end vector_add "0 84 0"


  // set up initial state of elevator, at the bottom
  // with lower doors open
  local.elev time 2.4

  local.elev_lower_doora time 1
  local.elev_lower_doorb time 1
  local.elev_upper_doora time 1
  local.elev_upper_doorb time 1

  local.elev_upper_doora onblock upper_doors_blocked
  local.elev_upper_doorb onblock upper_doors_blocked

  local.elev_lower_doora onblock lower_doors_blocked
  local.elev_lower_doorb onblock lower_doors_blocked

  // set up state machine
  local.elev_state = 8
  goto elev_state_machine

  pause

  // buzz
  // TODO: since the state machine is one thread, these buttons
  // don't directly work like I hoped they would.
  elev_btn_unavailable:
    // can't get "self" from here but this should be OK I think
    local.elev playsound environment/computer/beeps/reject1.wav 1.0
  pause

  upper_doors_blocked:
    local.elev_state = 3
    goto elev_state_machine
  pause

  lower_doors_blocked:
    local.elev_state = 7
    goto elev_state_machine
  pause

  elev_state_machine:
    print "state machine: " local.elev_state "\n"
    local.elev_state ifequal 0 goto elev_state_at_bottom
    local.elev_state ifequal 1 goto elev_state_closing_lower_doors
    local.elev_state ifequal 2 goto elev_state_going_up
    local.elev_state ifequal 3 goto elev_state_opening_upper_doors
    local.elev_state ifequal 4 goto elev_state_at_top
    local.elev_state ifequal 5 goto elev_state_closing_upper_doors
    local.elev_state ifequal 6 goto elev_state_going_down
    local.elev_state ifequal 7 goto elev_state_opening_lower_doors
    local.elev_state ifequal 8 goto elev_state_opening_lower_doors_start

    elev_state_at_bottom:
      local.elev_lower_btn nouse
      local.elev_lower_btn_surf frame 0
      local.elev_upper_btn onuse elev_upper_press
      local.elev_upper_btn_surf frame 1
      local.elev_inner_btn onuse elev_inner_press
      local.elev_inner_btn_surf frame 1
    pause

    elev_state_closing_lower_doors:
      local.elev_lower_doora playsound environment/conveyor/convnice1.wav 1.0
      local.elev_lower_doorb playsound environment/conveyor/convnice1.wav 1.0
      local.elev_lower_doora moveto local.elev_lower_doora_start
      local.elev_lower_doorb moveto local.elev_lower_doorb_start
      waitFor local.elev_lower_doora
      local.elev_lower_doora playsound environment/conveyor/con4end.wav 1.0
      local.elev_lower_doorb playsound environment/conveyor/con4end.wav 1.0
      wait 1.0
      local.elev_state = 2
      goto elev_state_machine
    pause

    elev_state_going_up:
      local.elev playsound environment/levelsnds/bank/bankmix2.wav 1.0
      local.elev moveto local.elev_upper_waypoint
      waitFor local.elev
      wait 1.0
      local.elev_upper_btn playsound environment/computer/beeps/doorbeep.wav 1.0
      local.elev_state = 3
      goto elev_state_machine
    pause

    elev_state_opening_upper_doors:
      local.elev_upper_doora playsound environment/conveyor/convnice1.wav 1.0
      local.elev_upper_doorb playsound environment/conveyor/convnice1.wav 1.0
      local.elev_upper_doora moveto local.elev_upper_doora_end
      local.elev_upper_doorb moveto local.elev_upper_doorb_end
      waitFor local.elev_upper_doora
      local.elev_upper_doora playsound environment/conveyor/con4end.wav 1.0
      local.elev_upper_doorb playsound environment/conveyor/con4end.wav 1.0
      local.elev_state = 4
      goto elev_state_machine
    pause

    elev_state_at_top:
      local.elev_upper_btn nouse
      local.elev_upper_btn_surf frame 0
      local.elev_lower_btn onuse elev_lower_press
      local.elev_lower_btn_surf frame 1
      local.elev_inner_btn onuse elev_inner_press
      local.elev_inner_btn_surf frame 1
    pause

    elev_state_closing_upper_doors:
      local.elev_upper_doora playsound environment/conveyor/convnice1.wav 1.0
      local.elev_upper_doorb playsound environment/conveyor/convnice1.wav 1.0
      local.elev_upper_doora moveto local.elev_upper_doora_start
      local.elev_upper_doorb moveto local.elev_upper_doorb_start
      waitFor local.elev_upper_doora
      local.elev_upper_doora playsound environment/conveyor/con4end.wav 1.0
      local.elev_upper_doorb playsound environment/conveyor/con4end.wav 1.0
      wait 1.0
      local.elev_state = 6
      goto elev_state_machine
    pause

    elev_state_going_down:
      local.elev playsound environment/levelsnds/bank/bankmix2.wav 1.0
      local.elev moveto local.elev_lower_waypoint
      waitFor local.elev
      wait 1.0
      local.elev_lower_btn playsound environment/computer/beeps/doorbeep.wav 1.0
      local.elev_state = 7
      goto elev_state_machine
    pause

    elev_state_opening_lower_doors:
      local.elev_lower_doora playsound environment/conveyor/convnice1.wav 1.0
      local.elev_lower_doorb playsound environment/conveyor/convnice1.wav 1.0
      local.elev_lower_doora moveto local.elev_lower_doora_end
      local.elev_lower_doorb moveto local.elev_lower_doorb_end
      waitFor local.elev_lower_doora
      local.elev_lower_doora playsound environment/conveyor/con4end.wav 1.0
      local.elev_lower_doorb playsound environment/conveyor/con4end.wav 1.0
      local.elev_state = 0
      goto elev_state_machine
    pause

    elev_state_opening_lower_doors_start:
      local.elev_lower_doora moveto local.elev_lower_doora_end
      local.elev_lower_doorb moveto local.elev_lower_doorb_end
      waitFor local.elev_lower_doora
      local.elev_state = 0
      goto elev_state_machine
    pause
  pause

  elev_upper_press:
    local.elev_lower_btn nouse
    local.elev_upper_btn nouse
    local.elev_inner_btn nouse
    local.elev_upper_btn playsound environment/cabinet/glasscab/latch12.wav 1.0
    local.elev_lower_btn_surf frame 2
    local.elev_upper_btn_surf frame 2
    local.elev_inner_btn_surf frame 2
    local.elev_state = 1
    goto elev_state_machine
  pause

  elev_lower_press:
    local.elev_lower_btn nouse
    local.elev_upper_btn nouse
    local.elev_inner_btn nouse
    local.elev_lower_btn playsound environment/cabinet/glasscab/latch12.wav 1.0
    local.elev_lower_btn_surf frame 2
    local.elev_upper_btn_surf frame 2
    local.elev_inner_btn_surf frame 2
    local.elev_state = 5
    goto elev_state_machine
  pause

  elev_inner_press:
    local.elev_lower_btn nouse
    local.elev_upper_btn nouse
    local.elev_inner_btn nouse
    local.elev_inner_btn playsound environment/cabinet/glasscab/latch12.wav 1.0
    local.elev_lower_btn_surf frame 2
    local.elev_upper_btn_surf frame 2
    local.elev_inner_btn_surf frame 2

    local.old_state = local.elev_state
    local.elev_state = 5
    local.old_state ifequal 0 local.elev_state = 1
    goto elev_state_machine
  pause
end



//[coop] chrissstrahl - coop compatibility
coop_takeStuff:
	parm.coop_take string "evidence"
	thread coopReplace::coop_take
	
	parm.coop_take string "dollar"
	thread coopReplace::coop_take
end

//[coop] chrissstrahl - DETECT PLAYER SPAWN - REQUIRED
//this fires everytime a player is spawned
//without this the coop mod will not work correctly!
coopInfoPlayerStartActivated:
	thread coopMain::playerTargetnames
end

//[coop] chrissstrahl - spawn a trigger we can actually control, as long as the next level is not completed
coop_levelSetup:
	removeclass "triggerchangelevel"
	wait game.FRAMETIME
	//clearsavegames
	//map "abandon$start1"
	//the asterix infront of the mapname is suppose to clearsaved games in the trigger_changelevel
	//WARNING - the model number may change if the game gets updates!!!
	spawn trigger_changelevel model "*242" origin "-2688 512 224" "map" "*abandon$start1" targetname "coopLvlEnd" thread "LevelComplete"
end

//[coop] chrissstrahl - executed each time a player has spawned
//optional function
coop_justSpawned:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end
		
//[coop] chrissstrahl - executed each time a player has died
//optional function
coop_justDied:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player enters spectator mode
//optional function
coop_justBecameSpectator:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player has entered the game (usually oce per level)
//optional function
coop_justEntered:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end	
	
//[coop] chrissstrahl - executed each time a player has disconnected
//optional function
coop_justLeft:
	local.player string parm.playerEvent
	//EXAMPLE: You can't do something with the player because the player has disconnected
	//You can however still check stuff based on player targetname
	//local.player ifstrequal "$player2" print "Player 2 has lost the will to fight\n"
end

