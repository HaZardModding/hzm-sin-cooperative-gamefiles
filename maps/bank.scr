level.HostagesSaved += 1
thread hostage_thread

pause

hostage07_killed:
local.self ignore killed

level.HostagesKilled += 1
thread hostage_thread

end // hostage07_thread


// hostage_thread:
/////////////////////////////////////////////////////////////////////////////
hostage_thread:

local.MustSave = level.Skill
local.MustSave += 4

local.AllowKilled = 3
local.AllowKilled -= level.Skill

level.SObjective2 ifnotequal 0 goto hostage_done
level.HostagesSaved ifgreaterequal local.MustSave goto hostage_enoughsaved
level.HostagesKilled ifgreater local.AllowKilled goto hostage_toomanykilled
goto hostage_done

hostage_enoughsaved:
thread hostages_saved_misscomp_thread
goto hostage_done

hostage_toomanykilled:
thread hostages_killed_misscomp_thread
goto hostage_done

hostage_done:

end // hostage_thread

SpawnRealRope:

ropedrop parm.Origin parm.Rope 8

end

// repel_thug_thread:
/////////////////////////////////////////////////////////////////////////////
repel_thug_thread:
local.Thug string parm.Thug
local.ThugNoDollar string parm.ThugNoDollar
local.Node1 string local.Thug
local.Node1 append "_node1"
local.Node2 string local.Thug
local.Node2 append "_node2"
local.Rope string local.Thug
local.Rope append "_rope"
local.Glass string local.Thug
local.Glass append "_glass"

local.self ignoreall
local.self respondto opendoor

local.self definestate killed repel_thug_killed_thread

trigger local.Glass

local.self runto local.Node1
waitFor local.self

local.Rope show

local.RealRope string local.Thug
local.RealRope append "_realrope"

parm.Rope string local.ThugNoDollar
parm.Rope append "_realrope"
local.RopePos string local.Thug
local.RopePos append "_ropepos"

parm.Origin vector "(0 0 0)"
parm.Origin getorigin local.RopePos
thread SpawnRealRope

local.RealRope doActivate

local.self playsound misc/rappel.wav 1

local.self behavior Repel "repel1" local.Node2 48
waitFor local.self
wait game.FRAMETIME

local.Rope remove
local.RealRope ropebase_drop
local.RealRope fade 0.1

local.self respondtoall
local.attackmode = 2
local.self attackplayer

end repel_thug_thread // repel_thug_thread

repel_thug_killed_thread:
local.Rope remove

end repel_thug_killed_thread // repel_thug_killed_thread

