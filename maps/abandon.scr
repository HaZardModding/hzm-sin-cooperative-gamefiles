//===========================================================================
//===========================================================================
// MISSION COMPUTER
//===========================================================================
//===========================================================================
// abandon_start_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
abandon_start_misscomp_thread:

thread AbandonMissionComputer
thread global/universal_script.scr::StatusUpdated

end // abandon_start_misscomp_thread


// stolen_money_recovered_misscomp_thread:
/////////////////////////////////////////////////////////////////////////////
stolen_money_recovered_misscomp_thread:

level.SObjective1 = 1 // Recover Stolen Money Bags

music success normal

thread AbandonMissionComputer
thread global/universal_script.scr::SObjectiveComplete

end // stolen_money_recovered_misscomp_thread


// AbandonMissionComputer:
/////////////////////////////////////////////////////////////////////////////
AbandonMissionComputer:
thread global/universal_script.scr::NewMisConSetup

parm.status = level.PObjective1
parm.title string "\"m_pursue_mancini\""
thread global/universal_script.scr::NewMisConPrimary

parm.status = level.PObjective2
parm.title string "\"m_eliminate_hostile_forces_1\""
thread global/universal_script.scr::NewMisConPrimary

parm.status = level.SObjective1
parm.title string "\"m_recover_stolen_money_1_1\""
thread global/universal_script.scr::NewMisConSecondary

end // AbandonMissionComputer


//---------------------------------------------------------------------------
// Finished Level Update
//---------------------------------------------------------------------------
LevelComplete:

// Clears any items in the player's inventory that need to be removed
thread global/universal_script.scr::ClearInventory

// P1 & 2 are the only objects that need to be set, anything else would be a bug
level.PObjective1 = 1 // Pursue Mancini
level.PObjective2 = 1 // Eliminate Hostile Forces

// Fail the incomplete secondary objectives
level.SObjective1 ifequal 0 level.SObjective1 = 2 // Recover Stolen Money Bags

thread AbandonMissionComputer

// Send over the information that Scott needs to load the proper intermission
loadintermission "layouts/im_layouts/abandon_to_csite_cinema"
thread global/universal_script.scr::CopyNewMisConToIntermission

end
