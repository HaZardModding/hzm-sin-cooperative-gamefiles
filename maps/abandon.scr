// bridgefall_thread:
/////////////////////////////////////////////////////////////////////////////
bridgefall_thread:

$bridgefall1 ontouch BridgeFall
$bridgefall2 ontouch BridgeFall
pause

BridgeFall:
$bridgefall1 notouch
$bridgefall2 notouch

music suprise normal

$bridgefall1 playsound impact/wood/woodmix5.wav 4

$bridgefall1 time 0.2
$bridgefall2 time 0.2
$bridgefall1 moveDown 2
$bridgefall2 moveDown 1
$bridgefall1 rotateYup 1
$bridgefall2 rotateYdown 2
waitFor $bridgefall2

wait 0.4

$bridgefall1 time 0.6
$bridgefall2 time 0.6
$bridgefall1 moveNorth 24
$bridgefall2 moveSouth 24
$bridgefall1 moveDown 190
$bridgefall2 moveDown 191
$bridgefall1 rotateYup 15
$bridgefall2 rotateYdown 30
waitFor $bridgefall2

$bridgefall2 playsound impact/explosion/track65.wav 4

end // bridgefall_thread


// copter1_thread:
/////////////////////////////////////////////////////////////////////////////
copter1_thread:

$copter1 minlight 1
$copter1_rotors minlight 1
$copter1 lightoffset 120
$copter1_rotors lightoffset 120

$copter1 bind $copter1_parent
$copter1_rotors bind $copter1_parent

$copter1 playsound vehicle/helicopt/flyloop.wav 1
wait 1

$copter1 playsound vehicle/helicopt/flyloop.wav 2
wait 1

$copter1 playsound vehicle/helicopt/flyloop.wav 3
wait 1

$copter1 playsound vehicle/helicopt/flyloop.wav 4.0

$copter1_rotors rotateY 540
$copter1_parent followpath $copter1_path1
waitFor $copter1_parent

$copter1 stopsound

$copter1_rotors remove
$copter1 remove
$copter1_parent remove

end // copter1_thread


// gasmain_thread:
/////////////////////////////////////////////////////////////////////////////
gasmain_thread:

// [XA] swap non-functional 'action' music trigger for new 'mystery' track
music mystery

thread blade_smell_gas_dialog_thread
wait 8

// make the steam sound a bit louder
trigger $gasmain_snd2
wait 5

trigger $gasmain_sparks1
wait 1.3

$basmain_damaged solid
trigger $gasmain_snd1
trigger $gasmain_snd2
trigger $gasmain_snd3
trigger $gasmain_explosion
trigger $gasmain_sparks2
trigger $gasmain_damage
$gasmain_gas remove
$gasmain_fire show
$gasmain_fire_hurt setdamage 20

thread gasmain_rubble1_thread
thread gasmain_rubble2_thread
thread gasmain_clip1_thread

$gasmain_ls1 lightstyle "Lmmmcmmcccmmmmmcmmmmccmmmmmmmcmccmmcmmmccmm"

music normal

end // gasmain_thread


