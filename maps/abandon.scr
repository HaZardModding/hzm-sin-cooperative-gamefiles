// moneybag_thread:
/////////////////////////////////////////////////////////////////////////////
moneybag_thread:
local.BagsNeeded = 14

level.Skill ifequal 1 local.BagsNeeded -= 3
level.Skill ifequal 0 local.BagsNeeded -= 6

level.MoneybagsCollected += 1

level.MoneybagsCollected ifequal local.BagsNeeded thread stolen_money_recovered_misscomp_thread

end // moneybag_thread


//===========================================================================
//===========================================================================
// CHARACTERS
//===========================================================================
//===========================================================================
// stand_ground_thread:
/////////////////////////////////////////////////////////////////////////////
stand_ground_thread:
local.self ignoresounds

local.attackmode = 1

end // stand_ground_thread


// init_character_items_thread:
/////////////////////////////////////////////////////////////////////////////
init_character_items_thread:

// Shotgun dudes
level.Skill iflessequal 1 $building1_thug10 item Health 50
level.Skill ifgreaterequal 2 $building1_thug10 item Health 20
level.Skill ifequal 0 $mancinispotted1_thug01 item Health 50
level.Skill ifnotequal 0 $mancinispotted1_thug01 item Health 20
level.Skill ifequal 0 $mancinispotted2_thug01 item Health 50
level.Skill ifenotqual 0 $mancinispotted2_thug01 item Health 20

$building3_thug02 item Health 50

// Other guys
$shaft_thug02 item Health 20
$shaft_thug04 item Health 20
$building2_thug03 item Health 20
$building2_thug05 item Health 20

$bum03 item Coin 1

end // init_character_items_thread


// shaft_thug01_thread:
/////////////////////////////////////////////////////////////////////////////
shaft_thug01_thread:

level.Skill ifequal 0 local.self item Health 20

local.attackmode = 0

end // shaft_thug01_thread


// shaft_thug02_thread:
/////////////////////////////////////////////////////////////////////////////
shaft_thug02_thread:

local.attackmode = 0

end // shaft_thug02_thread


// shaft_thug03_thread:
/////////////////////////////////////////////////////////////////////////////
shaft_thug03_thread:

local.attackmode = 0

end // shaft_thug03_thread


// shaft_thug04_thread:
/////////////////////////////////////////////////////////////////////////////
shaft_thug04_thread:

local.self ignoresounds
local.self definestate activate shaft_thug04_activate
pause

shaft_thug04_activate:
local.self ignore activate

local.self respondtosounds
local.attackmode = 2
local.self attackplayer

end // shaft_thug04_thread


// shaft_thug05_thread:
/////////////////////////////////////////////////////////////////////////////
shaft_thug05_thread:

local.self ignoreall
local.self definestate activate shaft_thug05_activate
pause

shaft_thug05_activate:
local.self ignore activate

wait 2

local.self attack $powerjunc_target
waitFor local.self

local.self respondtoall
local.attackmode = 2
local.self attackplayer

end // shaft_thug05_thread


