$shaft_thug02 thread shaft_thug02_thread
$shaft_thug03 thread shaft_thug03_thread
$shaft_thug04 thread shaft_thug04_thread
$shaft_thug05 thread shaft_thug05_thread
$shaft_thug06 thread shaft_thug06_thread

