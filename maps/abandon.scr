// mancinispotted1_thug01_thread:
/////////////////////////////////////////////////////////////////////////////
mancinispotted1_thug01_thread:

local.self ignoresounds
local.self definestate activate mancinispotted1_thug01_activate
local.self definestate killed mancinispotted1_thug01_killed
pause

mancinispotted1_thug01_activate:
local.self ignore activate

local.self runto $cavein1_thug01_node1
waitFor local.self

local.self runto $cavein1_thug01_node2
waitFor local.self

local.attackmode = 1

end // mancinispotted1_thug01_thread

mancinispotted1_thug01_killed:
local.self ignore killed

trigger $spawn_mancinispotted1_thug02a
wait game.FRAMETIME
$mancinispotted1_thug02 thread mancinispotted1_thug02_thread

end // mancinispotted1_thug01_thread


