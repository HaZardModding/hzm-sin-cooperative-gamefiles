// tablebreak_thread:
/////////////////////////////////////////////////////////////////////////////
tablebreak_thread:

$woodfall ontrigger woodfall_sequence
pause

woodfall_sequence:
$woodfall notrigger

$woodfall playsound environment/woodcreak/smcreak1.wav 4
$woodfall setdamage 50
$woodfall time 1
$woodfall rotateXup 90
waitFor $woodfall

$woodfall playsound impact/crates/crate.wav 4
$woodfall time .1
$table1 time .3
$table2 time .3
$table3 time .3
$table1 rotateXdown 30
$table2 rotateZdown 45
$table3 rotateZup 45
$woodfall rotateXup 7
waitFor $woodfall

$table1 shatter "0 0 0" 40 2 20 0.25 0
$table2 shatter "0 0 0" 40 2 20 0.25 0
$table3 shatter "0 0 0" 40 2 20 0.25 0

end // tablebreak_thread


// mancinispotted1_start_thread:
/////////////////////////////////////////////////////////////////////////////
mancinispotted1_start_thread:

level.mancini_spotted1_thread = parm.currentthread
$cavein1_clip1 notsolid

$cavein1_clip1 time 0.1
$cavein1_clip1 moveUp 128
$cavein1_clip1 moveWest 256
waitFor $cavein1_clip1

thread mancini_survived_dialog_thread1
waitForThread parm.previousthread

level.mancini_spotted1_said_killhim = 1
thread mancini_survived_dialog_thread2
thread mancinispotted1_move_mancini_and_hostage
wait 1

thread thug_yougotit_dialog_thread
trigger $mancinispotted1_thug01
wait 1
$mancinispotted1_thug01 solid

thread cavein1_sequence1_thread
level.mancini_spotted1_thread = 0
end // mancinispotted1_start_thread

mancinispotted1_move_mancini_and_hostage:
trigger $mancinispotted1_hostage
wait 0.5

trigger $mancinispotted1_mancini
$mancinispotted1_mancini notsolid
$mancinispotted1_thug01 notsolid
//wait 0.5
end

mancinispotted1_skip:
level.mancini_spotted1_said_killhim ifequal 1 end
level.mancini_spotted1_thread ifnotequal 0 terminate level.mancini_spotted1_thread
level.mancini_spotted1_thread ifnotequal 0 mancini_spotted1_thread = 0

thread mancini_survived_dialog_thread2
thread mancinispotted1_move_mancini_and_hostage
wait 1

thread thug_yougotit_dialog_thread
trigger $mancinispotted1_thug01
wait 1
$mancinispotted1_thug01 solid

thread cavein1_sequence1_thread
end

