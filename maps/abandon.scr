// cavein1_sequence2_thread:
/////////////////////////////////////////////////////////////////////////////
cavein1_sequence2_thread:

$cavein1_trigger ontrigger Cavein1Sequence2
$cavein1_trigger ondamage Cavein1Sequence2

Cavein1Teeter:
trigger $cavein1_trigger_snd1

$cavein1_trigger time 1.5
$cavein1_trigger rotateXup 1
$cavein1_trigger rotateZup 1
waitFor $cavein1_trigger

$cavein1_trigger time 1.5
$cavein1_trigger rotateXdown 1
$cavein1_trigger rotateZdown 1
waitFor $cavein1_trigger

goto Cavein1Teeter

Cavein1Sequence2:
$cavein1_trigger_snd1 remove
$cavein1_trigger notrigger
$cavein1_trigger nodamage

trigger $cavein1_seq2_snd1

thread cavein1_seq2_trigger_thread
wait 0.3

$cavein1_barrels damage 1000

thread cavein1_seq2_floor1_thread
thread cavein1_seq2_floor2_thread
thread cavein1_seq2_floor3_thread
thread cavein1_seq2_floor4_thread
thread cavein1_seq2_floor5_thread
thread cavein1_seq2_roof1_thread
