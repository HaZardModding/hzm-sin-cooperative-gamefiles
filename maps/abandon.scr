level.MoneybagsCollected = 0

level.dialog_cash_found = 0

level.mancini_spotted1_thread = 0
level.mancini_spotted1_said_killhim = 0

// Mission Objective States - 0 not accomplished 1 = success 2 = fail 3 = not available
level.PObjective1 = 0 // Pursue Mancini
level.PObjective2 = 0 // Eliminate Hostile Forces
level.SObjective1 = 0 // Recover Stolen Money Bags


// Script Initialization
/////////////////////////////////////////////////////////////////////////////
thread init_thread

// General
