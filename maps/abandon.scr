$building3_thug02 thread stand_ground_thread
$building3_thug03 thread stand_ground_thread
$building3_thug04 thread stand_ground_thread

end // Script Initialization


// init_thread:
/////////////////////////////////////////////////////////////////////////////
init_thread:

$flickering_light1_ls lightstyle "Lmmmcmmcccmmmmmcmmmmccmmmmmmmcmccmmcmmmccmm"
$flickering_light2_ls lightstyle "Lmmmcmmcccmmmmmcmmmmccmmmmmmmcmccmmcmmmccmm"

$wheelbarrow time 0.1
$wheelbarrow rotateYdown 15
waitFor $wheelbarrow

$cavein1_clip2 notsolid

$cavein2_rubble1 time 0.1
$cavein2_rubble1 moveUp 192
waitFor $cavein2_rubble1

$bomb_stairs1_clip time 0.1
$bomb_stairs1_clip moveDown 32
waitFor $bomb_stairs1_clip

$propane_pipe1_steam hide

$basmain_damaged notsolid
$gasmain_fire hide

$cavein1_roof1 setdamage 100
$cavein1_roof2 setdamage 100
$cavein1_roof3 setdamage 100
$cavein1_roof4 setdamage 100
$cavein1_roof5 setdamage 100
$cavein1_floor1 setdamage 100
$cavein1_floor2 setdamage 100
$cavein1_floor3 setdamage 100
$cavein1_floor4 setdamage 100
$cavein1_floor5 setdamage 100


thread abandon_start_misscomp_thread

end // init_thread


//===========================================================================
//===========================================================================
// GENERAL
//===========================================================================
//===========================================================================
// flickering_light1_thread:
/////////////////////////////////////////////////////////////////////////////
flickering_light1_thread:

$flickering_light1_ls lightstyle "c"

end // flickering_light1_thread


// flickering_light2_thread:
/////////////////////////////////////////////////////////////////////////////
flickering_light2_thread:

$flickering_light2_ls lightstyle "c"

end // flickering_light2_thread


// trigger_shaft_thugs_thread:
/////////////////////////////////////////////////////////////////////////////
trigger_shaft_thugs_thread:

trigger $shaft_thug04
trigger $shaft_thug05
thread thug_kill_lights_dialog_thread

end // trigger_shaft_thugs_thread


// powerjunc_thread:
/////////////////////////////////////////////////////////////////////////////
powerjunc_thread:

// Only trigger once
level.PowerjuncState ifnotequal 0 goto powerjunc_done
level.PowerjuncState = 1

// [XA] disabling this, since the music changes to 'surprise' just a few
// seconds later when mancini drops the bomb. it's jarring having two so close.
//music suspense normal

trigger $powerjunc_explosion
trigger $powerjunc_sparks
trigger $powerjunc_snd1

thread powerjunc_panel_thread

$powerjunc_light1_model group light -Fullbright
$powerjunc_ls1 lightstyle "c"

$t32 remove
$t31 remove
$t30 remove
$t29 remove
$t28 remove
$t27 remove
$t26 remove
$t25 remove
trigger $lightsout_snd

wait 2

$powerjunc_ls2 lightstyle "Laaabbbcccdddeeefffggghhhiiijjjkkklllm"

wait 3.7

$powerjunc_ls2 lightstyle "m"

powerjunc_done:

end // powerjunc_thread


// powerjunc_panel_thread:
/////////////////////////////////////////////////////////////////////////////
powerjunc_panel_thread:

$powerjunc_panel shatter "0 0 0" 150 5 25 0.2 0

$powerjunc_panel time 0.5
$powerjunc_panel moveEast 128
$powerjunc_panel moveNorth 32
$powerjunc_panel moveDown 64
$powerjunc_panel rotateXup 270
$powerjunc_panel rotateYup 60
waitFor $powerjunc_panel

end // powerjunc_panel_thread


// propane_pipe1_thread:
/////////////////////////////////////////////////////////////////////////////
propane_pipe1_thread:

$propane_pipe1_steam show

end // propane_pipe1_thread


// cavein2_thread:
/////////////////////////////////////////////////////////////////////////////
cavein2_thread:

thread powerjunc_thread
thread bomb_brick_thread
thread bomb_thread

$cavein2_rubble1 setdamage 10000

// [XA] disable some of the effects here, since the audio overlaps
// with mancini's dialogue; this makes it a lot less noisy
//trigger $cavein2_snd1
//trigger $cavein2_snd2
trigger $cavein2_explosion
//trigger $cavein2_eq

$cavein2_rubble1 shatter "0 0 0" 100 5 25 0.05 0

$cavein2_rubble1 time 1
$cavein2_rubble2 time 1
$cavein2_rubble1 moveDown 256
$cavein2_rubble2 rotateZup 30
waitFor $cavein2_rubble2

//$cavein2_rubble1 playsound environment/rockfall/impact2.wav 4

end // cavein2_thread


// bomb_brick_thread:
/////////////////////////////////////////////////////////////////////////////
bomb_brick_thread:

$bomb_brick onuse bomb_brick_use
pause

bomb_brick_use:
$bomb_brick nouse

$bomb_brick playsound environment/levelsnds/whouse/manhole/mnhlcvr1.wav 2

$bomb_brick time 1
$bomb_brick moveSouth 24
waitFor $bomb_brick

$bomb_brick time 0.3
$bomb_brick moveSouth 24
$bomb_brick moveDown 32
$bomb_brick rotateZup 105
waitFor $bomb_brick

$bomb_brick playsound impact/explosion/track65.wav 4

$bomb_brick notsolid

end // bomb_brick_thread


// bomb_thread:
/////////////////////////////////////////////////////////////////////////////
bomb_thread:

music surprise normal

$bomb bind $bomb_parent
wait game.FRAMETIME

thread mancini_present_dialog_thread

$bomb_parent jumpto $bomb_way1

// Close and block the door
thread basementdoor_closeandblock_thread

// Have the bomb come down the stairs
$bomb_parent rotateZ -240

$bomb_parent time 0.3
$bomb_parent moveto $bomb_way2
waitFor $bomb_parent

$bomb_parent time 0.3
$bomb_parent moveto $bomb_way3
waitFor $bomb_parent

$bomb_parent time 0.3
$bomb_parent moveto $bomb_way4
waitFor $bomb_parent

$bomb_parent playsound impact/debris/generic/gen1.wav 4

$bomb_parent time 0.3
$bomb_parent moveto $bomb_way5
waitFor $bomb_parent

$bomb_parent time 0.3
$bomb_parent moveto $bomb_way6
waitFor $bomb_parent

$bomb_parent playsound impact/debris/generic/gen1.wav 4

$bomb_parent rotateZ 0
$bomb_parent rotateX -450
$bomb_parent rotateY 180

$bomb_parent time 0.4
$bomb_parent moveto $bomb_way7
waitFor $bomb_parent

$bomb_parent time 0.4
$bomb_parent moveto $bomb_way8
waitFor $bomb_parent

$bomb_parent playsound impact/debris/generic/gen1.wav 4
$bomb_parent rotateX 0
$bomb_parent rotateY 0

thread bomb_ticking_sound_thread

level.Skill ifequal 0 local.BombTime = 35
level.Skill ifequal 1 local.BombTime = 20
level.Skill ifgreaterequal 2 local.BombTime = 10

wait local.BombTime

// Blade has 5 seconds leff
thread blade_imscrewed_dialog_thread
wait 5

// Blow blade up
level.BombState = 1
$bomb remove
$bomb_remove remove

$powerjunc_ls1 lightstyle "c"
$powerjunc_ls2 lightstyle "a"

trigger $bomb_eq
trigger $bomb_explosion
trigger $bomb_damage
trigger $bomb_lights_sparks

$bomb_hurt setdamage 10000

$bomb_stairs1 setdamage 100
$bomb_stairs1 time 1
$bomb_stairs2 time 0.5
$bomb_stairs1 moveUp 16
$bomb_stairs1 moveNorth 64
$bomb_stairs1 rotateZup 35
$bomb_stairs1 rotateYdown 5
$bomb_stairs2 rotateXdown 30
waitFor $bomb_stairs2

$bomb_stairs1 notsolid

$bomb_stairs1_clip time 0.1
$bomb_stairs1_clip moveUp 32
waitFor $bomb_stairs1_clip

$bomb_hurt setdamage 0

end // bomb_thread


// bomb_ticking_sound_thread:
/////////////////////////////////////////////////////////////////////////////
bomb_ticking_sound_thread:

bomb_ticking_sound_loop:
$bomb_parent playsound environment/computer/smllbeep/smallbp4.wav 1
wait 1

level.BombState ifequal 1 goto bomb_ticking_sound_done
goto bomb_ticking_sound_loop

bomb_ticking_sound_done:

end // bomb_ticking_sound_thread:


// basementdoor_closeandblock_thread:
/////////////////////////////////////////////////////////////////////////////
basementdoor_closeandblock_thread:

level.BasementDoorLocked = 1

$basementdoor_block1 time 1.5
$basementdoor_block2 time 1.5
$basementdoor time 1.5
$basementdoor_block1 rotateXdown 55
$basementdoor_block2 rotateXdown 60
$basementdoor rotateXdownto 0
waitFor $basementdoor

end // basementdoor_closeandblock_thread


// basementdoor_block_thread:
/////////////////////////////////////////////////////////////////////////////
basementdoor_block_thread:
local.BlockersLeft = 2

BasementdoorBlockersReady:
local.BlockersLeft ifequal 0 goto BasementdoorBlockersGone

$basementdoor_block1 ondamage BasementdoorBlock1Damaged
$basementdoor_block2 ondamage BasementdoorBlock2Damaged
pause

BasementdoorBlock1Damaged:
$basementdoor_block1 nodamage
$basementdoor_block2 nodamage

local.BlockersLeft -= 1


$basementdoor_block1 playsound impact/debris/wood/wooddeb1.wav
$basementdoor_block1 shatter "0 0 0" 50 5 25 0.1 0

$basementdoor_block1 time 0.3
$basementdoor_block1 moveEast 32
$basementdoor_block1 moveSouth 128
$basementdoor_block1 moveDown 160
$basementdoor_block1 rotateXup 55
$basementdoor_block1 rotateYdown 85
waitFor $basementdoor_block1

goto BasementdoorBlockersReady

BasementdoorBlock2Damaged:
$basementdoor_block1 nodamage
$basementdoor_block2 nodamage

local.BlockersLeft -= 1

$basementdoor_block2 playsound impact/debris/wood/wooddeb1.wav
$basementdoor_block2 shatter "0 0 0" 50 5 25 0.1 0

$basementdoor_block2 time 0.3
$basementdoor_block2 moveEast 16
$basementdoor_block2 moveSouth 160
$basementdoor_block2 moveDown 160
$basementdoor_block2 rotateXup 60
$basementdoor_block2 rotateYdown 80
waitFor $basementdoor_block2

goto BasementdoorBlockersReady

BasementdoorBlockersGone:
level.BasementDoorLocked = 0

end // basementdoor_block_thread


// basementdoor_thread:
/////////////////////////////////////////////////////////////////////////////
basementdoor_thread:

$basementdoor setdamage 0
$basementdoor time 0.1
$basementdoor moveDown 64
$basementdoor rotateXupto 120
waitFor $basementdoor

// Basement door is locked
basementdoor_locked:
$basementdoor onuse basementdoorlocked_sequence
pause

basementdoorlocked_sequence:
$basementdoor nouse

level.BasementDoorLocked ifequal 0 goto basementdoor_open

$basementdoor playsound impact/carboard/c-hit.wav 2
$basementdoor time 0.3
$basementdoor rotateXup 1
waitFor $basementdoor

$basementdoor playsound impact/carboard/c-hit.wav 2
$basementdoor time 0.3
$basementdoor rotateXdown 1
waitFor $basementdoor

goto basementdoor_locked


// Basement door is unlocked
basementdoor_close:
$basementdoor nouse
$basementdoor onblock basementdoor_open

$basementdoor time 1.5
$basementdoor rotateXdownto 0
waitFor $basementdoor

$basementdoor onuse basementdoor_open
pause

basementdoor_open:
$basementdoor nouse
$basementdoor onblock basementdoor_close

$basementdoor time 1.5
$basementdoor rotateXupto 120
waitFor $basementdoor

$basementdoor onuse basementdoor_close
pause

goto basementdoor_close

end // basementdoor_thread


// building0_thread:
/////////////////////////////////////////////////////////////////////////////
building0_thread:

trigger $spawn_building0_thug01
wait game.FRAMETIME
$building0_thug01 thread building0_thug01_thread

end // building0_thread


// building1_thread:
/////////////////////////////////////////////////////////////////////////////
building1_thread:

trigger $building1_thug10
trigger $building1_thug11
trigger $building1_thug12

