building0_thug01_thread:

local.attackmode = 2
local.self attackplayer

end // building0_thug01_thread


// gasmain_bum_thread:
/////////////////////////////////////////////////////////////////////////////
gasmain_bum_thread:

local.self ignoreall
local.self anim twitch1
local.self respondto pain
local.self definestate use gasmain_bum_use
pause

gasmain_bum_use:
local.self ignore use
local.self respondto pain

level.bum_message1 ifequal 0 thread blade_getout_dialog_thread
level.bum_message1 ifequal 0 level.bum_message1 = 1

local.self runto $gasmain_bum_node1
waitFor local.self

local.self turnto 180
waitFor local.self

local.self ignoreall

local.self definestate use gasmain_bum_use2
//note from Rohit - the twitch animation seems to reset the use thread once it finishes
//local.self anim twitch1
waitFor local.self

end // gasmain_bum_thread

gasmain_bum_use2:
local.self ignore use
parm.bum string "$gasmain_bum"
thread dialog::bum_staying
waitForThread parm.previousthread
end

// bum01_thread:
/////////////////////////////////////////////////////////////////////////////
bum01_thread:

local.self anim warm1

local.self ignoreall
local.self respondto pain
local.self definestate use bum01_use
pause

bum01_use:
local.self ignore use

parm.bum string "$bum01"
thread bum_leave_alone_dialog_thread
wait 4
end // bum01_thread


// bum02_thread:
/////////////////////////////////////////////////////////////////////////////
bum02_thread:

local.self ignoreall
local.self respondto pain
local.self anim sleep1

end // bum02_thread


// bum03_thread:
/////////////////////////////////////////////////////////////////////////////
bum03_thread:

local.self anim warm1

local.self ignoreall
local.self respondto pain
local.self definestate use bum03_use
pause

bum03_use:
level.bum03_uses ifequal 1 goto bum03_use2
level.bum03_uses = 1

local.self ignore use
parm.bum string "$bum03"
thread bum_directions_dialog_thread
waitForThread parm.previousthread
wait 3
end

bum03_use2:
local.self ignore use
parm.bum string "$bum03"
thread bum_leave_alone_dialog_thread
waitForThread parm.previousthread
wait 3
end 

// bum03_thread


// building1_thug01_thread:
/////////////////////////////////////////////////////////////////////////////
building1_thug01_thread:

local.self definestate killed building1_thug01_killed
local.attackmode = 2
pause

building1_thug01_killed:
local.self ignore killed

level.Skill ifless 1 goto building1_thug01_done

trigger $spawn_building1_thug03a
wait game.FRAMETIME
$building1_thug03 thread building1_thug03_thread

building1_thug01_done:

end // building1_thug01_thread


