mancinispotted1_thug02_activate:
local.self ignore activate

local.self respondtoall
local.self attackplayer

end // mancinispotted1_thug02_thread


// mancinispotted1_hostage_thread:
/////////////////////////////////////////////////////////////////////////////
mancinispotted1_hostage_thread:

// Flee no matter what
local.self ignoreall
local.self respondto pain
local.self definestate activate mancinispotted1_hostage_activate
local.self definestate killed mancinispotted1_hostage_killed
pause

mancinispotted1_hostage_activate:
local.self ignore activate

local.self playsound misc/civfem/helpmeee.wav


local.self runto $mancinispotted1_escapenode
waitFor local.self

local.self remove
pause

mancinispotted1_hostage_killed:
local.self ignoreall

$mancinispotted2_hostage remove
game.Abandon_HostageKilled = 1

end // mancinispotted1_hostage_thread


// mancinispotted1_mancini_thread:
/////////////////////////////////////////////////////////////////////////////
mancinispotted1_mancini_thread:
local.self nodamage
local.self notsolid

// Flee no matter what
local.self ignoreall
local.self definestate activate mancinispotted1_mancini_activate
pause

mancinispotted1_mancini_activate:
local.self ignore activate

thread mancinispotted1_mancini_autoremove_thread

local.self runto $mancinispotted1_escapenode
waitFor local.self

local.self remove

end // mancinispotted1_mancini_thread


// mancinispotted1_mancini_autoremove_thread:
/////////////////////////////////////////////////////////////////////////////
mancinispotted1_mancini_autoremove_thread:

wait 10
$mancinispotted1_mancini remove

end // mancinispotted1_mancini_autoremove_thread


