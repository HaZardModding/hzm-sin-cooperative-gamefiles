$bum02 thread bum02_thread
$bum03 thread bum03_thread

$building1_thug01 thread building1_thug01_thread
$building1_thug02 thread building1_thug02_thread
$building1_thug10 thread building1_thug10_thread
$building1_thug11 thread building1_thug11_thread
$building1_thug12 thread building1_thug12_thread

