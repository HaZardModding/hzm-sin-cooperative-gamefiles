coop_giveInventory:
	local.objTargetname string parm.coop_giveInventoryTargetname
	local.giveAmmount = parm.coop_giveInventoryAmmount
	local.doNotPrint = parm.coop_giveInventorySuppressMessage

	parm.playerClosestObject string local.objTargetname
	thread coopMain::playerClosest
	local.player string parm.playerClosest

	parm.coop_giveAmount = local.giveAmmount
	parm.coop_giveExclude string local.player
	local.itemToGive gettarget local.objTargetname
	parm.coop_give string local.itemToGive
	thread coopReplace::coop_give
	
	
	local.doNotPrint ifequal 1 end
	local.printOut string "Added to Inventory: "
	local.printOut append local.itemToGive
	local.printOut append "\n"
	//print local.printOut
	parm.coop_notify string local.printOut
	thread coop_notify
	
	wait 0.15
	parm.objectExist string local.objTargetname
	thread coopMain::objectExist
	parm.objectExistTrue ifequal 1 local.objTargetname remove
end

coop_notify:
	local.prnt string "jcx yv -40 fc 1 1 1 0.7 string \""
	local.prnt append parm.coop_notify
	local.prnt append "\""
	screenprint 3 local.prnt
end

coop_itemDoRespawn:
	local.itemName string parm.coop_itemDoRespawn_name
	local.itemTargetname string "$"
	local.itemTargetname append local.itemName
	
	local.itemOrigin getorigin local.itemTargetname
	local.itemModel gettarget local.itemTargetname
	
	local.itemOrigin_x vector_x local.itemOrigin
	local.itemOrigin_y vector_y local.itemOrigin
	local.itemOrigin_z vector_z local.itemOrigin
	local.itemOriginSpawn string local.itemOrigin_x
	local.itemOriginSpawn append " "
	local.itemOriginSpawn append local.itemOrigin_y
	local.itemOriginSpawn append " "
	local.itemOriginSpawn append local.itemOrigin_z
	
	//make sure the item is really gone
	local.minWaitTime = 0.15
	wait local.minWaitTime
	parm.objectExist string local.itemTargetname
	thread coopMain::objectExist
	parm.objectExistTrue ifequal 1 goto coop_itemDoRespawn_stillExist
	
	local.actualWaitTime = level.itemRespawnTime
	local.actualWaitTime -= local.minWaitTime
	
	wait local.actualWaitTime
	spawn local.itemModel "targetname2" local.itemName "origin" local.itemOriginSpawn "thread" local.itemName "target" local.itemModel
	end
	
	coop_itemDoRespawn_stillExist:
		// local.printOut string "Item still exists, not Respawning: "
		// local.printOut append local.itemTargetname
		// local.printOut append "\n"
		// print local.printOut
end

coopItem1:
	parm.coop_itemDoRespawn_name string "coopItem1"
	thread coop_itemDoRespawn
end

