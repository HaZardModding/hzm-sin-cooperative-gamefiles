//OG script by Ritual Entertainment - Level by Levellord create in January 1999
//Background:
//Created as a Promo-Level for the US-based Magazine PC Gamer
//Named after John Keefer the editor of the Magazine

//Edited by Chrissstrahl for Coop use 2016.11.19
//Chrissstrahl - This cvar is disabled because I don't know what impact that would have on the rest of the levels
//airclamp 0 //disabled airspeed limit, which is basically enabeling stafejump when this is disabled

cachemodel "thug_rckt.def"
cachemodel "thug_ass.def"

//=================
start:
//=================
	//[coop] chrissstrahl - START COOP MOD - REQUIRED
	aliasscript global/coop_main.scr coopMain
	thread coopMain::main
	//set to 1 will make players always spawn at the predefined spawnlocations
	level.coopDisableSpawnWarper = 1
	//level specific item script - respawn time of items
	level.itemRespawnTime = 10
	
	
	
	thread keefers_lift_thread
	waitforplayer
end

//=================
keefers_lift_thread:
//=================
	$keefers_lift time 0.1
	$keefers_lift moveDown 1400
	waitFor $keefers_lift
	wait 0.1
	
	//chrissstrahl - spawn a soundentity to play the sound reliably - fix lift sound not working right
	spawn "trigger_speaker" "origin" "-448 1984 68" "targetname" "keefers_lift_wisperer"

	$keefers_lift time 2.0
	keefers_lift_loop:
		$keefers_lift ontrigger keefers_lift_up
		pause
	keefers_lift_up:
		$keefers_lift notrigger
		
		//chrissstrahl - fix lift sound not working right
		$keefers_lift_wisperer phssound environment/elevator/lvtrgd.wav 1.0
		
		$keefers_lift moveUp 1400
		waitFor $keefers_lift
		
		//chrissstrahl - fix lift sound not working right
		$keefers_lift_wisperer phssound environment/machine/pneumach/pneustop.wav 1.0
		
		wait 3.0
		
		//chrissstrahl - fix lift sound not working right
		$keefers_lift_wisperer phssound environment/elevator/lvtrgd.wav 1.0
		
		$keefers_lift moveDown 1400
		waitFor $keefers_lift
		
		//chrissstrahl - fix lift sound not working right
		$keefers_lift_wisperer phssound environment/machine/pneumach/pneustop.wav 1.0
		
		//wait when lift is down before going up again
		wait 4.0
goto keefers_lift_loop

//[coop] chrissstrahl - give weapon to all players
coop_giveQuantum:
	parm.coop_giveInventorySuppressMessage = level.pickedUpQuantum
	parm.coop_giveInventoryTargetname string "$cwq"
	thread coop_giveInventory
	level.pickedUpQuantum = 1
end
