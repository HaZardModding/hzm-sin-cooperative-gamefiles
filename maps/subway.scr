//=========================================================
// Subway script
// Tom Mustaine - Ritual Entertainment
//=========================================================

//[coop] chrissstrahl - START COOP MOD - REQUIRED
aliasscript global/coop_main.scr coopMain
thread coopMain::main

// Subway Dialog Script
setdialogscript dialog/dialog_subway.scr

spawn clipbox type 1 mins "2640 -1664 16" maxs "2880 -1648 72"
spawn clipbox type 1 mins "2896 -1664 16" maxs "3130 -1648 72"


spawn clipbox type 2 mins "-3744 -2208 0" maxs "-3520 -2184 128"
spawn clipbox type 2 mins "-3520 -2208 0" maxs "-3280 -2184 128"
spawn clipbox type 2 mins "-3264 -2208 0" maxs "-3024 -2184 128"
spawn clipbox type 2 mins "-3008 -2208 0" maxs "-2768 -2184 128"
spawn clipbox type 2 mins "-2752 -2208 0" maxs "-2624 -2184 128"

//spawn programmer type "carmack" mins "0 1 0" maxs "1 0 0"
//spawn programmer type "dose" mins "1 0 1" maxs "1 0 0"
//spawn level_designer type "mustaine" mins "0 0 0" maxs "0 0 0"

ai_disconnectpath breaknode_a breaknode_b

//=========================================================
// Script Init
//=========================================================
waitforplayer
level.PObjective3 = 5  // Setting Mission computer to not show mutant at start of map
level.goodpeopledead = 0
level.failed_s1_already = 0
level.found_secrets = 0
level.total_secrets = 1
level.pmanu_blocker_gone = 0
level.manu1_blocker_gone = 0
level.shatter1_gone = 0
level.bum11_asked_for_quarter = 0
level.bum11_took_quarter = 0

thread MiscObjects
thread SetupTurnstyles
thread GeneratorABO
thread Manu_ambush1
thread MissionStatus
thread Setup_Train
thread Phones

// Characters Init
$thug_blockpath1	thread	thug_blockpath1_state	// Thug that blocks you from chasing manumit
$thug_bumkilla1		thread	thug_bumkilla1_state	// Thug that kills bum2
$bum1			thread	bum1_state
$bum2			thread	bum2_state
$bum3			thread	bum3_state
$bum4			thread	bum4_state
$bum5			thread	bum5_state
$bum6			thread	bum6_state
$bum7			thread	bum7_state
$bum8			thread	bum8_state
$bum9			thread	bum9_state
$bum10			thread	bum10_state
$bum11			thread	bum11_state
$pthug1			thread	pthug1_state
$pthug2			thread	pthug2_state

thread RatState

$rat_water notsolid

// Character Gives
$thug_0001	item	health		50
$thug_0002	item	health		20
$thug_0002	item	RiotHelmet	50
$thug_bumkilla1	item	health		50
$thug_blockpath1	item	health	50
$thug_0003	item	health		20
//$thug_0004	item	health		50
$thug_0005	item	health		20
$thug_0006	item	health		50
$thug_0007	item	health		50
$thug_0008	item	health		50
$thug_0009	item	health		50
$thug_0010	item	health		50
$thug_0011	item	health		20
$thug_0011	health	200
$thug_0012	item	health		20
$thug_0013	item	health		50

end

// AI path fixes
fix_t13_explode:
  wait 0.2 // wait for the wall to be gone
  ai_calcpath breaknode_a breaknode_b
end

//-------------------------------------------
//  Powerstation Thugs
//-------------------------------------------
pthug1_state:
local.self	ignoresounds
pause
end

pthug2_state:
local.self	ignoresounds
pause
end

//-------------------------------------------
// Easter Rat
//-------------------------------------------
RatState:
$bigrat	nodamage
$bigrat	notsolid
end

//-------------------------------------------
// Start location Crap
//-------------------------------------------
setup_start3:
game.subway_startstate = 3
thread StateObjects
end

setup_start1:
game.subway_startstate = 1
thread StateObjects
end

//-------------------------------------------
// Good Poeple Checking Thread
//-------------------------------------------
check_good_people:
level.failed_s1_already ifequal 1 goto good_end
level.goodpeopledead ifgreater 6 goto fail_s1
end

good_end:
end

fail_s1:
level.failed_s1_already = 1
level.SObjective1 = 2
thread MissionStatus
local.WaitingForThread = parm.previousthread
waitForThread local.WaitingForThread
thread global/universal_script.scr::SObjectiveFailed
local.WaitingForThread = parm.previousthread
waitForThread local.WaitingForThread
thread global/universal_script.scr::StatusUpdated
end

//-------------------------------------------
// Bum1 State
//-------------------------------------------
bum1_state:
$bum1	item	apple	1
local.self ignoreall
local.self respondto pain killed use activate
local.self definestate use Bum1_Use
local.self definestate idle Bum1_Idle
local.self definestate killed Bum1_Killed
local.self definestate activate bum1_runandhide
local.self state idle
pause

bum1_runandhide:
local.self	runto	$runbum_node2
waitFor	local.self
local.self anim "crouch_idle"
pause

Bum1_Idle:
local.self anim "idle1"
pause

Bum1_Use:
local.self ignore use
parm.SaySomething = 1
parm.bumname string "$bum1"
thread bum_say_something_thread
local.WaitingForThread = parm.previousthread
waitForThread local.WaitingForThread
end

Bum1_Killed:
level.goodpeopledead += 1
thread check_good_people
end
end

