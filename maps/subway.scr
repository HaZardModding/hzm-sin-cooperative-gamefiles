//=========================================================
//begin texture translation stuff
//=========================================================
Trans_Startloop:
local.transwallcount = 1

transloop:
parm.transwall string "@trans"
parm.transwall appendint local.transwallcount

thread transstart

local.transwallcount += 1
local.transwallcount iflessequal 11 goto transloop
end

transstart:
//parm.transwall transOn
parm.transwall trans_mag 150
//parm.transwall trans_angle 180
end

//=========================================================
//end texture translation stuff
//=========================================================
Trans_Stoploop:
wait 5
local.transwallend = 1

Trans_end:
parm.transwall string "@trans"
parm.transwall appendint local.transwallend

thread transstop

local.transwallend += 1
local.transwallend iflessequal 11 goto Trans_end
end

transstop:
//parm.transwall transOff
parm.transwall trans_mag 0
//parm.transwall trans_angle 0
end

