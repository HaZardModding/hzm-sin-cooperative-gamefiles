//=========================================================
// Misc objects
//=========================================================
MiscObjects:

// TEMP GAME STATE SETTING
//game.subway_startstate = 3

//thread StateObjects
thread MissionState
thread StatusUpdate
thread Trans_Stoploop
thread Train_stuff
thread swing_light
thread ExtraObjects
$manumit_mover	moveDown	16
waitFor $manumit_mover
end

//=========================================================
// Extra Objects
//=========================================================
ExtraObjects:
$manumit_mover hide
$playerclippy notsolid
$monsterclippy notsolid
wait 2
$makenodes	remove
end

//=========================================================
// Light swinging in tunnel
//=========================================================
swing_light:
thread break_bottom
$swing_bottom	bind	$swing_top
wait .1

swing_loop:
$swing_top	time	2
$swing_top	rotateXdownto	2
waitFor $swing_top
$swing_top	rotateXupto	4
waitFor $swing_top	
goto swing_loop

break_bottom:
$swing_bottom	ondamage	removebottom
pause

removebottom:
$swing_bottom	shatter "(1 1 1)" 40 10 40 .3 0
$swing_bottom	hide
$swing_bottom	notsolid
end

//=========================================================
// Train Lighting in tunnel
//=========================================================
Train_stuff:
$fake_train1	hide
$fake_train1	notsolid
end

//=========================================================
// Update Mission status dialog
//=========================================================
StatusUpdate:
wait 5
thread global/universal_script.scr::StatusUpdated
end

//=========================================================
// Reset Mission computer to empty
//=========================================================
MissionState:
level.PObjective1 = 0
level.PObjective2 = 0
//level.PObjective3 = 0
level.SObjective1 = 0
level.SObjective2 = 0
level.moneybags = 0
end

//=========================================================
// Level flow set by start position thread.
//=========================================================
StateObjects:
game.subway_startstate ifequal 1 goto setstate1
game.subway_startstate ifequal 3 goto setstate3
end

setstate3:	// Coming in from the main entrance
$manu_shatter2	remove
$abo_brokeshit1	remove
$manumit2	remove
$thug_alpha4	remove
end

setstate1:	// Coming in from the alternate exit (Bulldozer entrance)
$abowall1	remove
$thug_alpha1	remove
$thug_alpha2	remove
$thug_alpha3	remove
$manumit2	remove
wait 8
$thug_bumkilla1	remove
$thug_blockpath1	remove
$bum2	remove
end

secretarea1:
unlockachievement "ACH_SIN_RATS"
level.found_secrets += 1
thread global/universal_script.scr::secret
end

LevelComplete:
// We're done with the episode, so clear the savegames out
clearsavegames

// Clears any items in the player's inventory that need to be removed
thread global/universal_script.scr::ClearInventory

// Any objectives that haven't been set to Success or Fail should be set
// here. This usually is for things like "Eliminate All Hostile Forces"
// All Objectives need to be set to Success or Fail by the end of the
// map. This should be automatic for the most part but if you
// Find any that aren't, we need to figure out what to do with them.
level.SObjective1 ifnotequal 1 level.SObjective1 = 2
level.SObjective2 ifnotequal 1 level.SObjective2 = 2
level.PObjective1 ifnotequal 1 level.PObjective1 = 2
level.PObjective2 ifnotequal 1 level.PObjective2 = 2
level.PObjective3 ifnotequal 1 level.PObjective3 = 2

thread MissionStatus

// Send over the information that Scott needs to load the proper intermission
loadintermission "layouts/im_layouts/subway_to_subway2_cinema"
thread global/universal_script.scr::CopyNewMisConToIntermission

end




coop_subwayTrain1:
	//[coop] chrissstrahl - move spawnlocations to the first train spawn
	thread coopPlayerSpawn::subway_subwayTrain1
end

coop_subwayTrain2:
	//[coop] chrissstrahl - move spawnlocations near to the actual moving train spawn
	thread coopPlayerSpawn::subway_subwayTrain2
end

//[coop] chrissstrahl - DETECT PLAYER SPAWN - REQUIRED
//this fires everytime a player is spawned
//without this the coop mod will not work correctly!
coopInfoPlayerStartActivated:
	thread coopMain::playerTargetnames
end

//[coop] chrissstrahl - spawn a trigger we can actually control, as long as the next level is not completed
coop_levelSetup:
	//enlarge the start setup trigger
	$fuckass2 setsize "-500 -500 -30" "500 500 30"
	$fuckass1 setsize "-500 -500 -30" "500 500 30"

	//spawn location updates
	spawn trigger_once origin "3447 1885 20" thread "coop_subwayTrain1" targetname "coop_subwayTrain1"
	$coop_subwayTrain1 setsize "-650 -140 0" "450 140 30"
	spawn trigger_once origin "3447 1885 20" thread "coop_subwayTrain2" targetname "coop_subwayTrain2"
	$coop_subwayTrain2 setsize "-250 -250 0" "250 250 30"
end

//[coop] chrissstrahl - executed each time a player has spawned
//optional function
coop_justSpawned:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end
		
//[coop] chrissstrahl - executed each time a player has died
//optional function
coop_justDied:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player enters spectator mode
//optional function
coop_justBecameSpectator:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end

//[coop] chrissstrahl - executed each time a player has entered the game (usually oce per level)
//optional function
coop_justEntered:
	local.player string parm.playerEvent
	//EXAMPLE: Do something with the player
	//local.player give Magnum
end	
	
//[coop] chrissstrahl - executed each time a player has disconnected
//optional function
coop_justLeft:
	local.player string parm.playerEvent
	//EXAMPLE: You can't do something with the player because the player has disconnected
	//You can however still check stuff based on player targetname
	//local.player ifstrequal "$player2" print "Player 2 has lost the will to fight\n"
end
